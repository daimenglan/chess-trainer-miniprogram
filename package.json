{
  "name": "mychess-miniprogram",
  "version": "1.0.0",
  "description": "Mychess 国际象棋陪练系统 - 微信小程序",
  "scripts": {
    "test": "node test/e2e-simulation.js",
    "check-bindings": "node test/check-bindings.js",
    "check-syntax": "node test/check-syntax.js",
    "check-requires": "node test/check-requires.js",
    "check-css-vars": "node test/check-css-vars.js",
    "check-wxss-structure": "node test/check-wxss-structure.js",
    "check-wxml": "node test/check-wxml.js",
    "check-classes": "node test/check-classes.js",
    "test-records": "node test/record-entry-test.js",
    "check-all": "npm run check-syntax && npm run check-wxml && npm run check-bindings && npm run check-requires && npm run check-css-vars && npm run check-wxss-structure && npm run test-records && npm run test-eval-perspective && npm run test-eval-bar && npm run test-explore && npm run test-friend-invite",
    "test-eval-perspective": "node test/eval-perspective-test.js",
    "test-eval-bar": "node test/eval-bar-flow-test.js",
    "test-explore": "node test/explore-logic-test.js",
    "test-friend-invite": "node test/friend-invite-test.js",
    "test-visual-friends": "node test/visual-friends-test.js",
    "test-visual": "node test/visual-topbar-test.js",
    "test-visual-board-record": "node test/visual-board-record-test.js",
    "test-visual-explore": "node test/visual-explore-test.js",
    "test-visual-spectate": "node test/visual-spectate-test.js",
    "test-visual-friend-lobby": "node test/visual-friend-lobby-test.js",
    "build": "tsc",
    "watch": "tsc --watch",
    "preview": "bash scripts/preview.sh",
    "test-wechat": "node test/wechat-login-test.js"
  },
  "keywords": [
    "chess",
    "ai",
    "wechat",
    "miniprogram"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/wechat-miniprogram": "^3.4.10",
    "typescript": "^7.0.2"
  }
}
