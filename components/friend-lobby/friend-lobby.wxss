/* 好友对弈大厅（在线对弈页「👥 好友对弈」页签）样式 */

.friend-lobby {
  width: 100%;
  max-width: 560rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  box-sizing: border-box;
}

/* ===== 时限 + 生成邀请 ===== */
.fl-invite-bar {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 20rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  border-radius: 18rpx;
  box-sizing: border-box;
}

.fl-time-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.fl-time-label {
  font-size: 24rpx;
  color: var(--text-muted);
}

.fl-time-picker {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  background: var(--bg-input);
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
}

.fl-time-picker text {
  font-size: 26rpx;
  color: var(--text-primary);
}

.fl-time-arrow {
  font-size: 20rpx;
  color: var(--text-muted);
}

.fl-generate-btn {
  width: 100%;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 16rpx;
  background: var(--accent-gradient);
  box-shadow: var(--shadow);
  box-sizing: border-box;
}

.fl-generate-btn text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-white);
}

.fl-generate-btn:active {
  transform: scale(0.98);
}

.fl-generate-btn.disabled {
  opacity: 0.5;
}

/* ===== 邀请结果 ===== */
.fl-qr {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.fl-qr-img {
  width: 300rpx;
  height: 300rpx;
  border-radius: 16rpx;
  background: #fff;
  padding: 12rpx;
}

.fl-qr-hint {
  font-size: 22rpx;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.5;
}

.fl-qr-fallback {
  width: 100%;
  padding: 32rpx 20rpx;
  border-radius: 16rpx;
  background: var(--bg-input);
  border: 1rpx dashed var(--border-color);
  box-sizing: border-box;
}

.fl-qr-fallback-icon {
  font-size: 48rpx;
}

.fl-link-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: var(--bg-input);
  border: 1rpx solid var(--border-color);
  box-sizing: border-box;
}

.fl-link-text {
  flex: 1;
  font-size: 22rpx;
  color: var(--accent);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.fl-link-copy {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-white);
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  background: var(--accent-bg);
}

.fl-link-error {
  width: 100%;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: var(--danger-bg);
  box-sizing: border-box;
}

.fl-link-error text {
  font-size: 21rpx;
  color: var(--danger);
  line-height: 1.4;
}

.fl-actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.fl-share-btn {
  flex: 1;
  margin: 0;
  padding: 20rpx;
  border-radius: 14rpx;
  background: var(--accent-gradient);
  line-height: 1.3;
  border: none;
}

.fl-share-btn::after {
  border: none;
}

.fl-share-btn text {
  font-size: 26rpx;
  color: var(--text-white);
  font-weight: 600;
}

.fl-copy-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 14rpx;
  background: transparent;
  border: 1rpx solid var(--border-color);
  box-sizing: border-box;
}

.fl-copy-btn text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.fl-reset-btn {
  align-self: center;
  padding: 10rpx 32rpx;
}

.fl-reset-btn text {
  font-size: 24rpx;
  color: var(--text-muted);
}

.fl-expire {
  font-size: 20rpx;
  color: var(--text-dim);
  text-align: center;
}

/* ===== 提示 ===== */
.fl-hint {
  font-size: 22rpx;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.5;
  padding: 0 20rpx;
}

/* ===== 好友列表 ===== */
.fl-friends-head {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-muted);
}

.fl-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  width: 100%;
}

.fl-card {
  position: relative;
  width: calc(50% - 8rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 16rpx 20rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  border-radius: 18rpx;
  box-sizing: border-box;
}

.fl-card.online {
  border-color: var(--success);
  box-shadow: 0 0 0 2rpx var(--success-bg);
}

.fl-card-dot {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--text-dim);
}

.fl-card-dot.on {
  background: var(--success);
}

.fl-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--purple), var(--accent));
}

.fl-avatar-text {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-white);
}

.fl-card-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.fl-card-rating {
  font-size: 22rpx;
  color: var(--text-muted);
}

.fl-challenge-btn {
  width: 100%;
  text-align: center;
  padding: 14rpx 0;
  margin-top: 6rpx;
  border-radius: 12rpx;
  background: var(--accent-gradient);
}

.fl-challenge-btn text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-white);
}

.fl-challenge-btn.pending {
  background: var(--warning-bg);
}

.fl-challenge-btn.pending text {
  color: var(--warning);
}

.fl-challenge-btn.disabled {
  opacity: 0.4;
}

/* ===== 空态 / 加载 ===== */
.fl-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 48rpx 24rpx;
}

.fl-empty-icon {
  font-size: 64rpx;
}

.fl-empty-text {
  font-size: 26rpx;
  color: var(--text-muted);
}

.fl-empty-sub {
  font-size: 22rpx;
  color: var(--text-dim);
  text-align: center;
  line-height: 1.5;
}

.fl-loading {
  text-align: center;
  padding: 32rpx 0;
}

.fl-loading text {
  font-size: 24rpx;
  color: var(--text-dim);
}

/* ===== 搜索加好友 ===== */
.fl-search-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 20rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  border-radius: 18rpx;
  box-sizing: border-box;
}

.fl-search-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-muted);
}

.fl-search-input {
  width: 100%;
  padding: 18rpx 22rpx;
  background: var(--bg-input);
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
  color: var(--text-primary);
  font-size: 26rpx;
  box-sizing: border-box;
}

.fl-placeholder {
  color: var(--text-placeholder);
}

.fl-search-results {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.fl-search-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: var(--bg-input);
}

.fl-search-avatar {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--purple), var(--accent));
}

.fl-search-avatar .fl-avatar-text {
  font-size: 28rpx;
}

.fl-search-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.fl-search-name {
  font-size: 26rpx;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.fl-search-meta {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.fl-add-btn {
  flex-shrink: 0;
  min-width: 108rpx;
  text-align: center;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: var(--accent-gradient);
  box-sizing: border-box;
}

.fl-add-btn text {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-white);
}

.fl-add-btn-disabled {
  background: transparent;
  border: 1rpx solid var(--border-color);
}

.fl-add-btn-disabled text {
  color: var(--text-muted);
  font-weight: 400;
}
