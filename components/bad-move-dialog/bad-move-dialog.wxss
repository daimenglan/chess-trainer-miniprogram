.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-overlay);
  backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bad-move-dialog {
  padding: 40rpx;
  width: 560rpx;
  text-align: center;
  background: rgba(26, 26, 46, 0.95);
  border: 1px solid var(--border-color);
}

.dialog-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.warning-icon {
  font-size: 48rpx;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--warning);
}

.move-info {
  margin-bottom: 24rpx;
}

.move-desc {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.score-comparison {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.score-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
}

.score-item.yours {
  background: var(--danger-bg);
  border: 1px solid rgba(239, 68, 68, 0.2);
}

.score-item.best {
  background: rgba(34, 197, 94, 0.1);
  border: 1px solid rgba(34, 197, 94, 0.2);
}

.score-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.score-value {
  font-size: 34rpx;
  font-weight: 700;
  font-family: 'Courier New', monospace;
}

.score-item.yours .score-value { color: var(--danger); }
.score-item.best .score-value { color: var(--success); }

.score-vs {
  font-size: 24rpx;
  color: var(--text-dim);
  font-weight: 600;
}

.loss-info {
  padding: 10rpx;
  border-radius: 10rpx;
  margin-bottom: 16rpx;
}

.loss-critical { background: var(--danger-bg); }
.loss-significant { background: rgba(249, 115, 22, 0.15); }
.loss-moderate { background: rgba(234, 179, 8, 0.15); }

.loss-text {
  font-size: 26rpx;
  font-weight: 600;
}

.loss-critical .loss-text { color: var(--danger); }
.loss-significant .loss-text { color: var(--danger); }
.loss-moderate .loss-text { color: var(--warning); }

.warning-text {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 28rpx;
}

.dialog-actions {
  display: flex;
  gap: 12rpx;
  justify-content: center;
  flex-wrap: wrap;
}

.btn-option {
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: var(--bg-card-hover);
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
  min-width: 140rpx;
}

.btn-option:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.btn-confirm {
  background: var(--accent-gradient);
  color: #fff;
  border: none;
}

.btn-cancel {
  color: var(--text-muted);
}

.btn-auto {
  color: var(--success);
  border-color: rgba(74, 222, 128, 0.3);
}