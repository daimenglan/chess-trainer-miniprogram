.board-wrapper {
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.board-frame {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  padding: 6rpx;
  border-radius: 4rpx;
  background: var(--board-frame, #4a6fa5);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
  box-sizing: border-box;
  overflow: hidden;
}

/* 上方文件标签 (a-h) */
.file-labels-top {
  display: flex;
  justify-content: space-around;
  padding: 0 4rpx;
  margin-bottom: 1rpx;
  flex-shrink: 0;
}

.file-label {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.85);
}

/* 下方文件标签 (a-h) */
.file-labels-bottom {
  display: flex;
  justify-content: space-around;
  padding: 0 4rpx;
  margin-top: 1rpx;
  flex-shrink: 0;
}

/* 左侧行标签 (1-8) */
.rank-labels-left {
  position: absolute;
  left: 2rpx;
  top: 18rpx;
  bottom: 18rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  z-index: 2;
}

.rank-label {
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.85);
  text-align: right;
  padding-right: 2rpx;
  line-height: 1;
}

/* 右侧行标签 (1-8) */
.rank-labels-right {
  position: absolute;
  right: 2rpx;
  top: 18rpx;
  bottom: 18rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  z-index: 2;
}

.rank-label-right {
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.85);
  text-align: left;
  padding-left: 2rpx;
  line-height: 1;
}

/* 棋盘网格 */
.board-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  grid-template-rows: repeat(8, 1fr);
  border-radius: 2rpx;
  overflow: hidden;
  position: relative;
  z-index: 1;
  flex: 1;
  width: 100%;
  min-height: 0;
}

/* 棋盘格子 */
.square {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.15s;
  box-sizing: border-box;
  cursor: pointer;
  overflow: hidden;
}

.square-light {
  /* 背景色由内联样式控制 */
}

.square-dark {
  /* 背景色由内联样式控制 */
}

/* 最后一步高亮（黄色半透明） */
.last-move-highlight {
  position: absolute;
  inset: 0;
  background-color: rgba(255, 230, 0, 0.3);
  z-index: 2;
  pointer-events: none;
}

/* 选中高亮：明显琥珀色 + 内圈亮环，深浅格上都清晰可辨 */
.selected-highlight {
  position: absolute;
  inset: 0;
  background-color: rgba(255, 193, 7, 0.55);
  box-shadow: inset 0 0 0 6rpx rgba(255, 214, 10, 0.95);
  z-index: 2;
  pointer-events: none;
}

/* 合法走法目标点（绿色小圆点） */
.legal-dot {
  position: absolute;
  width: 30%;
  height: 30%;
  border-radius: 50%;
  background: rgba(34, 197, 94, 0.7);
  z-index: 3;
  pointer-events: none;
}

/* 吃子标记（红色圆环） */
.capture-ring {
  position: absolute;
  width: 36%;
  height: 36%;
  border-radius: 50%;
  border: 4rpx solid rgba(239, 68, 68, 0.7);
  background: var(--danger-bg);
  z-index: 3;
  pointer-events: none;
}

/* 候选走法编号（z-index 高于棋子 Canvas，保持可点击） */
.candidate-badge {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fff;
  font-weight: bold;
  font-size: 22rpx;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
  z-index: 7;
  pointer-events: auto;
  width: 38rpx;
  height: 38rpx;
}

.rank-1 { background: #2563eb; }
.rank-2 { background: #ea580c; }
.rank-3 { background: #64748b; }

/* 全盘棋子 + 最后一步箭头 Canvas：CSS 填充网格容器，尺寸由 JS 直接设物理分辨率，避免内联尺寸绑定抖动 */
.board-pieces-canvas {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 5;
  pointer-events: none;
  width: 100%;
  height: 100%;
}