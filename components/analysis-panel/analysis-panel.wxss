.analysis-panel {
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  gap: 16rpx;
  color: var(--text-dim);
}

.placeholder-icon {
  font-size: 80rpx;
  opacity: 0.3;
}

.placeholder-text {
  font-size: 26rpx;
}

.panel-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  gap: 12rpx;
  padding: 12rpx;
}

/* 评估条（双向，同网页版 flex-1 h-1.5 + 左右半区） */
.evaluation-bar-container {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.eval-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.eval-bar {
  flex: 1;
  height: 16rpx;
  display: flex;
  align-items: center;
  position: relative;
  min-width: 0;
}

.eval-bar-half {
  flex: 1;
  height: 100%;
  background: var(--bg-card-hover);
  overflow: hidden;
  display: flex;
}

.eval-bar-left {
  border-top-left-radius: 999rpx;
  border-bottom-left-radius: 999rpx;
  justify-content: flex-end;
}

.eval-bar-right {
  border-top-right-radius: 999rpx;
  border-bottom-right-radius: 999rpx;
  justify-content: flex-start;
}

/* 左半填充从中心向左延伸（对方优势 → 红色） */
.eval-bar-fill-left {
  height: 100%;
  border-top-left-radius: 999rpx;
  border-bottom-left-radius: 999rpx;
  background: linear-gradient(90deg, #ef4444, #fca5a5);
  transition: width 0.3s ease;
}

/* 右半填充从中心向右延伸（己方优势 → 绿色） */
.eval-bar-fill-right {
  height: 100%;
  border-top-right-radius: 999rpx;
  border-bottom-right-radius: 999rpx;
  background: linear-gradient(270deg, #22c55e, #86efac);
  transition: width 0.3s ease;
}

.eval-bar-divider {
  width: 2rpx;
  height: 100%;
  background: var(--text-muted);
  flex-shrink: 0;
  z-index: 10;
}

.evaluation-score {
  font-size: 28rpx;
  font-weight: 700;
  font-family: 'Courier New', monospace;
  white-space: nowrap;
}

.score-green { color: var(--success); }
.score-red { color: var(--danger); }
.score-neutral { color: var(--warning); }

.eval-sub {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 开局名称 */
.opening-name {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 16rpx;
  background: var(--accent-bg-light);
  border-radius: 8rpx;
  border: 1px solid var(--accent-border);
}

.opening-name:active {
  opacity: 0.7;
}

.eco-code {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--accent);
  background: var(--accent-bg);
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.opening-text {
  font-size: 26rpx;
  color: var(--text-dim);
}

/* AI思考中 */
.thinking-indicator {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx;
  font-size: 28rpx;
  color: var(--text-muted);
}

.thinking-dot {
  width: 20rpx;
  height: 20rpx;
  background: var(--accent);
  border-radius: 50%;
  animation: pulse 1s ease-in-out infinite;
}

/* 分析错误 */
.analysis-error {
  padding: 12rpx 16rpx;
  background: var(--danger-bg);
  border-radius: 8rpx;
  border: 1px solid rgba(239, 68, 68, 0.2);
  font-size: 26rpx;
  color: var(--danger);
}

/* 候选走法：1/2/3 编号切换 + 选中走法详情（同网页版候选标记详情） */
.candidates-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-height: 0;
}

.candidate-tabs {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.candidate-tab {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  opacity: 0.45;
  flex-shrink: 0;
  border: 3rpx solid transparent;
}

.candidate-tab-active {
  opacity: 1;
  border-color: rgba(255, 255, 255, 0.75);
  box-shadow: 0 0 12rpx rgba(108, 99, 255, 0.55);
}

.candidate-tabs-hint {
  font-size: 22rpx;
  color: var(--text-placeholder);
}

.rank-1 { background: #2563eb; box-shadow: 0 0 10rpx rgba(37, 99, 235, 0.4); }
.rank-2 { background: #ea580c; }
.rank-3 { background: #64748b; }

.candidate-detail-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.candidate-detail-card {
  padding: 16rpx;
  background: var(--bg-card);
  border-radius: 12rpx;
  border: 1px solid var(--border-color-light);
  border-left-width: 6rpx;
}

.rank-border-1 { border-left-color: #2563eb; }
.rank-border-2 { border-left-color: #ea580c; }
.rank-border-3 { border-left-color: #64748b; }

.candidate-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.candidate-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.candidate-score {
  font-size: 28rpx;
  font-weight: 700;
  font-family: 'Courier New', monospace;
}

.candidate-detail {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-bottom: 6rpx;
}

.detail-pro {
  font-size: 24rpx;
  color: var(--success);
  line-height: 1.5;
}

.detail-con {
  font-size: 24rpx;
  color: var(--danger);
  line-height: 1.5;
}

.tactics-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-bottom: 6rpx;
}

.tactic-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(234, 179, 8, 0.15);
  color: var(--warning);
}

.line-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  align-items: center;
}

.line-label {
  font-size: 22rpx;
  color: var(--text-dim);
}

.line-move {
  font-size: 24rpx;
  color: var(--text-dim);
  font-family: 'Courier New', monospace;
}

.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 10rpx;
}

.action-pill {
  padding: 10rpx 28rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.action-pill:active {
  opacity: 0.7;
}

.action-pill-explore {
  background: rgba(108, 99, 255, 0.18);
  border: 1rpx solid rgba(108, 99, 255, 0.4);
  color: var(--accent);
}

.action-pill-auto {
  background: rgba(34, 197, 94, 0.14);
  border: 1rpx solid rgba(34, 197, 94, 0.35);
  color: var(--success);
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* 开局百科弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.opening-modal {
  width: 85%;
  max-width: 600rpx;
  max-height: 80vh;
  background: var(--bg-card, #1e1e3a);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--border-color-light, rgba(255,255,255,0.1));
}

.opening-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1px solid var(--border-color-light, rgba(255,255,255,0.1));
}

.opening-modal-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.eco-code-lg {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent, #6c63ff);
  background: var(--accent-bg, rgba(108,99,255,0.1));
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.opening-name-lg {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary, #e0e0f0);
}

.modal-close {
  font-size: 36rpx;
  color: var(--text-dim, #666);
  padding: 8rpx;
}

.opening-modal-body {
  flex: 1;
  padding: 24rpx 28rpx;
  overflow-y: auto;
}

.opening-section {
  margin-bottom: 28rpx;
}

.opening-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #e0e0f0);
  display: block;
  margin-bottom: 12rpx;
}

.opening-moves {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.opening-move-tag {
  font-size: 24rpx;
  font-family: 'Courier New', monospace;
  padding: 6rpx 14rpx;
  background: var(--bg-card-hover, rgba(255,255,255,0.05));
  border-radius: 8rpx;
  color: var(--text-secondary, #a0a0c0);
}

.opening-text-body {
  font-size: 26rpx;
  color: var(--text-secondary, #a0a0c0);
  line-height: 1.6;
  display: block;
}

.opening-plan-item {
  font-size: 26rpx;
  color: var(--text-secondary, #a0a0c0);
  display: block;
  padding: 4rpx 0;
  line-height: 1.5;
}

.opening-variation {
  background: var(--bg-card-hover, rgba(255,255,255,0.03));
  border: 1px solid var(--border-color-light, rgba(255,255,255,0.08));
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.variation-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.variation-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent, #6c63ff);
}

.variation-moves {
  font-size: 22rpx;
  font-family: 'Courier New', monospace;
  color: var(--text-dim, #666);
}

.variation-idea {
  font-size: 24rpx;
  color: var(--text-secondary, #a0a0c0);
  display: block;
}

.player-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.player-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  background: rgba(251, 191, 36, 0.15);
  border-radius: 20rpx;
  color: #fbbf24;
}

.loading-tip, .error-tip, .empty-tip {
  text-align: center;
  padding: 40rpx;
  font-size: 28rpx;
  color: var(--text-dim, #666);
}
.error-tip { color: var(--danger, #f87171); }