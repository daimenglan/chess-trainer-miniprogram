.analysis-panel {
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  gap: 16rpx;
  color: #666688;
}

.placeholder-icon {
  font-size: 80rpx;
  opacity: 0.3;
}

.placeholder-text {
  font-size: 26rpx;
}

.panel-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  gap: 12rpx;
  padding: 12rpx;
}

/* 评估条 */
.evaluation-bar-container {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.evaluation-bar-bg {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
}

.evaluation-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.evaluation-score {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  font-family: 'Courier New', monospace;
}

.score-green { color: #4ade80; }
.score-red { color: #f87171; }
.score-neutral { color: #facc15; }

.eval-label {
  font-size: 22rpx;
  font-weight: 500;
  opacity: 0.7;
}

/* 开局名称 */
.opening-name {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 12rpx;
  background: rgba(108, 99, 255, 0.1);
  border-radius: 8rpx;
  border: 1px solid rgba(108, 99, 255, 0.2);
}

.opening-name:active {
  opacity: 0.7;
}

.eco-code {
  font-size: 20rpx;
  font-weight: 700;
  color: #6c63ff;
  background: rgba(108, 99, 255, 0.15);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.opening-text {
  font-size: 22rpx;
  color: #a0a0c0;
}

/* AI思考中 */
.thinking-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx;
  font-size: 22rpx;
  color: #8888aa;
}

.thinking-dot {
  width: 16rpx;
  height: 16rpx;
  background: #6c63ff;
  border-radius: 50%;
  animation: pulse 1s ease-in-out infinite;
}

/* 分析错误 */
.analysis-error {
  padding: 8rpx 12rpx;
  background: rgba(239, 68, 68, 0.1);
  border-radius: 8rpx;
  border: 1px solid rgba(239, 68, 68, 0.2);
  font-size: 20rpx;
  color: #f87171;
}

/* 候选走法列表 */
.candidates-list {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.candidate-item {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  padding: 10rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 10rpx;
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.candidate-item:active {
  background: rgba(255, 255, 255, 0.08);
}

.candidate-rank {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.rank-1 { background: #2563eb; box-shadow: 0 0 10rpx rgba(37, 99, 235, 0.4); }
.rank-2 { background: #ea580c; }
.rank-3 { background: #64748b; }

.candidate-info {
  flex: 1;
  min-width: 0;
}

.candidate-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4rpx;
}

.candidate-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #e0e0f0;
}

.candidate-score {
  font-size: 22rpx;
  font-weight: 700;
  font-family: 'Courier New', monospace;
}

.candidate-detail {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  margin-bottom: 4rpx;
}

.detail-pro {
  font-size: 18rpx;
  color: #4ade80;
  line-height: 1.4;
}

.detail-con {
  font-size: 18rpx;
  color: #f87171;
  line-height: 1.4;
}

.tactics-row {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  margin-bottom: 4rpx;
}

.tactic-tag {
  font-size: 16rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(234, 179, 8, 0.15);
  color: #facc15;
}

.line-row {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  align-items: center;
}

.line-label {
  font-size: 16rpx;
  color: #666688;
}

.line-move {
  font-size: 18rpx;
  color: #a0a0c0;
  font-family: 'Courier New', monospace;
}

.candidate-action {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
}

.action-btn {
  font-size: 20rpx;
  color: #6c63ff;
  font-weight: 600;
}

.hints-off {
  text-align: center;
  padding: 20rpx;
  font-size: 22rpx;
  color: #666688;
}

.hints-toggle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  margin: 12rpx 16rpx;
  background: rgba(108, 99, 255, 0.1);
  border: 1px solid rgba(108, 99, 255, 0.2);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #6c63ff;
  font-weight: 600;
  transition: all 0.2s;
}

.hints-toggle-btn:active {
  background: rgba(108, 99, 255, 0.2);
  opacity: 0.8;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}