<view class="analysis-panel">
  <!-- 占位提示 -->
  <view wx:if="{{!gameStarted}}" class="placeholder">
    <text class="placeholder-icon">♟</text>
    <text class="placeholder-text">点击"新建对局"开始</text>
  </view>

  <view wx:else class="panel-content">
    <!-- 评估条（双向：左半对方优势红色、右半己方优势绿色，同网页版 AnalysisPanel） -->
    <view class="evaluation-bar-container">
      <view class="eval-row">
        <view class="eval-bar">
          <!-- 左半（对方优势 → 红色，从中心向左延伸） -->
          <view class="eval-bar-half eval-bar-left">
            <view class="eval-bar-fill-left" style="width: {{evaluationBarLeftWidth}}%;"></view>
          </view>
          <!-- 中心分割线 -->
          <view class="eval-bar-divider"></view>
          <!-- 右半（己方优势 → 绿色，从中心向右延伸） -->
          <view class="eval-bar-half eval-bar-right">
            <view class="eval-bar-fill-right" style="width: {{evaluationBarRightWidth}}%;"></view>
          </view>
        </view>
        <text class="evaluation-score {{evaluation > 0.3 ? 'score-green' : evaluation < -0.3 ? 'score-red' : 'score-neutral'}}">{{evaluationFormatted}}</text>
      </view>
      <text class="eval-sub">{{evaluationSubText}}</text>
      <!-- 手动推演：显示比推演前赚亏 -->
      <view wx:if="{{exploration === 'manual' && baselineEval != null && baselineEval !== 0}}" class="baseline-delta">
        <text class="baseline-delta-text" style="{{baselineDelta > 0.3 ? 'color:#16a34a' : baselineDelta < -0.3 ? 'color:#dc2626' : 'color:#6b7280'}}">
          比推演前 {{baselineDelta > 0 ? '+' : ''}}{{baselineDelta.toFixed(2)}}
        </text>
      </view>
    </view>

    <!-- 开局名称 -->
    <view wx:if="{{ecoCode}}" class="opening-name" catchtap="onShowOpening">
      <text class="eco-code">{{ecoCode}}</text>
      <text class="opening-text">{{openingNameCN || openingName}}</text>
    </view>

    <!-- 开局百科弹窗 -->
    <view wx:if="{{showOpeningModal}}" class="modal-mask" catchtap="onCloseOpening">
      <view class="opening-modal" catchtap="stopPropagation">
        <view class="opening-modal-header">
          <view class="opening-modal-title">
            <text class="eco-code-lg">{{ecoCode}}</text>
            <text class="opening-name-lg">{{openingNameCN || openingName}}</text>
          </view>
          <text class="modal-close" catchtap="onCloseOpening">✕</text>
        </view>
        <scroll-view scroll-y class="opening-modal-body">
          <view wx:if="{{openingLoading}}" class="loading-tip">加载中...</view>
          <view wx:elif="{{openingError}}" class="error-tip">{{openingError}}</view>
          <block wx:elif="{{openingEntry != null}}">
            <!-- 开局定式 -->
            <view wx:if="{{openingEntry.moves && openingEntry.moves.length > 0}}" class="opening-section">
              <text class="opening-section-title">📝 开局定式</text>
              <view class="opening-moves">
                <text wx:for="{{openingEntry.moves}}" wx:for-item="m" wx:key="*this" class="opening-move-tag">{{m}}</text>
              </view>
            </view>
            <!-- 概述 -->
            <view wx:if="{{openingEntry.description}}" class="opening-section">
              <text class="opening-section-title">📖 概述</text>
              <text class="opening-text-body">{{openingEntry.description}}</text>
            </view>
            <!-- 开局思路 -->
            <view wx:if="{{openingEntry.idea}}" class="opening-section">
              <text class="opening-section-title">💡 开局思路</text>
              <text class="opening-text-body">{{openingEntry.idea}}</text>
            </view>
            <!-- 典型计划 -->
            <view wx:if="{{openingEntry.typicalPlans && openingEntry.typicalPlans.length > 0}}" class="opening-section">
              <text class="opening-section-title">🎯 典型计划</text>
              <text wx:for="{{openingEntry.typicalPlans}}" wx:for-item="plan" wx:key="*this" class="opening-plan-item">• {{plan}}</text>
            </view>
            <!-- 关键变例 -->
            <view wx:if="{{openingEntry.keyVariations && openingEntry.keyVariations.length > 0}}" class="opening-section">
              <text class="opening-section-title">🔀 关键变例</text>
              <view wx:for="{{openingEntry.keyVariations}}" wx:for-item="v" wx:key="name" class="opening-variation">
                <view class="variation-header">
                  <text class="variation-name">{{v.name}}</text>
                  <text class="variation-moves">{{v.moves}}</text>
                </view>
                <text class="variation-idea">{{v.idea}}</text>
              </view>
            </view>
            <!-- 著名棋手 -->
            <view wx:if="{{openingEntry.famousPlayers && openingEntry.famousPlayers.length > 0}}" class="opening-section">
              <text class="opening-section-title">🏆 著名棋手</text>
              <view class="player-tags">
                <text wx:for="{{openingEntry.famousPlayers}}" wx:for-item="p" wx:key="*this" class="player-tag">{{p}}</text>
              </view>
            </view>
          </block>
          <view wx:else class="empty-tip">暂无开局百科信息</view>
        </scroll-view>
      </view>
    </view>

    <!-- AI 思考中 -->
    <view wx:if="{{isAIThinking}}" class="thinking-indicator">
      <view class="thinking-dot"></view>
      <text>AI 思考中...</text>
    </view>

    <!-- 分析错误 -->
    <view wx:if="{{analysisError}}" class="analysis-error">
      <text>{{analysisError}}</text>
    </view>

    <!-- 候选走法：1/2/3 编号切换 + 选中走法的分析内容（同网页版候选标记详情） -->
    <view wx:if="{{showHints && candidates.length > 0}}" class="candidates-block">
      <view class="candidate-tabs">
        <view wx:for="{{candidates}}" wx:for-item="c" wx:key="uci"
              class="candidate-tab rank-{{c.rank}} {{selectedRank === c.rank ? 'candidate-tab-active' : ''}}"
              data-rank="{{c.rank}}" catchtap="onSelectCandidateTab">#{{c.rank}}</view>
        <text class="candidate-tabs-hint">点编号看分析</text>
      </view>
      <scroll-view wx:if="{{selectedCandidate}}" class="candidate-detail-scroll" scroll-y>
        <view class="candidate-detail-card rank-border-{{selectedCandidate.rank}}">
          <view class="candidate-header">
            <text class="candidate-label">#{{selectedCandidate.rank}} {{selectedCandidate.label}}</text>
            <text class="candidate-score" style="color: {{selectedCandidate.scoreColor}};">{{selectedCandidate.scoreFormatted}}</text>
          </view>
          <!-- 优点 -->
          <view wx:if="{{selectedCandidate.pros.length > 0}}" class="candidate-detail">
            <text wx:for="{{selectedCandidate.pros}}" wx:for-item="pro" wx:key="key" class="detail-pro">✓ {{pro.text}}</text>
          </view>
          <!-- 缺点 -->
          <view wx:if="{{selectedCandidate.cons.length > 0}}" class="candidate-detail">
            <text wx:for="{{selectedCandidate.cons}}" wx:for-item="con" wx:key="key" class="detail-con">! {{con.text}}</text>
          </view>
          <!-- 战术标签 -->
          <view wx:if="{{selectedCandidate.tactics.length > 0}}" class="tactics-row">
            <text wx:for="{{selectedCandidate.tactics}}" wx:for-item="t" wx:key="key" class="tactic-tag">{{t.text}}</text>
          </view>
          <!-- 续着线 -->
          <view wx:if="{{selectedCandidate.line.length > 1}}" class="line-row">
            <text class="line-label">预计变化：</text>
            <text wx:for="{{selectedCandidate.line}}" wx:for-item="mv" wx:key="key" class="line-move">{{mv.text}}</text>
          </view>
          <!-- 推演 / 自动 -->
          <view wx:if="{{showActions}}" class="detail-actions">
            <view class="action-pill action-pill-explore" catchtap="onExplorationStart" data-uci="{{selectedCandidate.uci}}">🔍 推演</view>
            <view class="action-pill action-pill-auto" catchtap="onAutoContinuation" data-uci="{{selectedCandidate.uci}}">▶ 自动</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>