.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-overlay);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.promotion-dialog {
  padding: 40rpx;
  width: 500rpx;
  text-align: center;
  background: rgba(30, 30, 60, 0.95);
  border: 1px solid var(--border-color);
}

.dialog-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 32rpx;
}

.piece-options {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.piece-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  transition: all 0.2s;
}

.piece-option:active {
  background: var(--accent-border);
  transform: scale(0.95);
}

.piece-label {
  font-size: 28rpx;
  color: var(--text-dim);
}

.cancel-btn {
  font-size: 30rpx;
  color: var(--text-muted);
  padding: 16rpx;
}

.cancel-btn:active {
  opacity: 0.7;
}