.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.promotion-dialog {
  padding: 30rpx;
  width: 440rpx;
  text-align: center;
  background: rgba(30, 30, 60, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #e0e0f0;
  margin-bottom: 24rpx;
}

.piece-options {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.piece-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  transition: all 0.2s;
}

.piece-option:active {
  background: rgba(108, 99, 255, 0.2);
  transform: scale(0.95);
}

.piece-label {
  font-size: 22rpx;
  color: #a0a0c0;
}

.cancel-btn {
  font-size: 26rpx;
  color: #8888aa;
  padding: 12rpx;
}

.cancel-btn:active {
  opacity: 0.7;
}