.coach-chat {
  position: relative;
  z-index: 100;
}

.coach-float-btn {
  position: fixed;
  bottom: 40rpx;
  right: 30rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f97316, #ea580c);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(249, 115, 22, 0.4);
  z-index: 100;
}

.coach-float-btn:active {
  transform: scale(0.9);
}

.coach-icon {
  font-size: 48rpx;
}

.unread-dot {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #ef4444;
  color: #fff;
  font-size: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.coach-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
}

.coach-card {
  position: fixed;
  bottom: 20rpx;
  right: 20rpx;
  width: 640rpx;
  max-width: 90vw;
  height: 720rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  background: rgba(26, 26, 46, 0.96);
  border: 1px solid rgba(255, 255, 255, 0.1);
  z-index: 100;
  overflow: hidden;
}

.coach-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  background: linear-gradient(135deg, rgba(108, 99, 255, 0.15), rgba(72, 52, 212, 0.15));
}

.coach-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #e0e0f0;
}

.coach-actions {
  display: flex;
  gap: 12rpx;
  font-size: 20rpx;
}

.stop-btn, .clear-btn, .close-btn {
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  color: #8888aa;
}

.stop-btn { color: #f87171; }
.close-btn { font-size: 24rpx; }

.coach-messages {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.welcome-msg {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 30rpx 20rpx;
}

.welcome-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #e0e0f0;
}

.welcome-text {
  font-size: 22rpx;
  color: #8888aa;
  text-align: center;
}

.suggestion-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.suggestion-chip {
  padding: 8rpx 16rpx;
  background: rgba(108, 99, 255, 0.12);
  border-radius: 16rpx;
  border: 1px solid rgba(108, 99, 255, 0.2);
  font-size: 20rpx;
  color: #6c63ff;
}

.suggestion-chip:active {
  background: rgba(108, 99, 255, 0.25);
}

.msg-row {
  display: flex;
  margin-bottom: 8rpx;
}

.msg-user {
  justify-content: flex-end;
}

.msg-assistant {
  justify-content: flex-start;
}

.msg-bubble {
  max-width: 80%;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.msg-user .msg-bubble {
  background: linear-gradient(135deg, #6c63ff, #4834d4);
  color: #fff;
  border-bottom-right-radius: 4rpx;
}

.msg-assistant .msg-bubble {
  background: rgba(255, 255, 255, 0.08);
  color: #c0c0e0;
  border-bottom-left-radius: 4rpx;
}

.msg-content {
  white-space: pre-wrap;
  word-break: break-word;
}

.streaming-cursor {
  display: inline-block;
  animation: blink 0.8s step-end infinite;
  color: #6c63ff;
  font-weight: bold;
}

@keyframes blink {
  50% { opacity: 0; }
}

.coach-input-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.coach-input {
  flex: 1;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  color: #e0e0f0;
}

.send-btn {
  padding: 12rpx 24rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #666688;
  background: rgba(255, 255, 255, 0.05);
}

.send-active {
  color: #fff;
  background: linear-gradient(135deg, #6c63ff, #4834d4);
}