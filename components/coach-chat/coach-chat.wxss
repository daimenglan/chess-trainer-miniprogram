.coach-chat {
  position: relative;
  z-index: 100;
}

.coach-float-btn {
  position: fixed;
  bottom: 40rpx;
  right: 30rpx;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f97316, #ea580c);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(249, 115, 22, 0.4);
  z-index: 100;
}

.coach-float-btn:active {
  transform: scale(0.9);
}

.coach-icon {
  font-size: 54rpx;
}

.unread-dot {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.coach-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
}

.coach-card {
  position: fixed;
  bottom: 20rpx;
  right: 20rpx;
  width: 680rpx;
  max-width: 92vw;
  height: 780rpx;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  background: rgba(26, 26, 46, 0.96);
  border: 1px solid var(--border-color);
  z-index: 100;
  overflow: hidden;
}

.coach-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1px solid var(--border-color);
  background: linear-gradient(135deg, rgba(108, 99, 255, 0.15), rgba(72, 52, 212, 0.15));
}

.coach-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.coach-actions {
  display: flex;
  gap: 14rpx;
  font-size: 24rpx;
}

.stop-btn, .clear-btn, .close-btn {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  color: var(--text-muted);
}

.stop-btn { color: var(--danger); }
.close-btn { font-size: 28rpx; }

.coach-messages {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.welcome-msg {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 36rpx 24rpx;
}

.welcome-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.welcome-text {
  font-size: 28rpx;
  color: var(--text-muted);
  text-align: center;
}

.suggestion-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx;
  margin-top: 10rpx;
}

.suggestion-chip {
  padding: 12rpx 20rpx;
  background: var(--accent-bg);
  border-radius: 20rpx;
  border: 1px solid var(--accent-border);
  font-size: 26rpx;
  color: var(--accent);
}

.suggestion-chip:active {
  background: rgba(108, 99, 255, 0.25);
}

.msg-row {
  display: flex;
  margin-bottom: 10rpx;
}

.msg-user {
  justify-content: flex-end;
}

.msg-assistant {
  justify-content: flex-start;
}

.msg-bubble {
  max-width: 82%;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.msg-user .msg-bubble {
  background: var(--accent-gradient);
  color: #fff;
  border-bottom-right-radius: 4rpx;
}

.msg-assistant .msg-bubble {
  background: var(--bg-card-hover);
  color: var(--text-secondary);
  border-bottom-left-radius: 4rpx;
}

.msg-content {
  white-space: pre-wrap;
  word-break: break-word;
}

.streaming-cursor {
  display: inline-block;
  animation: blink 0.8s step-end infinite;
  color: var(--accent);
  font-weight: bold;
}

@keyframes blink {
  50% { opacity: 0; }
}

.coach-input-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  border-top: 1px solid var(--border-color);
}

.coach-input {
  flex: 1;
  height: 76rpx;
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.send-btn {
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-dim);
  background: var(--bg-card-hover);
}

.send-active {
  color: #fff;
  background: var(--accent-gradient);
}
/* ===== AI生成内容显著标识 ===== */
.ai-gen-flag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: var(--accent-gradient, linear-gradient(135deg, #6c63ff, #4834d4));
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  align-self: center;
}

.ai-gen-notice {
  padding: 10rpx 24rpx;
  font-size: 20rpx;
  color: var(--text-muted, #8888aa);
  background: rgba(108, 99, 255, 0.08);
  border-bottom: 1px solid var(--border-color);
}

.msg-ai-tag {
  display: inline-flex;
  margin-bottom: 8rpx;
}

.msg-ai-tag text {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: #c9c5ff;
  background: rgba(108, 99, 255, 0.25);
  border: 1rpx solid rgba(108, 99, 255, 0.55);
}
