.line-chart-wrap {
  width: 100%;
}

.chart-canvas {
  width: 100%;
  height: 360rpx;
}

.chart-empty {
  height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: 26rpx;
}

.chart-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 12rpx 8rpx 0;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-name {
  font-size: 22rpx;
  color: var(--text-secondary);
}
