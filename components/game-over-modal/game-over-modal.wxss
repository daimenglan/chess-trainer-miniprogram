.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.game-over-modal {
  padding: 48rpx 60rpx;
  text-align: center;
  background: rgba(26, 26, 46, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.1);
  min-width: 400rpx;
}

.emoji {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  color: #e0e0f0;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #8888aa;
  margin-bottom: 12rpx;
}

.result-text {
  font-size: 22rpx;
  color: #666688;
  margin-bottom: 32rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.action-btn {
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #c0c0e0;
  font-size: 24rpx;
  font-weight: 600;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.action-btn:active {
  opacity: 0.7;
  transform: scale(0.97);
}

.action-primary {
  background: linear-gradient(135deg, #6c63ff, #4834d4);
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(108, 99, 255, 0.3);
}