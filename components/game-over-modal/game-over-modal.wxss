.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-overlay);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.game-over-modal {
  padding: 56rpx 72rpx;
  text-align: center;
  background: rgba(26, 26, 46, 0.95);
  border: 1px solid var(--border-color);
  min-width: 460rpx;
}

.emoji {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 30rpx;
  color: var(--text-muted);
  margin-bottom: 16rpx;
}

.result-text {
  font-size: 28rpx;
  color: var(--text-dim);
  margin-bottom: 40rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.action-btn {
  padding: 20rpx 40rpx;
  border-radius: 14rpx;
  background: var(--bg-card-hover);
  color: var(--text-secondary);
  font-size: 30rpx;
  font-weight: 600;
  border: 1px solid var(--border-color);
}

.action-btn:active {
  opacity: 0.7;
  transform: scale(0.97);
}

.action-primary {
  background: var(--accent-gradient);
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(108, 99, 255, 0.3);
}