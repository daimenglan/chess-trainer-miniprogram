.watch-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 8rpx;
}

.watch-grid-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  flex-shrink: 0;
}

.watch-grid-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.watch-grid-hint {
  font-size: 22rpx;
  color: var(--text-muted);
}

.watch-grid-body {
  flex: 1;
  min-height: 0;
}

.watch-grid-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: var(--text-muted);
}

.watch-grid-cells {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 10rpx;
  height: 100%;
  min-height: 0;
}

.watch-grid-cell {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 16rpx;
  padding: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-height: 0;
  overflow: hidden;
  transition: transform 0.15s ease;
}

.watch-grid-cell-hover {
  transform: scale(0.98);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.15);
}

.cell-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 0 4rpx;
}

.cell-channel {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--accent-color, #4a9eff);
}

.cell-ended-tag {
  font-size: 20rpx;
  color: #f0c040;
  background: rgba(240, 192, 64, 0.15);
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.cell-error-tag {
  font-size: 20rpx;
  color: #f06060;
  background: rgba(240, 96, 96, 0.15);
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.cell-player {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 8rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.cell-player-white {
  background: rgba(255, 255, 255, 0.06);
}

.cell-player-black {
  background: rgba(0, 0, 0, 0.12);
}

.cell-side-icon {
  font-size: 22rpx;
  flex-shrink: 0;
}

.cell-player-name {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell-player-waiting {
  font-size: 22rpx;
  color: var(--text-muted);
  flex: 1;
}

.cell-player-time {
  font-size: 22rpx;
  font-weight: 700;
  font-family: monospace;
  color: var(--text-primary);
  flex-shrink: 0;
}

.cell-board {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.cell-board chess-board {
  width: 100%;
  height: 100%;
  max-width: 100%;
  max-height: 100%;
}