<view class="watch-grid" catchtap="onRefresh">
  <view class="watch-grid-header">
    <text class="watch-grid-title">4 宫格同屏观战</text>
    <text class="watch-grid-hint">点击任一盘进入大棋盘</text>
  </view>
  <view class="watch-grid-body">
    <view wx:if="{{loading}}" class="watch-grid-loading">
      <text>⏳ 正在获取对局…</text>
    </view>
    <view wx:else class="watch-grid-cells">
      <view wx:for="{{channels}}" wx:key="*this" class="watch-grid-cell"
            catchtap="onOpenGame" data-channel="{{item}}"
            hover-class="watch-grid-cell-hover">
        <view class="cell-header">
          <text class="cell-channel">{{channelLabel(item)}}</text>
          <view wx:if="{{games[item] && games[item].ended}}" class="cell-ended-tag">
            <text>已结束</text>
          </view>
          <view wx:if="{{games[item] && games[item].error && !games[item].ended}}" class="cell-error-tag">
            <text>⚠ 重连中</text>
          </view>
        </view>
        <view class="cell-player cell-player-white">
          <text class="cell-side-icon">⬜</text>
          <text wx:if="{{games[item] && games[item].white}}" class="cell-player-name">{{games[item].white.name}}</text>
          <text wx:else class="cell-player-waiting">等待对手…</text>
          <text wx:if="{{games[item] && games[item].white}}" class="cell-player-time">{{formatTime(games[item].whiteSeconds)}}</text>
        </view>
        <view class="cell-board">
          <chess-board fen="{{games[item] ? games[item].fen : ''}}"
                     lastMoveFrom="{{games[item] ? games[item].lastMoveFrom : ''}}"
                     lastMoveTo="{{games[item] ? games[item].lastMoveTo : ''}}"
                     labelVariant="inline"
                     disableHighlight="{{true}}"
                     boardColorPreset="blueWhite">
          </chess-board>
        </view>
        <view class="cell-player cell-player-black">
          <text class="cell-side-icon">⬛</text>
          <text wx:if="{{games[item] && games[item].black}}" class="cell-player-name">{{games[item].black.name}}</text>
          <text wx:else class="cell-player-waiting">等待对手…</text>
          <text wx:if="{{games[item] && games[item].black}}" class="cell-player-time">{{formatTime(games[item].blackSeconds)}}</text>
        </view>
      </view>
    </view>
  </view>
</view>