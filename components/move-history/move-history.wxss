.move-history {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 12rpx;
  border: 1px solid rgba(255, 255, 255, 0.06);
  overflow: hidden;
}

.move-header {
  font-size: 20rpx;
  font-weight: 600;
  color: #8888aa;
  padding: 10rpx 16rpx;
  background: rgba(255, 255, 255, 0.03);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.move-list {
  max-height: 360rpx;
  overflow-y: auto;
  padding: 8rpx;
}

.empty-moves {
  text-align: center;
  padding: 20rpx;
  font-size: 20rpx;
  color: #666688;
}

.move-row {
  display: flex;
  align-items: center;
  padding: 4rpx 8rpx;
  gap: 8rpx;
}

.move-number {
  width: 40rpx;
  font-size: 18rpx;
  color: #666688;
  text-align: right;
  flex-shrink: 0;
}

.move-cell {
  flex: 1;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #c0c0e0;
  font-family: 'Courier New', monospace;
  display: flex;
  align-items: center;
  gap: 4rpx;
  min-height: 36rpx;
}

.move-cell:active {
  background: rgba(108, 99, 255, 0.15);
}

.move-current {
  background: rgba(108, 99, 255, 0.2) !important;
  color: #e0e0f0;
  font-weight: 600;
}

.move-empty {
  color: #444466;
}

.move-review {
  font-size: 16rpx;
}