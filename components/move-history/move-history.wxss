.move-history {
  background: var(--bg-card);
  border-radius: 12rpx;
  border: 1px solid var(--border-color-light);
  overflow: hidden;
}

.move-header {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-muted);
  padding: 14rpx 20rpx;
  background: var(--bg-card);
  border-bottom: 1px solid var(--border-color-light);
}

.move-list {
  max-height: 400rpx;
  overflow-y: auto;
  padding: 10rpx;
}

.empty-moves {
  text-align: center;
  padding: 24rpx;
  font-size: 26rpx;
  color: var(--text-dim);
}

.move-row {
  display: flex;
  align-items: center;
  padding: 8rpx 12rpx;
  gap: 10rpx;
}

.move-number {
  width: 50rpx;
  font-size: 24rpx;
  color: var(--text-dim);
  text-align: right;
  flex-shrink: 0;
}

.move-cell {
  flex: 1;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  font-family: 'Courier New', monospace;
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-height: 44rpx;
}

.move-cell:active {
  background: var(--accent-bg);
}

.move-current {
  background: var(--accent-border) !important;
  color: var(--text-primary);
  font-weight: 600;
}

.move-empty {
  color: #444466;
}

.move-review {
  font-size: 20rpx;
}