.captured-pieces {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 20rpx;
  min-height: 44rpx;
}

.captured-top {
  justify-content: flex-start;
}

.captured-bottom {
  justify-content: flex-start;
}

.captured-group {
  display: flex;
  align-items: center;
  gap: 4rpx;
  opacity: 0.7;
}

.captured-count {
  font-size: 22rpx;
  color: var(--text-muted);
  font-weight: 600;
}