/* ===== 主题 CSS 变量（默认深色） ===== */
page,
.theme-dark {
  /* 页面背景 */
  --bg-primary: #0f0f23;
  --bg-secondary: #1a1a2e;
  --bg-card: rgba(255, 255, 255, 0.04);
  --bg-card-hover: rgba(255, 255, 255, 0.08);
  --bg-card-strong: rgba(255, 255, 255, 0.10);
  --bg-input: rgba(255, 255, 255, 0.06);
  --bg-overlay: rgba(0, 0, 0, 0.6);
  --bg-glass: rgba(26, 26, 46, 0.95);

  /* 边框 */
  --border-color: rgba(255, 255, 255, 0.08);
  --border-color-light: rgba(255, 255, 255, 0.06);
  --border-color-strong: rgba(255, 255, 255, 0.12);

  /* 文字 */
  --text-primary: #e0e0f0;
  --text-secondary: #c0c0e0;
  --text-muted: #8888aa;
  --text-dim: #666688;
  --text-placeholder: #555577;
  --text-white: #ffffff;

  /* 主题色 */
  --accent: #6c63ff;
  --accent-dark: #4834d4;
  --accent-gradient: linear-gradient(135deg, #6c63ff, #4834d4);
  --accent-bg: rgba(108, 99, 255, 0.15);
  --accent-bg-light: rgba(108, 99, 255, 0.10);
  --accent-border: rgba(108, 99, 255, 0.2);

  /* 状态色 */
  --success: #4ade80;
  --success-bg: rgba(34, 197, 94, 0.15);
  --warning: #facc15;
  --warning-bg: rgba(234, 179, 8, 0.15);
  --danger: #f87171;
  --danger-bg: rgba(239, 68, 68, 0.15);
  --info: #60a5fa;
  --info-bg: rgba(59, 130, 246, 0.15);

  /* 紫色 */
  --purple: #a78bfa;
  --purple-bg: rgba(139, 92, 246, 0.12);
  --purple-border: rgba(139, 92, 246, 0.2);

  /* 阴影 */
  --shadow: 0 4rpx 20rpx rgba(108, 99, 255, 0.3);
  --shadow-card: 0 2rpx 8rpx rgba(0,0,0,0.3);

  /* 棋盘 */
  --board-light: #ffffff;
  --board-dark: #5a7d9a;
  --board-frame: #4a6fa5;
}

/* ===== 浅色主题 ===== */
.theme-light {
  --bg-primary: #f0f0f5;
  --bg-secondary: #ffffff;
  --bg-card: rgba(255, 255, 255, 0.7);
  --bg-card-hover: rgba(255, 255, 255, 0.9);
  --bg-card-strong: rgba(255, 255, 255, 0.85);
  --bg-input: rgba(255, 255, 255, 0.8);
  --bg-overlay: rgba(0, 0, 0, 0.4);
  --bg-glass: rgba(255, 255, 255, 0.85);

  --border-color: rgba(0, 0, 0, 0.08);
  --border-color-light: rgba(0, 0, 0, 0.05);
  --border-color-strong: rgba(0, 0, 0, 0.12);

  --text-primary: #1a1a2e;
  --text-secondary: #444466;
  --text-muted: #8888aa;
  --text-dim: #aaaacc;
  --text-placeholder: #bbbbdd;
  --text-white: #ffffff;

  --accent: #6c63ff;
  --accent-dark: #4834d4;
  --accent-gradient: linear-gradient(135deg, #6c63ff, #4834d4);
  --accent-bg: rgba(108, 99, 255, 0.12);
  --accent-bg-light: rgba(108, 99, 255, 0.08);
  --accent-border: rgba(108, 99, 255, 0.2);

  --success: #22c55e;
  --success-bg: rgba(34, 197, 94, 0.10);
  --warning: #eab308;
  --warning-bg: rgba(234, 179, 8, 0.10);
  --danger: #ef4444;
  --danger-bg: rgba(239, 68, 68, 0.10);
  --info: #3b82f6;
  --info-bg: rgba(59, 130, 246, 0.10);

  --purple: #7c3aed;
  --purple-bg: rgba(139, 92, 246, 0.10);
  --purple-border: rgba(139, 92, 246, 0.2);

  --shadow: 0 4rpx 20rpx rgba(108, 99, 255, 0.25);
  --shadow-card: 0 2rpx 8rpx rgba(0,0,0,0.08);

  --board-light: #ffffff;
  --board-dark: #5a7d9a;
  --board-frame: #8BA8CC;
}

/* ===== 全局样式 ===== */
page {
  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 14px;
  line-height: 1.5;
  overflow-y: auto;
  height: 100vh;
}

/* ===== 玻璃态效果 ===== */
.glass {
  background: var(--bg-card);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--border-color);
  border-radius: 12px;
}

.glass-strong {
  background: var(--bg-card-strong);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--border-color-strong);
  border-radius: 12px;
}

/* ===== 按钮样式 ===== */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10px 20px;
  background: var(--accent-gradient);
  color: var(--text-white);
  border: none;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
  transition: all 0.2s;
  box-shadow: var(--shadow);
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-primary:disabled {
  opacity: 0.5;
  transform: none;
}

.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8px 16px;
  background: var(--bg-card-hover);
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  font-size: 13px;
  font-weight: 500;
  transition: all 0.2s;
}

.btn-secondary:active {
  background: var(--bg-card-strong);
  transform: scale(0.97);
}

.btn-secondary:disabled {
  opacity: 0.4;
  transform: none;
}

/* ===== 渐变边框 ===== */
.gradient-top {
  border-top: 2px solid;
  border-image: linear-gradient(90deg, #6c63ff, #4834d4, #6c63ff) 1;
}

/* ===== 滚动条 ===== */
::-webkit-scrollbar {
  width: 4px;
  height: 4px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: var(--border-color);
  border-radius: 2px;
}

/* ===== 动画 ===== */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in {
  animation: fadeIn 0.3s ease-out;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.pulse {
  animation: pulse 1.5s ease-in-out infinite;
}

/* ===== 棋盘检查 ===== */
.square-check {
  background: radial-gradient(ellipse at center, rgba(255, 0, 0, 0.6) 0%, transparent 70%) !important;
}

/* ===== 弹窗遮罩 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-overlay);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 标签卡片 ===== */
.tag {
  display: inline-block;
  padding: 2px 8px;
  font-size: 10px;
  border-radius: 10px;
  background: var(--bg-card-hover);
  color: var(--text-muted);
  margin-right: 4px;
  margin-bottom: 4px;
}

.tag-success {
  background: var(--success-bg);
  color: var(--success);
}

.tag-warning {
  background: var(--warning-bg);
  color: var(--warning);
}

.tag-danger {
  background: var(--danger-bg);
  color: var(--danger);
}

/* ===== 结果徽章 ===== */
.badge-win {
  background: var(--success-bg);
  color: var(--success);
  padding: 2px 8px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 600;
}

.badge-loss {
  background: var(--danger-bg);
  color: var(--danger);
  padding: 2px 8px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 600;
}

.badge-draw {
  background: var(--warning-bg);
  color: var(--warning);
  padding: 2px 8px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 600;
}

/* ===== 首页按钮（通用） ===== */
.home-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  margin: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--accent);
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 12rpx;
  cursor: pointer;
}