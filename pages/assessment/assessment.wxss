.assessment-page {
  min-height: 100vh;
  background: var(--bg-primary);
}

.page-scroll {
  padding: 20rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ===== 空状态 / 异常兜底（任何阶段都不留白） ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 80rpx 40rpx;
  margin-top: 40rpx;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 20rpx;
}
.empty-icon {
  font-size: 80rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}
.empty-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.6;
  margin-bottom: 40rpx;
}
.empty-state .btn-primary,
.empty-state .btn-secondary {
  width: 100%;
}

/* 错误提示 */
.error-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(239, 68, 68, 0.15);
  border: 1px solid rgba(239, 68, 68, 0.3);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}
.error-text {
  font-size: 22rpx;
  color: #ef4444;
  flex: 1;
}
.error-close {
  font-size: 24rpx;
  color: #ef4444;
  padding: 4rpx 8rpx;
}

/* ===== 通用组件 ===== */
.btn-primary {
  text-align: center;
  padding: 20rpx 32rpx;
  background: linear-gradient(135deg, #6c63ff, #a855f7);
  color: #fff;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.btn-secondary {
  text-align: center;
  padding: 18rpx 28rpx;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.btn-primary-small {
  text-align: center;
  padding: 14rpx 24rpx;
  background: linear-gradient(135deg, #6c63ff, #a855f7);
  color: #fff;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.btn-nav {
  text-align: center;
  padding: 14rpx 24rpx;
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
  border-radius: 12rpx;
  font-size: 22rpx;
}

.btn-disabled {
  opacity: 0.4;
}

.highlight {
  color: #6c63ff;
  font-weight: 700;
}

.loading-text {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
  padding: 20rpx 0;
}

/* ===== 进度条 ===== */
.progress-bar-bg {
  height: 12rpx;
  background: var(--bg-card-hover);
  border-radius: 6rpx;
  overflow: hidden;
  flex: 1;
}
.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #6c63ff, #a855f7);
  border-radius: 6rpx;
  transition: width 0.3s;
}
.progress-bar-fill.orange {
  background: linear-gradient(90deg, #f59e0b, #f97316);
}
.progress-bar-fill.white {
  background: rgba(255,255,255,0.8);
}

.progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.progress-text {
  font-size: 20rpx;
  color: var(--text-muted);
  flex-shrink: 0;
}

/* ===== 1. 介绍页 ===== */
.hero-card {
  background: linear-gradient(135deg, #6c63ff, #a855f7, #ec4899);
  color: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}
.hero-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}
.hero-title {
  font-size: 32rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 8rpx;
}
.hero-desc {
  font-size: 22rpx;
  opacity: 0.9;
  display: block;
  line-height: 1.6;
}

.step-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.step-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  text-align: center;
}
.step-icon {
  font-size: 40rpx;
  display: block;
  margin-bottom: 8rpx;
}
.step-title {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
}
.step-desc {
  font-size: 18rpx;
  color: var(--text-muted);
  display: block;
  line-height: 1.4;
}

.intro-actions {
  margin-bottom: 24rpx;
}

/* 历史报告 */
.history-section {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 20rpx;
}
.section-label {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}
.history-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx;
  background: var(--bg-card-hover);
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}
.history-icon {
  font-size: 32rpx;
}
.history-info {
  flex: 1;
  min-width: 0;
}
.history-headline {
  font-size: 20rpx;
  color: var(--text-primary);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.history-meta {
  font-size: 16rpx;
  color: var(--text-muted);
  display: block;
}
.history-elo {
  font-size: 28rpx;
  font-weight: 800;
  color: #6c63ff;
  flex-shrink: 0;
}

/* ===== 2. 问卷 ===== */
.question-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.question-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}
.question-hint {
  font-size: 20rpx;
  color: var(--text-muted);
  display: block;
  margin-bottom: 24rpx;
}
.option-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.option-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  border-radius: 12rpx;
}
.option-selected {
  background: rgba(108, 99, 255, 0.1);
  border-color: #6c63ff;
}
.option-radio {
  font-size: 24rpx;
}
.option-label {
  font-size: 22rpx;
  color: var(--text-primary);
}
.question-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.hint-warn {
  display: block;
  text-align: center;
  font-size: 18rpx;
  color: #f59e0b;
}

/* ===== 3. 选择方式 ===== */
.mode-notice {
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  margin-bottom: 20rpx;
  line-height: 1.5;
}
.mode-notice-indigo {
  background: rgba(108, 99, 255, 0.1);
  border: 1px solid rgba(108, 99, 255, 0.3);
  color: #6c63ff;
}
.mode-notice-green {
  background: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.3);
  color: #10b981;
}

.mode-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.mode-card {
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1px solid;
}
.mode-card-game {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(5, 150, 105, 0.05));
  border-color: rgba(16, 185, 129, 0.4);
}
.mode-card-puzzle {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.1), rgba(234, 88, 12, 0.05));
  border-color: rgba(245, 158, 11, 0.4);
}
.mode-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 12rpx;
}
.mode-title {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}
.mode-desc {
  font-size: 20rpx;
  color: var(--text-muted);
  display: block;
  line-height: 1.5;
  margin-bottom: 12rpx;
}
.mode-features {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.mode-feature {
  font-size: 18rpx;
  color: var(--text-success);
}
.mode-time {
  color: var(--text-muted);
}

/* ===== 4a. 对弈定级 ===== */
.game-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.game-card-header {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
  align-items: center;
}
.game-card-icon {
  font-size: 48rpx;
}
.game-card-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
}
.game-card-desc {
  font-size: 20rpx;
  color: var(--text-muted);
  display: block;
}
.game-tip {
  background: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.3);
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
}
.game-tip-text {
  font-size: 20rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  display: block;
}

.game-select {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.select-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.select-title {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.select-toggle {
  font-size: 20rpx;
  color: #6c63ff;
}
.select-hint {
  font-size: 18rpx;
  color: var(--text-muted);
  display: block;
  margin-bottom: 4rpx;
}
.select-warn {
  font-size: 16rpx;
  color: #f59e0b;
  display: block;
  margin-bottom: 12rpx;
}

.game-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin: 12rpx 0 16rpx;
}
.game-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx;
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  border-radius: 12rpx;
}
.game-item-checked {
  background: rgba(16, 185, 129, 0.1);
  border-color: #10b981;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2px solid var(--border-color);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 20rpx;
  color: #fff;
}
.checkbox-checked {
  background: #10b981;
  border-color: #10b981;
}
.game-result-icon {
  font-size: 28rpx;
}
.game-info {
  flex: 1;
  min-width: 0;
}
.game-name {
  font-size: 20rpx;
  color: var(--text-primary);
  display: block;
}
.game-meta {
  font-size: 16rpx;
  color: var(--text-muted);
  display: block;
}

.review-progress {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
}
.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4px solid var(--bg-card-hover);
  border-top-color: #6c63ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto 16rpx;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.review-text {
  font-size: 24rpx;
  color: var(--text-primary);
  display: block;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.review-count {
  font-size: 20rpx;
  color: var(--text-muted);
  display: block;
  margin-bottom: 16rpx;
}

/* ===== 4b. 习题定级 ===== */
.puzzle-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.puzzle-count {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.puzzle-meta {
  font-size: 18rpx;
  color: var(--text-muted);
}
.puzzle-target {
  display: block;
  text-align: center;
  font-size: 18rpx;
  color: var(--text-muted);
  margin: 12rpx 0;
}

.puzzle-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.puzzle-board-area {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 16rpx 0;
  text-align: center;
}
.puzzle-fen {
  font-size: 18rpx;
  color: var(--text-muted);
  display: block;
  word-break: break-all;
  margin-bottom: 8rpx;
}
.puzzle-orientation {
  font-size: 22rpx;
  color: var(--text-primary);
  display: block;
  font-weight: 600;
}

.move-input-area {
  display: flex;
  gap: 12rpx;
  margin: 12rpx 0;
}
.move-input {
  flex: 1;
  padding: 16rpx 20rpx;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--text-primary);
}

.feedback {
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  margin: 12rpx 0;
}
.feedback-ok {
  background: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.3);
  color: #10b981;
}
.feedback-bad {
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.3);
  color: #ef4444;
}

.puzzle-controls {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin: 16rpx 0;
}
.hint-text {
  font-size: 18rpx;
  color: var(--text-muted);
}
.hint-show {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: #6c63ff;
  margin: 8rpx 0;
}

.puzzle-next {
  margin: 20rpx 0;
}

/* 生成报告进度 */
.generating-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.generating-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 36rpx;
  width: 80%;
  max-width: 500rpx;
  text-align: center;
}
.generating-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}
.generating-msg {
  font-size: 20rpx;
  color: var(--text-muted);
  display: block;
  margin-bottom: 20rpx;
}
.generating-pct {
  font-size: 18rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 8rpx;
}

/* ===== 5. 报告 ===== */
.report-hero {
  background: linear-gradient(135deg, #6c63ff, #a855f7, #ec4899);
  color: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
}
.report-label {
  font-size: 20rpx;
  opacity: 0.8;
  display: block;
  margin-bottom: 20rpx;
}
.report-elo-row {
  display: flex;
  align-items: flex-end;
  gap: 24rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}
.report-elo-label {
  font-size: 20rpx;
  opacity: 0.8;
  display: block;
  margin-bottom: 4rpx;
}
.report-elo-value {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.report-elo-num {
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1;
}
.report-elo-range {
  font-size: 22rpx;
  opacity: 0.7;
}
.report-grade-label {
  font-size: 18rpx;
  opacity: 0.8;
  display: block;
  margin-bottom: 4rpx;
}
.report-grade-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
}
.report-headline {
  font-size: 24rpx;
  display: block;
  line-height: 1.5;
  margin-bottom: 16rpx;
  opacity: 0.95;
}
.report-confidence {
  margin-top: 12rpx;
}
.confidence-row {
  display: flex;
  justify-content: space-between;
  font-size: 18rpx;
  opacity: 0.8;
  margin-bottom: 8rpx;
}

/* 测评数据 */
.report-section {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1px solid var(--border-color);
}
.report-section.blue-border {
  border-color: rgba(59, 130, 246, 0.3);
}
.report-section-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
}

.metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 8rpx;
}
.metric-item {
  padding: 12rpx;
  background: var(--bg-card-hover);
  border-radius: 12rpx;
  text-align: center;
}
.metric-label {
  font-size: 16rpx;
  color: var(--text-muted);
  display: block;
}
.metric-value {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-primary);
  display: block;
  margin: 4rpx 0;
}
.metric-hint {
  font-size: 14rpx;
  color: var(--text-muted);
  display: block;
}

.report-style {
  display: block;
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 16rpx;
}

/* 优劣势 */
.report-sw-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.report-strengths {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1px solid rgba(16, 185, 129, 0.3);
}
.report-weaknesses {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1px solid rgba(245, 158, 11, 0.3);
}

.sw-title {
  font-size: 22rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
}
.sw-title.green { color: #10b981; }
.sw-title.amber { color: #f59e0b; }

.sw-list {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.sw-item {
  font-size: 20rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}
.sw-empty {
  font-size: 18rpx;
  color: var(--text-muted);
}

.suggestion-item {
  display: block;
  font-size: 20rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 8rpx;
}

/* 教练点评 */
.report-coach {
  background: linear-gradient(135deg, rgba(108,99,255,0.08), rgba(168,85,247,0.05));
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1px solid rgba(108,99,255,0.2);
}
.coach-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #6c63ff;
  display: block;
  margin-bottom: 12rpx;
}
.coach-text {
  font-size: 20rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  white-space: pre-wrap;
  display: block;
}

/* 下一步 */
.next-steps {
  margin-bottom: 20rpx;
}
.next-step {
  display: block;
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-bottom: 6rpx;
  line-height: 1.4;
}
.report-actions {
  margin-top: 20rpx;
}

/* ===== 步骤进度条 ===== */
.step-bar-wrap {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
  border: 1px solid var(--border-color);
}
.step-bar-collapsed {
  display: flex;
  align-items: center;
  gap: 8rpx;
  cursor: pointer;
}
.step-bar-collapsed-icon {
  font-size: 28rpx;
}
.step-bar-collapsed-text {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
}
.step-bar-collapsed-arrow {
  font-size: 18rpx;
  color: var(--text-muted);
}
.step-bar-expanded {
  cursor: pointer;
}
.step-bar-items {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.step-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  background: var(--bg-card-hover);
  border: 2px solid var(--border-color);
  color: var(--text-muted);
}
.step-bar-item.step-done .step-dot {
  background: #10b981;
  border-color: #10b981;
  color: #fff;
}
.step-bar-item.step-active .step-dot {
  background: linear-gradient(135deg, #6c63ff, #a855f7);
  border-color: #6c63ff;
  color: #fff;
}
.step-label {
  font-size: 16rpx;
  color: var(--text-muted);
}
.step-bar-item.step-done .step-label {
  color: #10b981;
}
.step-bar-item.step-active .step-label {
  color: #6c63ff;
  font-weight: 600;
}
.step-connector {
  flex: 1;
  height: 2px;
  background: var(--border-color);
  margin: 0 8rpx;
  margin-bottom: 36rpx;
}
.step-connector-done {
  background: #10b981;
}
.step-bar-collapse-hint {
  display: block;
  text-align: center;
  font-size: 14rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

/* ===== 交互棋盘区域 ===== */
.puzzle-board-area {
  display: flex;
  justify-content: center;
  margin: 16rpx 0;
  padding: 8rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  border: 1px solid var(--border-color);
}

/* ===== 对局太短模态弹窗 ===== */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}
.modal-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  width: 80%;
  max-width: 560rpx;
  text-align: center;
}
.modal-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 16rpx;
}
.modal-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}
.modal-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.6;
  display: block;
  margin-bottom: 32rpx;
}

/* ===== shake 动画 ===== */
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  10%, 30%, 50%, 70%, 90% { transform: translateX(-6rpx); }
  20%, 40%, 60%, 80% { transform: translateX(6rpx); }
}
.shake {
  animation: shake 0.4s ease-in-out;
}