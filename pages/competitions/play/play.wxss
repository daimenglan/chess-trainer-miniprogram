.page { background: var(--bg-page, #0f0f23); color: var(--text-primary, #e8e8f0); min-height: 100vh; }
.nav-bar { display: flex; align-items: center; padding: 24rpx 32rpx; background: var(--bg-card, #1a1a2e); border-bottom: 1rpx solid var(--border-color, #2a2a4a); position: sticky; top: 0; z-index: 100; }
.nav-back { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 20rpx; border-radius: 12rpx; background: var(--bg-hover, #252545); margin-right: 24rpx; }
.nav-back-icon { font-size: 32rpx; color: var(--text-primary, #e8e8f0); }
.nav-back-text { font-size: 26rpx; color: var(--text-primary, #e8e8f0); }
.nav-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); flex: 1; }
.play-container { padding: 24rpx 32rpx; height: calc(100vh - 100rpx); display: flex; flex-direction: column; align-items: center; }
.match-info { text-align: center; margin-bottom: 24rpx; }
.match-title { font-size: 28rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); display: block; margin-bottom: 8rpx; }
.match-status { font-size: 22rpx; color: var(--accent, #6c63ff); display: block; }
.board-placeholder { width: 100%; max-width: 600rpx; height: 600rpx; background: var(--bg-card, #1a1a2e); border-radius: 16rpx; border: 1rpx solid var(--border-color, #2a2a4a); display: flex; flex-direction: column; align-items: center; justify-content: center; margin-bottom: 24rpx; }
.placeholder-text { font-size: 32rpx; color: var(--text-primary, #e8e8f0); font-weight: 700; }
.placeholder-sub { font-size: 22rpx; color: var(--text-muted, #888); margin-top: 12rpx; }
.match-actions { display: flex; gap: 16rpx; }
.action-btn { padding: 16rpx 32rpx; background: var(--bg-card, #1a1a2e); border-radius: 12rpx; border: 1rpx solid var(--border-color, #2a2a4a); }
.action-btn text { font-size: 24rpx; color: var(--text-primary, #e8e8f0); }
.loading-tip { text-align: center; padding: 60rpx; }
.loading-tip text { font-size: 24rpx; color: var(--text-muted, #666); }