.page {
  background: var(--bg-page, #0f0f23);
  color: var(--text-primary, #e8e8f0);
  min-height: 100vh;
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--bg-card, #1a1a2e);
  border-bottom: 1rpx solid var(--border-color, #2a2a4a);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: var(--bg-hover, #252545);
  margin-right: 24rpx;
}

.nav-back-icon {
  font-size: 32rpx;
  color: var(--text-primary, #e8e8f0);
}

.nav-back-text {
  font-size: 26rpx;
  color: var(--text-primary, #e8e8f0);
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary, #e8e8f0);
  flex: 1;
}

.scroll-content {
  padding: 24rpx 32rpx;
  height: calc(100vh - 100rpx);
}

.detail-content {
  background: var(--bg-card, #1a1a2e);
  border-radius: 20rpx;
  padding: 32rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
}

.detail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-color, #2a2a4a);
}

.detail-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary, #e8e8f0);
  flex: 1;
  line-height: 1.3;
}

.detail-status {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 600;
  white-space: nowrap;
}

.detail-status[status="registration"] {
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.15);
}

.detail-status[status="ongoing"] {
  color: #22c55e;
  background: rgba(34, 197, 94, 0.15);
}

.detail-status[status="finished"] {
  color: #6b7280;
  background: rgba(107, 114, 128, 0.15);
}

.detail-section {
  margin-bottom: 28rpx;
}

.section-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--accent, #6c63ff);
  margin-bottom: 12rpx;
}

.section-text {
  font-size: 26rpx;
  color: var(--text-secondary, #a0a0c0);
  line-height: 1.6;
}

.info-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color, #2a2a4a);
}

.info-row:last-child {
  border-bottom: none;
}

.info-key {
  font-size: 24rpx;
  color: var(--text-secondary, #a0a0c0);
}

.info-value {
  font-size: 24rpx;
  color: var(--text-primary, #e8e8f0);
  font-weight: 500;
}

.join-btn {
  margin-top: 8rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #6c63ff, #8b8bff);
  border-radius: 12rpx;
  text-align: center;
}

.join-btn-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.loading-tip {
  text-align: center;
  padding: 60rpx 32rpx;
}

.loading-tip text {
  font-size: 24rpx;
  color: var(--text-muted, #666);
}