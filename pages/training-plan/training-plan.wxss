.plan-page {
  height: 100vh;
  background: var(--bg-primary);
}

.page-scroll {
  height: 100%;
  padding: 0 20rpx 60rpx;
}

.loading-state, .error-state {
  text-align: center;
  padding: 80rpx 0;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ===== 页头 ===== */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 8rpx 8rpx;
}
.header-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
  display: block;
}
.header-desc {
  font-size: 20rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 4rpx;
}
.header-refresh {
  font-size: 20rpx;
  color: var(--accent);
  padding: 8rpx 16rpx;
}

/* ===== 棋手档案摘要 ===== */
.profile-summary-card {
  background: linear-gradient(135deg, rgba(108,99,255,0.08), rgba(168,85,247,0.05));
  border: 1px solid rgba(108,99,255,0.25);
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 16rpx 0;
}
.profile-summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.profile-summary-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.profile-summary-more {
  font-size: 18rpx;
  color: #6c63ff;
}
.profile-summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.profile-summary-item {
  background: var(--bg-card);
  border-radius: 12rpx;
  padding: 16rpx 8rpx;
  text-align: center;
}
.ps-icon {
  font-size: 28rpx;
  display: block;
  margin-bottom: 4rpx;
}
.ps-value {
  font-size: 28rpx;
  font-weight: 800;
  color: #6c63ff;
  display: block;
}
.ps-label {
  font-size: 16rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 2rpx;
}

.sw-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.sw-box {
  border-radius: 12rpx;
  padding: 14rpx;
}
.sw-strength {
  background: rgba(16,185,129,0.08);
  border: 1px solid rgba(16,185,129,0.2);
}
.sw-weakness {
  background: rgba(245,158,11,0.08);
  border: 1px solid rgba(245,158,11,0.2);
}
.sw-box-title {
  font-size: 18rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 6rpx;
}
.sw-strength .sw-box-title { color: #10b981; }
.sw-weakness .sw-box-title { color: #f59e0b; }
.sw-box-text {
  font-size: 18rpx;
  color: var(--text-secondary);
  display: block;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.profile-empty {
  text-align: center;
  padding: 12rpx 0;
}
.profile-empty-text {
  font-size: 18rpx;
  color: var(--text-muted);
  display: block;
  margin-bottom: 8rpx;
}

/* ===== 训练统计 ===== */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.stats-card-item {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 16rpx;
  padding: 20rpx;
}
.stats-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.stats-card-label {
  font-size: 18rpx;
  color: var(--text-muted);
}
.stats-card-emoji {
  font-size: 28rpx;
}
.stats-card-value {
  font-size: 36rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 8rpx;
}
.stats-card-value.blue { color: #3b82f6; }
.stats-card-value.orange { color: #f59e0b; }
.stats-card-value.green { color: #10b981; }
.stats-card-value.purple { color: #8b5cf6; }
.stats-card-hint {
  font-size: 16rpx;
  color: var(--text-muted);
  display: block;
  margin-bottom: 8rpx;
}

.xp-bar-wrap {
  margin-top: 4rpx;
}
.xp-bar-bg {
  height: 12rpx;
  background: var(--bg-card-hover);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 4rpx;
}
.xp-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #3b82f6, #6366f1);
  border-radius: 6rpx;
  transition: width 0.5s;
}
.xp-bar-fill.green-fill {
  background: linear-gradient(90deg, #10b981, #34d399);
}
.xp-text {
  font-size: 16rpx;
  color: var(--text-muted);
  display: block;
}

.streak-bar {
  display: flex;
  gap: 4rpx;
  margin-top: 4rpx;
}
.streak-dot {
  flex: 1;
  height: 8rpx;
  background: var(--bg-card-hover);
  border-radius: 4rpx;
}
.streak-active {
  background: linear-gradient(90deg, #f59e0b, #ef4444);
}

.achievement-preview {
  display: flex;
  gap: 6rpx;
}
.ach-preview-item {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  background: rgba(139,92,246,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}
.ach-locked {
  opacity: 0.4;
  background: var(--bg-card-hover);
}

/* ===== 激励横幅 ===== */
.motivation-banner {
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #fff;
}
.mb-icon {
  font-size: 40rpx;
}
.mb-text {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.5;
  flex: 1;
}
.mb-blue { background: linear-gradient(135deg, #3b82f6, #6366f1); }
.mb-green { background: linear-gradient(135deg, #10b981, #34d399); }
.mb-orange { background: linear-gradient(135deg, #f97316, #ef4444); }
.mb-amber { background: linear-gradient(135deg, #f59e0b, #f97316); }
.mb-purple { background: linear-gradient(135deg, #8b5cf6, #a855f7); }

/* ===== 内容区 ===== */
.plan-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 16rpx;
  padding: 24rpx;
}
.section-card.warn-border {
  border-color: rgba(245,158,11,0.3);
}

.section-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
}
.section-title-sub {
  font-size: 18rpx;
  font-weight: 400;
  color: var(--text-muted);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.section-header .section-title {
  margin-bottom: 0;
}

/* 难度推荐 */
.difficulty-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.diff-badge {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #f43f5e, #f97316);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  flex-shrink: 0;
}
.diff-num {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
}
.diff-label {
  font-size: 16rpx;
  opacity: 0.85;
  margin-top: 2rpx;
}
.diff-info {
  flex: 1;
}
.diff-range {
  font-size: 20rpx;
  color: var(--text-primary);
  display: block;
  font-weight: 600;
}
.diff-elo {
  font-size: 18rpx;
  color: var(--text-muted);
  display: block;
}
.diff-warn {
  font-size: 16rpx;
  color: #f59e0b;
  display: block;
  margin-top: 4rpx;
}
.diff-reason {
  font-size: 18rpx;
  color: var(--text-muted);
  display: block;
  line-height: 1.5;
}

/* 习题计划卡片 */
.plan-item {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}
.plan-item-header {
  display: flex;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.plan-item-num {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #f59e0b, #f97316);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 800;
  font-size: 22rpx;
  flex-shrink: 0;
}
.plan-item-info {
  flex: 1;
  min-width: 0;
}
.plan-item-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-bottom: 4rpx;
}
.plan-item-title {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.plan-item-tag {
  font-size: 16rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 500;
}
.tag-red { background: rgba(239,68,68,0.15); color: #ef4444; }
.tag-amber { background: rgba(245,158,11,0.15); color: #f59e0b; }
.tag-blue { background: rgba(59,130,246,0.15); color: #3b82f6; }
.plan-item-phase {
  font-size: 16rpx;
  padding: 2rpx 10rpx;
  background: var(--bg-card-hover);
  color: var(--text-muted);
  border-radius: 8rpx;
}
.plan-item-reason {
  font-size: 18rpx;
  color: var(--text-muted);
  display: block;
  line-height: 1.4;
}
.plan-item-meta {
  display: flex;
  gap: 16rpx;
  font-size: 18rpx;
  color: var(--text-muted);
  margin-bottom: 12rpx;
}

/* 弱点追踪 */
.mistake-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx;
  background: rgba(245,158,11,0.06);
  border-radius: 12rpx;
  margin-bottom: 6rpx;
}
.mi-icon {
  font-size: 24rpx;
}
.mi-info {
  flex: 1;
  min-width: 0;
}
.mi-theme {
  font-size: 18rpx;
  color: var(--text-primary);
  display: block;
}
.mi-meta {
  font-size: 16rpx;
  color: var(--text-muted);
  display: block;
}
.mi-status {
  font-size: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.mi-tracking {
  background: rgba(245,158,11,0.15);
  color: #f59e0b;
}
.mi-solved {
  background: rgba(16,185,129,0.15);
  color: #10b981;
}
.mistake-action {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}
.mistake-action-hint {
  font-size: 16rpx;
  color: var(--text-muted);
  flex: 1;
}

/* 成就墙 */
.achievement-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}
.ach-item {
  text-align: center;
  padding: 12rpx 4rpx;
}
.ach-unlocked {
  background: rgba(139,92,246,0.06);
  border-radius: 12rpx;
}
.ach-locked-full {
  opacity: 0.5;
}
.ach-icon-wrap {
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin: 0 auto 4rpx;
  background: var(--bg-card-hover);
}
.ach-icon-glow {
  background: linear-gradient(135deg, rgba(139,92,246,0.2), rgba(168,85,247,0.2));
}
.ach-name {
  font-size: 16rpx;
  color: var(--text-secondary);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ach-date {
  font-size: 14rpx;
  color: var(--text-muted);
  display: block;
}

/* 按钮变体 */
.btn-small-indigo {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #6c63ff, #a855f7);
  color: #fff;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.btn-small-green {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #10b981, #34d399);
  color: #fff;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.btn-small-blue {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #3b82f6, #6366f1);
  color: #fff;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.btn-small-amber {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #f59e0b, #f97316);
  color: #fff;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}
.quick-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  border-radius: 12rpx;
  font-size: 20rpx;
  color: var(--text-secondary);
}