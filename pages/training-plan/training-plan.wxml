<view class="plan-page {{__theme__ ? 'theme-' + __theme__ : ''}}">
  <scroll-view scroll-y class="page-scroll">

    <!-- ===== 页头 ===== -->
    <view class="page-header">
      <view class="header-text">
        <text class="header-title">🏋️ 训练中心</text>
        <text class="header-desc">个性化训练计划·棋手档案·进步追踪</text>
      </view>
      <text class="header-refresh" catchtap="loadData">🔄 刷新</text>
    </view>

    <!-- ===== 棋手档案摘要 ===== -->
    <view wx:if="{{plan}}" class="profile-summary-card">
      <view class="profile-summary-header">
        <text class="profile-summary-title">👤 我的棋手档案</text>
        <text class="profile-summary-more" catchtap="onGoProfile">查看完整档案 →</text>
      </view>
      <view class="profile-summary-grid">
        <view class="profile-summary-item">
          <text class="ps-icon">📊</text>
          <text class="ps-value">{{plan.estimatedRating > 0 ? plan.estimatedRating : plan.puzzleRating}}</text>
          <text class="ps-label">{{plan.estimatedRating > 0 ? '对局等级分' : '习题等级分'}}</text>
        </view>
        <view class="profile-summary-item">
          <text class="ps-icon">🎭</text>
          <text class="ps-value">{{profileStyle || '未知'}}</text>
          <text class="ps-label">棋风</text>
        </view>
        <view class="profile-summary-item">
          <text class="ps-icon">🏆</text>
          <text class="ps-value">{{winRateStr}}%</text>
          <text class="ps-label">胜率</text>
        </view>
        <view class="profile-summary-item">
          <text class="ps-icon">♟️</text>
          <text class="ps-value">{{plan.basedOnGames}}</text>
          <text class="ps-label">对局数</text>
        </view>
      </view>
      <!-- 优劣势摘要 -->
      <view wx:if="{{profile}}" class="sw-row">
        <view wx:if="{{profile.strengths}}" class="sw-box sw-strength">
          <text class="sw-box-title">🏅 优势</text>
          <text class="sw-box-text">{{strengthsShort}}</text>
        </view>
        <view wx:if="{{profile.weaknesses}}" class="sw-box sw-weakness">
          <text class="sw-box-title">🎯 待改进</text>
          <text class="sw-box-text">{{weaknessesShort}}</text>
        </view>
      </view>
      <view wx:else class="profile-empty">
        <text wx:if="{{plan.basedOnGames == 0}}" class="profile-empty-text">暂无对局数据，完成几局人机对弈后将生成您的专属棋手档案</text>
        <text wx:else class="profile-empty-text">棋手档案尚未生成</text>
        <view wx:if="{{plan.basedOnGames > 0}}" class="btn-small-indigo" catchtap="onGoProfile">去生成棋手档案 →</view>
      </view>
    </view>

    <!-- ===== 训练统计 + 激励 ===== -->
    <view wx:if="{{stats}}" class="stats-grid">
      <view class="stats-card-item">
        <view class="stats-card-header">
          <text class="stats-card-label">等级</text>
          <text class="stats-card-emoji">⭐</text>
        </view>
        <text class="stats-card-value blue">Lv.{{stats.level}}</text>
        <view class="xp-bar-wrap">
          <view class="xp-bar-bg">
            <view class="xp-bar-fill" style="width: {{xpPct}}%"></view>
          </view>
          <text class="xp-text">{{stats.xp}} XP · 还需 {{stats.xpToNextLevel}} XP</text>
        </view>
      </view>
      <view class="stats-card-item">
        <view class="stats-card-header">
          <text class="stats-card-label">连续打卡</text>
          <text class="stats-card-emoji">🔥</text>
        </view>
        <text class="stats-card-value orange">{{stats.currentStreak}} 天</text>
        <text class="stats-card-hint">{{stats.currentStreak > 0 ? '再坚持 ' + (7 - stats.currentStreak) + ' 天可解锁成就' : '今日开始训练，开启连续打卡'}}</text>
        <view class="streak-bar">
          <view class="streak-dot {{i < stats.currentStreak ? 'streak-active' : ''}}" wx:for="{{7}}" wx:key="*this"></view>
        </view>
      </view>
      <view class="stats-card-item">
        <view class="stats-card-header">
          <text class="stats-card-label">今日进度</text>
          <text class="stats-card-emoji">✅</text>
        </view>
        <text class="stats-card-value green">{{stats.todayCompleted}}/{{stats.todayTarget}}</text>
        <view class="xp-bar-bg">
          <view class="xp-bar-fill green-fill" style="width: {{todayPct}}%"></view>
        </view>
        <text class="stats-card-hint">{{stats.todayTarget > 0 ? (stats.todayCompleted >= stats.todayTarget ? '🎉 今日目标已完成！' : '还需 ' + (stats.todayTarget - stats.todayCompleted) + ' 题') : '今日暂无目标'}}</text>
      </view>
      <view class="stats-card-item">
        <view class="stats-card-header">
          <text class="stats-card-label">成就</text>
          <text class="stats-card-emoji">🏆</text>
        </view>
        <text class="stats-card-value purple">{{unlockedCount}}/{{stats.achievements.length}}</text>
        <text class="stats-card-hint">{{achievementsHint}}</text>
        <view class="achievement-preview">
          <view class="ach-preview-item {{a.unlocked ? '' : 'ach-locked'}}" wx:for="{{achievementsPreview}}" wx:key="code" title="{{a.unlocked ? a.name : a.condition}}">
            <text>{{a.unlocked ? a.icon : '🔒'}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 激励横幅 -->
    <view wx:if="{{stats && plan}}" class="motivation-banner {{motivationBanner.color}}">
      <text class="mb-icon">{{motivationBanner.icon}}</text>
      <text class="mb-text">{{motivationBanner.text}}</text>
    </view>

    <!-- ===== 加载/错误状态 ===== -->
    <view wx:if="{{loadingPlan}}" class="loading-state">正在生成训练计划...</view>
    <view wx:if="{{profileError}}" class="error-state">{{profileError}}</view>

    <!-- ===== 训练计划内容 ===== -->
    <view wx:if="{{plan && !loadingPlan}}" class="plan-content">

      <!-- 人机对局难度推荐 -->
      <view class="section-card">
        <view class="section-header">
          <text class="section-title">🤖 人机对局难度推荐</text>
          <view class="btn-small-green" catchtap="onGoGame">开始对弈 →</view>
        </view>
        <view class="difficulty-row">
          <view class="diff-badge">
            <text class="diff-num">{{plan.gameDifficulty.recommended}}</text>
            <text class="diff-label">推荐难度</text>
          </view>
          <view class="diff-info">
            <text class="diff-range">建议区间：{{plan.gameDifficulty.min}} - {{plan.gameDifficulty.max}} 级</text>
            <text class="diff-elo">对应 Elo：{{plan.gameDifficulty.eloRange[0]}} - {{plan.gameDifficulty.eloRange[1]}}</text>
            <text wx:if="{{plan.gameDifficulty.maxAllowed < 10}}" class="diff-warn">⚠️ 当前会员等级最高支持难度 {{plan.gameDifficulty.maxAllowed}} 级</text>
          </view>
        </view>
        <text wx:if="{{plan.gameDifficulty.reason}}" class="diff-reason">{{plan.gameDifficulty.reason}}</text>
      </view>

      <!-- 习题训练计划 -->
      <view wx:if="{{plan.puzzlePlan && plan.puzzlePlan.length > 0}}">
        <text class="section-title">🧩 习题训练计划
          <text class="section-title-sub">（共 {{plan.puzzlePlan.length}} 项 · 每日 {{getTotalDaily(plan.puzzlePlan)}} 题）</text>
        </text>
        <view class="plan-item" wx:for="{{plan.puzzlePlan}}" wx:for-item="item" wx:key="id">
          <view class="plan-item-header">
            <view class="plan-item-num">{{index + 1}}</view>
            <view class="plan-item-info">
              <view class="plan-item-title-row">
                <text class="plan-item-title">{{item.title}}</text>
                <text class="plan-item-tag {{getSourceTag(item.source).cls}}">{{getSourceTag(item.source).label}}</text>
                <text wx:if="{{item.phase}}" class="plan-item-phase">{{getPhaseLabel(item.phase)}}</text>
              </view>
              <text class="plan-item-reason">{{item.reason}}</text>
            </view>
          </view>
          <view class="plan-item-meta">
            <text>难度 {{item.minDifficulty}} - {{item.maxDifficulty}} Elo</text>
            <text>每日 {{item.dailyCount}} 题</text>
          </view>
          <view class="btn-small-blue" catchtap="onJumpPuzzles" data-phase="{{item.phase}}" data-themes="{{item.themes}}" data-min="{{item.minDifficulty}}" data-max="{{item.maxDifficulty}}">开始练习 →</view>
        </view>
      </view>

      <!-- 弱点追踪 -->
      <view wx:if="{{mistakeSummary && mistakeSummary.activeCount > 0}}" class="section-card warn-border">
        <text class="section-title">🎯 弱点追踪
          <text class="section-title-sub">（{{mistakeSummary.activeCount}} 个活跃 · {{mistakeSummary.solvedCount}} 个已解决）</text>
        </text>
        <view class="mistake-item" wx:for="{{recentMistakesPreview}}" wx:for-item="m" wx:key="id">
          <text class="mi-icon">{{m.classification == 'blunder' ? '💥' : '❌'}}</text>
          <view class="mi-info">
            <text class="mi-theme">{{m.inferredTheme || '战术'}} · {{m.phase || '全局'}} · 亏损 {{m.lossFixed}} 兵</text>
            <text class="mi-meta">{{m.classification == 'blunder' ? '大错' : '失误'}} · 第 {{m.moveIndex + 1}} 步</text>
          </view>
          <text class="mi-status {{m.isActive ? 'mi-tracking' : 'mi-solved'}}">{{m.isActive ? '追踪中' : '已解决'}}</text>
        </view>
        <view class="mistake-action">
          <view class="btn-small-amber" catchtap="onGoPuzzles">🎯 针对性做题 →</view>
          <text class="mistake-action-hint">AI 教练会在相近局面刻意考察这些弱点</text>
        </view>
      </view>

      <!-- 成就墙 -->
      <view wx:if="{{stats && stats.achievements.length > 0}}" class="section-card">
        <text class="section-title">🏆 成就墙
          <text class="section-title-sub">（{{unlockedCount}}/{{stats.achievements.length}} 已解锁）</text>
        </text>
        <view class="achievement-grid">
          <view class="ach-item {{a.unlocked ? 'ach-unlocked' : 'ach-locked-full'}}" wx:for="{{stats.achievements}}" wx:for-item="a" wx:key="code" title="{{a.unlocked ? a.name + ': ' + a.description : '未解锁 - ' + a.condition}}">
            <view class="ach-icon-wrap {{a.unlocked ? 'ach-icon-glow' : ''}}">
              <text class="ach-icon">{{a.unlocked ? a.icon : '🔒'}}</text>
            </view>
            <text class="ach-name">{{a.name}}</text>
            <text wx:if="{{a.unlocked && a.unlockedAt}}" class="ach-date">{{a.unlockedAtShort}}</text>
          </view>
        </view>
      </view>

      <!-- 快捷跳转 -->
      <view class="quick-actions">
        <view class="quick-btn" catchtap="onGoPuzzles">🧩 去刷题</view>
        <view class="quick-btn" catchtap="onGoGame">♟ 去对弈</view>
        <view class="quick-btn" catchtap="onGoProfile">📊 棋手档案</view>
      </view>
    </view>

    <!-- 初始占位 -->
    <view wx:if="{{!plan && !loadingPlan && !profileError}}" class="loading-state">
      <text>暂无训练数据，先去下几局棋吧</text>
    </view>

  </scroll-view>
</view>