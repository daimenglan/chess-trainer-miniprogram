.study-page {
  height: 100vh;
  background: var(--bg-primary);
}

.page-scroll {
  height: 100%;
  padding: 0 16rpx 40rpx;
}

.page-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin: 20rpx 0;
}

.list-loading, .list-empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: 24rpx;
  color: var(--text-muted);
}

.empty-icon { font-size: 60rpx; display: block; margin-bottom: 16rpx; }

.list-empty-hint {
  display: block;
  margin: 8rpx 0 20rpx;
  font-size: 22rpx;
  opacity: 0.75;
}

/* 搜索 */
.search-bar {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.search-input {
  flex: 1;
  padding: 12rpx 16rpx;
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  border-radius: 8rpx;
  color: var(--text-primary);
  font-size: 22rpx;
}

.search-eco {
  width: 120rpx;
  flex: none;
}

.search-btn {
  padding: 12rpx 24rpx;
  background: var(--accent-gradient);
  color: #fff;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

/* 卡片 */
.record-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.record-info {
  margin-bottom: 12rpx;
}

.record-players {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.player-name {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.vs-text {
  font-size: 20rpx;
  color: var(--text-muted);
}

.record-meta {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 4rpx;
}

.record-result {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: var(--bg-card-hover);
  color: var(--text-secondary);
}

.record-eco {
  font-size: 20rpx;
  color: var(--accent);
  font-weight: 600;
  font-family: monospace;
}

.record-date {
  font-size: 20rpx;
  color: var(--text-muted);
}

.record-event {
  font-size: 20rpx;
  color: var(--text-muted);
  display: block;
}

.record-actions {
  display: flex;
  gap: 8rpx;
}

.action-btn {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  background: var(--bg-card-hover);
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
}

/* 视频下载 */
.video-download {
  margin-top: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 20rpx;
  color: var(--purple);
  background: var(--purple-bg);
  border-radius: 8rpx;
  text-align: center;
}

/* 分页 */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 0;
}

.page-btn {
  padding: 10rpx 24rpx;
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.page-disabled {
  opacity: 0.3;
}

.page-info {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 视频弹窗 */
.video-modal {
  width: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  text-align: center;
}

.video-generating, .video-done {
  text-align: center;
  font-size: 24rpx;
  color: var(--success);
}

.video-task-id {
  display: block;
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.video-actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.video-actions .btn-primary,
.video-actions .btn-secondary {
  flex: 1;
}

.video-download-bar {
  padding: 12rpx 16rpx;
  background: var(--purple-bg);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin: 16rpx 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.download-link {
  color: var(--purple);
  text-decoration: underline;
}