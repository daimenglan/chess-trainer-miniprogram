.page {
  background: var(--bg-page, #0f0f23);
  color: var(--text-primary, #e8e8f0);
  min-height: 100vh;
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--bg-card, #1a1a2e);
  border-bottom: 1rpx solid var(--border-color, #2a2a4a);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: var(--bg-hover, #252545);
  margin-right: 24rpx;
}

.nav-back-icon { font-size: 32rpx; color: var(--text-primary, #e8e8f0); }
.nav-back-text { font-size: 26rpx; color: var(--text-primary, #e8e8f0); }
.nav-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); flex: 1; }

.nav-invite {
  padding: 12rpx 22rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #6c63ff, #8b8bff);
}
.nav-invite text { font-size: 24rpx; color: #fff; font-weight: 600; }

.scroll-content { padding: 24rpx 32rpx; height: calc(100vh - 100rpx); }

.search-section { margin-bottom: 24rpx; }

.search-input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--bg-input, #15152a);
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
  color: var(--text-primary, #e8e8f0);
  font-size: 28rpx;
}

.placeholder { color: var(--text-muted, #666); }

.search-results {
  margin-top: 12rpx;
  background: var(--bg-card, #1a1a2e);
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
  overflow: hidden;
}

.search-item {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--border-color, #2a2a4a);
}

.search-item:last-child { border-bottom: none; }

.search-info { flex: 1; display: flex; flex-direction: column; }
.search-name { font-size: 26rpx; color: var(--text-primary, #e8e8f0); }
.search-meta { font-size: 22rpx; color: var(--text-muted, #666); margin-top: 4rpx; }

.add-btn {
  min-width: 96rpx;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #6c63ff, #8b8bff);
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn text { font-size: 22rpx; color: #fff; font-weight: 600; }

.add-btn-disabled {
  background: transparent;
  border: 1rpx solid var(--border-color, #2a2a4a);
}
.add-btn-disabled text { color: var(--text-muted, #666); font-weight: 400; }

.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: var(--bg-card, #1a1a2e);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary, #a0a0c0);
  border: 1rpx solid var(--border-color, #2a2a4a);
}

.tab.active {
  background: linear-gradient(135deg, #6c63ff, #8b8bff);
  color: #fff;
  font-weight: 600;
}

.tab-content { min-height: 400rpx; }

.friend-list, .request-list { display: flex; flex-direction: column; gap: 16rpx; }

.friend-item, .request-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--bg-card, #1a1a2e);
  border-radius: 16rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
}

.friend-avatar, .request-avatar {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6c63ff, #8b8bff);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.friend-avatar.online { box-shadow: 0 0 0 3rpx rgba(74, 222, 128, 0.4); }

/* 在线小绿点贴在头像右下角 */
.online-dot {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #666;
  border: 3rpx solid var(--bg-card, #1a1a2e);
}
.online-dot.on { background: #4ade80; }

.avatar-text { font-size: 28rpx; color: #fff; font-weight: 700; }

.friend-info, .request-info { flex: 1; display: flex; flex-direction: column; min-width: 0; }

.friend-name, .request-name { font-size: 26rpx; font-weight: 600; color: var(--text-primary, #e8e8f0); }
.friend-status { font-size: 22rpx; color: var(--text-muted, #888); margin-top: 4rpx; }
.friend-status.on { color: #4ade80; }
.request-msg { font-size: 22rpx; color: var(--text-secondary, #a0a0c0); margin-top: 4rpx; }

.friend-actions, .request-actions { display: flex; gap: 12rpx; flex-shrink: 0; }

.action-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 复合选择器：class="action-btn chat" 是同一元素上的两个类，
   写成 `.action-btn chat`（后代）永远匹配不到 */
.action-btn.fight { background: rgba(250, 204, 21, 0.15); }
.action-btn.fight text { font-size: 24rpx; }
.action-btn.chat { background: rgba(108, 99, 255, 0.15); }
.action-btn.chat text { font-size: 24rpx; }
.action-btn.del { background: rgba(239, 68, 68, 0.15); }
.action-btn.del text { font-size: 24rpx; }
.action-btn.accept { background: rgba(34, 197, 94, 0.15); }
.action-btn.accept text { font-size: 26rpx; color: #22c55e; }
.action-btn.reject { background: rgba(239, 68, 68, 0.15); }
.action-btn.reject text { font-size: 26rpx; color: #ef4444; }

.empty-tip { text-align: center; padding: 60rpx 32rpx; }
.empty-tip text { font-size: 24rpx; color: var(--text-muted, #666); }

.loading-tip { text-align: center; padding: 40rpx 32rpx; }
.loading-tip text { font-size: 24rpx; color: var(--text-muted, #666); }

/* ===== 通用弹窗骨架（页面级 wxss 不跨页共享，故在本页重复一份） ===== */
.confirm-overlay {
  position: fixed;
  inset: 0;
  background: var(--bg-overlay, rgba(0, 0, 0, 0.6));
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.confirm-dialog {
  background: var(--bg-glass, rgba(26, 26, 46, 0.95));
  border: 1rpx solid rgba(108, 99, 255, 0.5);
  border-radius: 24rpx;
  padding: 40rpx;
  width: 88%;
  max-width: 600rpx;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
}

.confirm-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); }

.confirm-actions { display: flex; gap: 20rpx; width: 100%; margin-top: 8rpx; }

.confirm-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #6c63ff, #8b8bff);
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.confirm-btn-no {
  background: transparent;
  border: 1rpx solid var(--border-color, #2a2a4a);
  color: var(--text-secondary, #a0a0c0);
}

/* ===== 邀请面板 ===== */
.invite-panel { gap: 18rpx; }

.invite-panel-title { font-size: 34rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); }
.invite-panel-desc {
  font-size: 23rpx;
  color: var(--text-secondary, #a0a0c0);
  text-align: center;
  line-height: 1.5;
}

.preset-label {
  align-self: flex-start;
  font-size: 24rpx;
  color: var(--text-muted, #888);
}

.preset-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  width: 100%;
}

.preset-chip {
  flex: 1 0 28%;
  text-align: center;
  padding: 16rpx 8rpx;
  border-radius: 12rpx;
  background: var(--bg-input, #15152a);
  border: 1rpx solid var(--border-color, #2a2a4a);
  font-size: 24rpx;
  color: var(--text-secondary, #a0a0c0);
}
.preset-chip.on {
  background: linear-gradient(135deg, #6c63ff, #8b8bff);
  border-color: transparent;
  color: #fff;
  font-weight: 600;
}

.invite-generate { width: 100%; }

.invite-primary {
  text-align: center;
  padding: 22rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #6c63ff, #8b8bff);
}
.invite-primary text { font-size: 28rpx; color: #fff; font-weight: 600; }
.invite-primary.disabled { opacity: 0.6; }

/* 小程序码：白底保证在深色主题下也能被扫到 */
.invite-qr {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.invite-qr-img {
  width: 320rpx;
  height: 320rpx;
  border-radius: 16rpx;
  background: #fff;
  padding: 12rpx;
}
.invite-qr-hint { font-size: 22rpx; color: var(--text-muted, #888); text-align: center; }
.invite-qr-fallback {
  width: 100%;
  padding: 32rpx 20rpx;
  border-radius: 16rpx;
  background: var(--bg-input, #15152a);
  border: 1rpx dashed var(--border-color, #2a2a4a);
}
.invite-qr-fallback-icon { font-size: 48rpx; }

.invite-link-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: var(--bg-input, #15152a);
  border: 1rpx solid var(--border-color, #2a2a4a);
}
.invite-link-text {
  flex: 1;
  font-size: 22rpx;
  color: var(--accent, #6c63ff);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.invite-link-copy {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(108, 99, 255, 0.3);
}

.invite-link-error {
  width: 100%;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: var(--danger-bg, rgba(239, 68, 68, 0.15));
}
.invite-link-error text { font-size: 21rpx; color: #f87171; line-height: 1.4; }

.invite-text-preview {
  width: 100%;
  max-height: 220rpx;
  overflow: hidden;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: var(--bg-input, #15152a);
  border: 1rpx solid var(--border-color, #2a2a4a);
}
.invite-text-preview text {
  font-size: 21rpx;
  color: var(--text-secondary, #a0a0c0);
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-all;
}

.invite-actions { display: flex; gap: 16rpx; width: 100%; }

.invite-share-btn {
  flex: 1;
  margin: 0;
  padding: 20rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #6c63ff, #8b8bff);
  line-height: 1.3;
  border: none;
}
.invite-share-btn::after { border: none; }
.invite-share-btn text { font-size: 26rpx; color: #fff; font-weight: 600; }

.invite-copy-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 14rpx;
  background: transparent;
  border: 1rpx solid var(--border-color, #2a2a4a);
}
.invite-copy-btn text { font-size: 26rpx; color: var(--text-secondary, #a0a0c0); }

.invite-expire { font-size: 20rpx; color: var(--text-dim, #555577); text-align: center; }

.invite-close { padding: 12rpx 32rpx; }
.invite-close text { font-size: 25rpx; color: var(--text-muted, #888); }

/* ===== 收到挑战弹窗 ===== */
.invite-dialog { gap: 16rpx; }

.invite-emoji { font-size: 64rpx; }
.invite-desc { font-size: 27rpx; color: var(--text-secondary, #a0a0c0); text-align: center; }
.invite-username { font-size: 27rpx; font-weight: 700; color: var(--accent, #6c63ff); }

.invite-detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: var(--bg-input, #15152a);
}
.invite-detail-label { font-size: 24rpx; color: var(--text-muted, #888); }
.invite-detail-value { font-size: 25rpx; color: var(--text-primary, #e8e8f0); font-weight: 600; }
