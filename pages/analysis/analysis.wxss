.analysis-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-primary);
  overflow: hidden;
}

/* ===== 竖屏模式：顶部导航（同网页版 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm） ===== */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 88rpx 12rpx 16rpx;
  background: var(--bg-glass);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-color);
  flex-shrink: 0;
  gap: 8rpx;
  flex-wrap: wrap;
  position: relative;
  overflow: visible;
  z-index: 1000;
}

/* ===== 竖屏模式：棋盘区域自适应（同网页版 flex-1 min-h-0） ===== */
.board-area {
  flex: 1 1 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 2rpx 0;
  min-height: 0;
  flex-shrink: 0;
}

/* ===== 竖屏模式：可滚动内容区域（同网页版 flex-1 overflow-y-auto） ===== */
.content-scroll {
  flex: 1 1 auto;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 0 16rpx 20rpx;
  min-height: 0;
}

/* ===== 竖屏模式：通用卡片（同网页版 glass rounded-xl） ===== */
.section-card {
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.top-bar-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.top-bar-right { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; }
.back-btn { padding: 8rpx 18rpx; font-size: 26rpx; color: var(--accent); font-weight: 600; }
.mode-badge { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx; background: var(--info-bg); color: var(--info); font-weight: 500; }

.player-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-primary);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
}
.player-dot-white { width: 18rpx; height: 18rpx; border-radius: 50%; background: #fff; border: 1px solid var(--border-color-strong); flex-shrink: 0; }
.player-dot-black { width: 18rpx; height: 18rpx; border-radius: 50%; background: #222; border: 1px solid var(--border-color-strong); flex-shrink: 0; }
.vs-text { font-size: 22rpx; color: var(--text-muted); font-weight: 500; }
.result-tag { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 6rpx; background: var(--bg-card-hover); color: var(--text-muted); }

.top-btn { padding: 8rpx 16rpx; font-size: 24rpx; border-radius: 10rpx; background: var(--bg-card-hover); color: var(--text-secondary); border: 1px solid var(--border-color); white-space: nowrap; }
.top-btn-blue { background: var(--info-bg); color: var(--info); border-color: rgba(59, 130, 246, 0.2); }
.top-btn-amber { background: var(--warning-bg); color: var(--warning); border-color: rgba(251, 191, 36, 0.2); }
.top-btn-purple { background: var(--purple-bg); color: var(--purple); border-color: rgba(139, 92, 246, 0.2); }
.top-btn-gradient { background: var(--accent-gradient); color: #fff; border: none; }

/* ===== 右上角下拉菜单 ===== */
.more-btn {
  position: absolute;
  right: 16px;
  top: 12px;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  z-index: 10;
}

.more-btn:active {
  background: var(--accent-border);
}

.more-icon {
  font-size: 36rpx;
  color: var(--text-secondary);
  line-height: 1;
}

.more-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  background: transparent;
}

.more-dropdown {
  position: absolute;
  top: 88rpx;
  right: 16rpx;
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 16rpx;
  width: 320rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.6);
  z-index: 100;
  overflow: hidden;
}

.more-item {
  padding: 26rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  background: var(--bg-secondary);
}

.more-item:last-of-type {
  border-bottom: none;
}

.more-item:active {
  background: var(--accent-border);
}

.more-item-active {
  color: var(--accent);
  background: var(--accent-bg);
}

.more-item-disabled {
  color: var(--text-placeholder);
  opacity: 0.5;
}

/* ===== 对局信息 ===== */
.game-summary { text-align: center; padding: 12rpx; flex-shrink: 0; }
.summary-players { font-size: 32rpx; font-weight: 600; color: var(--text-primary); display: block; }
.summary-result { font-size: 28rpx; color: var(--text-muted); }

/* ===== 棋盘点位走势图（棋盘上方，复盘完成后显示） ===== */
.chart-section-top {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  margin: 0 0 4rpx 0;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.eval-chart-top {
  width: 100%;
  height: 160rpx;
}
.chart-placeholder-top {
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-muted);
}
.text-warn {
  color: var(--warning);
}

/* ===== 折叠/展开条（分析线、推荐走法、局面分析面板） ===== */
.collapse-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 6rpx 4rpx 8rpx;
}

.collapse-bar:active {
  opacity: 0.7;
}

/* 与上一段内容之间的分隔线 */
.collapse-bar-divided {
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  margin-top: 4rpx;
  padding-top: 12rpx;
}

/* 卡片内首行的折叠条：标题与 section-title 保持一致 */
.collapse-bar-flush {
  padding: 0 4rpx 6rpx;
}

.collapse-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.collapse-bar-flush .collapse-title {
  font-size: 28rpx;
  color: var(--text-muted);
}

.collapse-hint {
  flex: 1;
  font-size: 20rpx;
  color: var(--text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 手动推演：局面分析标题右侧的「比推演前赚亏」标记 */
.explore-delta {
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-left: 6rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.06);
}

.collapse-icon {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--text-placeholder);
  flex-shrink: 0;
}

/* 折叠后隐藏内容但保留组件实例（避免 analysis-panel 状态丢失） */
.collapse-hidden {
  display: none;
}

/* ===== 分阶段高亮摘要 ===== */
.phase-summary {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 0 4rpx 4rpx;
}
.phase-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
}
.phase-dot {
  font-size: 16rpx;
  width: 20rpx;
  text-align: center;
}
.phase-label {
  font-size: 22rpx;
  color: var(--text-muted);
  min-width: 3em;
  font-weight: 600;
}
.phase-moves {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  flex: 1;
}
.phase-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 500;
}
.phase-tag-best {
  background: rgba(74, 222, 128, 0.12);
  color: #4ade80;
}
.phase-tag-worst {
  background: rgba(248, 113, 113, 0.12);
  color: #f87171;
}
.phase-tag-turn {
  background: rgba(250, 204, 21, 0.12);
  color: #facc15;
}

/* ===== 棋盘区域（关键：不在 scroll-view 内！）===== */
.board-area {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 2rpx 0;
  max-height: 75vh;
  flex-shrink: 0;
}

.board-area chess-board {
  width: 100%;
}

/* ===== 导航控制 ===== */
.nav-controls {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 0;
  flex-shrink: 0;
}

.nav-btn { padding: 14rpx 28rpx; background: var(--bg-card-hover); border: 1px solid var(--border-color); border-radius: 12rpx; font-size: 30rpx; color: var(--text-secondary); }
.nav-disabled { opacity: 0.3; }
.replay-info { font-size: 26rpx; color: var(--text-muted); font-weight: 600; min-width: 100rpx; text-align: center; }

/* ===== 推演/重演导航 ===== */
.explore-bar { display: flex; align-items: center; gap: 14rpx; padding: 14rpx 20rpx; margin: 8rpx 16rpx; flex-shrink: 0; }
.explore-nav { display: flex; align-items: center; gap: 12rpx; }
.nav-arrow { padding: 10rpx 20rpx; font-size: 28rpx; border-radius: 10rpx; background: var(--bg-card-hover); color: var(--text-secondary); border: 1px solid var(--border-color); }
.explore-step { font-size: 26rpx; color: var(--text-muted); font-weight: 600; min-width: 100rpx; text-align: center; }
.explore-exit { font-size: 26rpx; color: var(--danger); margin-left: auto; padding: 8rpx 18rpx; }
.explore-mode-label { font-size: 28rpx; color: var(--accent); font-weight: 600; padding: 0 16rpx; }
.explore-pause-btn, .explore-play-btn { padding: 10rpx 20rpx; font-size: 28rpx; border-radius: 10rpx; background: var(--accent-bg); color: var(--accent); border: 1px solid var(--accent-border); cursor: pointer; }
.explore-hidden { display: none; }

/* ===== 可滚动内容（面板+复盘+棋谱，棋盘不在内）===== */
.content-scroll {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 0 16rpx 20rpx;
}

/* ===== 通用卡片 ===== */
.section-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.section-title { font-size: 28rpx; font-weight: 700; color: var(--text-muted); display: block; margin-bottom: 12rpx; }

/* ===== 优劣势走势图 ===== */
.chart-container { height: 220rpx; }
.eval-chart { width: 100%; height: 100%; }
.chart-placeholder { text-align: center; padding: 40rpx; font-size: 26rpx; color: var(--text-muted); }

/* ===== 复盘总结 ===== */
.summary-grid { display: flex; justify-content: space-around; }
.summary-cell { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.sum-val { font-size: 36rpx; font-weight: 800; }
.sum-lbl { font-size: 22rpx; color: var(--text-muted); }

.review-progress { text-align: center; }
.progress-bar-bg { height: 12rpx; background: rgba(255,255,255,0.1); border-radius: 6rpx; overflow: hidden; margin-bottom: 6rpx; }
.progress-bar-fill { height: 100%; background: linear-gradient(90deg, var(--accent), var(--purple)); border-radius: 6rpx; transition: width 0.3s; }
.progress-text { font-size: 24rpx; color: var(--text-muted); }

/* ===== 复盘列表 ===== */
.review-item { padding: 14rpx 16rpx; border-bottom: 1rpx solid var(--border-color-light); display: flex; align-items: center; gap: 12rpx; }
.review-item-active { background: var(--accent-bg); border-radius: 10rpx; }
.review-icon { font-size: 28rpx; }
.review-move-num { font-size: 24rpx; color: var(--text-muted); min-width: 50rpx; }
.review-san { font-size: 26rpx; color: var(--text-secondary); font-weight: 600; flex: 1; }
.review-best { font-size: 22rpx; color: var(--purple); }
.text-green { color: var(--success); }
.text-blue { color: var(--info); }
.text-yellow { color: var(--warning); }
.text-orange { color: var(--danger); }
.text-red { color: var(--danger); }

/* ===== 走法详情 ===== */
.detail-panel { background: var(--bg-card); border: 1px solid var(--accent-border); border-radius: 16rpx; padding: 20rpx; margin-bottom: 16rpx; }
.detail-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14rpx; }
.detail-title { font-size: 30rpx; font-weight: 700; color: var(--text-primary); }
.detail-class { font-size: 24rpx; font-weight: 600; margin-left: 10rpx; }
.detail-close { font-size: 30rpx; color: var(--text-muted); padding: 8rpx 14rpx; }
.score-compare { display: flex; gap: 16rpx; margin-bottom: 14rpx; }
.score-box { flex: 1; background: var(--bg-card); border-radius: 12rpx; padding: 14rpx; text-align: center; border: 1px solid var(--border-color-light); }
.score-box-label { font-size: 22rpx; color: var(--text-muted); display: block; margin-bottom: 6rpx; }
.score-box-val { font-size: 36rpx; font-weight: 800; font-family: monospace; }
.score-positive { color: var(--success); }
.score-negative { color: var(--danger); }
.detail-section { margin-bottom: 12rpx; }
.section-label-warn { font-size: 24rpx; font-weight: 600; color: var(--danger); display: block; margin-bottom: 6rpx; }
.section-label-success { font-size: 24rpx; font-weight: 600; color: var(--success); display: block; margin-bottom: 6rpx; }
.detail-item { display: block; font-size: 26rpx; color: var(--text-secondary); margin-bottom: 6rpx; line-height: 1.5; }
.detail-tactics { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 10rpx; }
.tactic-tag { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 10rpx; background: var(--info-bg); color: var(--info); }
.detail-recommend { margin-bottom: 14rpx; }
.recommend-label { font-size: 26rpx; color: var(--purple); font-weight: 600; font-family: monospace; }

/* ===== AI 分析弹窗 ===== */
.ai-analysis-modal { width: 640rpx; max-width: 92vw; max-height: 75vh; display: flex; flex-direction: column; background: var(--bg-glass); }
.modal-header { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; border-bottom: 1px solid var(--border-color); }
.modal-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary); }
.modal-close { font-size: 32rpx; color: var(--text-muted); padding: 8rpx 14rpx; }
.modal-body { flex: 1; overflow-y: auto; padding: 24rpx; }
.modal-loading { display: block; font-size: 28rpx; color: var(--text-muted); text-align: center; }
.modal-text { font-size: 28rpx; color: var(--text-secondary); line-height: 1.7; white-space: pre-wrap; }

/* ===== 视频生成弹窗 ===== */
.video-modal { width: 560rpx; display: flex; flex-direction: column; align-items: center; gap: 24rpx; padding: 48rpx; }
.modal-desc { font-size: 28rpx; color: var(--text-muted); text-align: center; }
.video-generating { text-align: center; font-size: 30rpx; color: var(--success); }
.video-actions { display: flex; gap: 20rpx; width: 100%; }
.video-actions .btn-primary, .video-actions .btn-secondary { flex: 1; }

/* ===== 分享弹窗 ===== */
.share-modal { width: 560rpx; display: flex; flex-direction: column; padding: 32rpx; }
.share-desc { font-size: 26rpx; color: var(--text-muted); text-align: center; margin-bottom: 20rpx; }
.share-link-box { background: var(--bg-card-hover); border: 1px solid var(--border-color); border-radius: 12rpx; padding: 20rpx; margin-bottom: 24rpx; }
.share-link-text { font-size: 24rpx; color: var(--text-secondary); word-break: break-all; text-align: center; display: block; }
.video-desc { font-size: 26rpx; color: var(--text-muted); text-align: center; margin-bottom: 20rpx; }
.video-status { font-size: 24rpx; color: var(--text-dim); display: block; margin-top: 12rpx; text-align: center; }
.btn-row { display: flex; justify-content: center; gap: 16rpx; }
.btn { padding: 20rpx 48rpx; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; }
.btn.primary { background: var(--accent-gradient, linear-gradient(135deg, #6c63ff, #4834d4)); }
.btn-text { font-size: 28rpx; color: #fff; font-weight: 600; }
/* ===== AI生成内容显著标识 ===== */
.modal-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ai-gen-flag {
  display: inline-flex;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #6c63ff, #4834d4);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
}

.ai-gen-notice {
  padding: 10rpx 24rpx;
  font-size: 20rpx;
  color: #8888aa;
  background: rgba(108, 99, 255, 0.08);
}

.detail-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

/* ===== AI 生成内容免责声明（页面常驻 / 行内） ===== */
/* 行内紧凑版：用于分析线折叠条下方、深度复盘抽屉顶部 */
.ai-disclaimer-inline {
  padding: 4rpx 4rpx 2rpx;
  text-align: center;
}

.ai-disclaimer-inline text {
  font-size: 19rpx;
  line-height: 1.5;
  color: var(--text-dim);
}

.deep-disclaimer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  flex-wrap: wrap;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
  border: 1px solid rgba(108, 99, 255, 0.25);
  border-radius: 10rpx;
  background: rgba(108, 99, 255, 0.08);
}

.deep-disclaimer .ai-gen-flag {
  flex-shrink: 0;
}

/* 顶栏常驻角标：紧跟“分析模式”徽章 */
.ai-gen-flag-top {
  flex-shrink: 0;
}

/* 未登录时分析线区域的引导文案 */
.chart-need-login {
  color: var(--text-secondary);
  font-size: 26rpx;
}

/* ===== 深度复盘抽屉（对齐网页版 DeepReviewPanel） ===== */
.deep-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 900;
}

.deep-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72%;
  z-index: 901;
  display: flex;
  flex-direction: column;
  background: rgba(26, 26, 46, 0.98);
  border-top: 1px solid var(--accent);
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.4);
  transform: translateY(101%);
  transition: transform 0.3s ease-out;
}

.deep-drawer-open {
  transform: translateY(0);
}

.deep-handle {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-bottom: 1px solid var(--border-color-light);
  border-radius: 24rpx 24rpx 0 0;
  background: linear-gradient(90deg, rgba(108, 99, 255, 0.16), rgba(72, 52, 212, 0.10));
}

.deep-handle-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--accent);
}

.deep-handle-hint {
  font-size: 22rpx;
  color: var(--text-muted);
}

.deep-body {
  flex: 1;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

/* 空状态 / 启动 */
.deep-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 20rpx;
  text-align: center;
}

.deep-empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.deep-empty-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.deep-start-btn {
  padding: 16rpx 40rpx;
  background: var(--accent-gradient);
  color: #fff;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
}

/* 进度 */
.deep-progress {
  padding: 12rpx 0 20rpx;
}

.deep-progress-bg {
  height: 12rpx;
  background: var(--bg-card-hover);
  border-radius: 6rpx;
  overflow: hidden;
}

.deep-progress-fill {
  height: 100%;
  background: var(--accent-gradient);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.deep-progress-text {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 12rpx;
}

.deep-llm-running {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  background: var(--accent-bg);
  font-size: 20rpx;
  color: var(--accent);
  margin-bottom: 16rpx;
}

.deep-spinner {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid var(--accent);
  border-top-color: transparent;
  border-radius: 50%;
  animation: deep-spin 0.8s linear infinite;
  flex-shrink: 0;
}

@keyframes deep-spin {
  to { transform: rotate(360deg); }
}

/* 错误 */
.deep-error, .deep-llm-failed {
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.deep-error {
  background: var(--danger-bg);
  color: var(--danger);
}

.deep-llm-failed {
  background: rgba(249, 115, 22, 0.14);
  color: var(--warning);
}

.deep-error-title {
  display: block;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.deep-retry-btn {
  margin-top: 12rpx;
  padding: 10rpx 24rpx;
  background: var(--accent-gradient);
  color: #fff;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 600;
  display: inline-block;
}

/* 整局总结 */
.deep-summary-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color-light);
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.deep-phase-card {
  border-color: var(--accent);
}

.deep-summary-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 12rpx;
}

.deep-summary-block {
  margin-bottom: 12rpx;
}

.deep-summary-label {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 4rpx;
}

.deep-label-good { color: var(--success); }
.deep-label-warn { color: var(--warning); }
.deep-label-info { color: var(--info); }

.deep-summary-text {
  display: block;
  font-size: 21rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.deep-phase-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.deep-phase-label {
  flex-shrink: 0;
  width: 64rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.deep-phase-opening { color: var(--accent); }
.deep-phase-mid { color: var(--info); }
.deep-phase-end { color: var(--success); }

.deep-phase-text {
  flex: 1;
  font-size: 21rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 统计 + 过滤 */
.deep-stats {
  display: flex;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.deep-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 4rpx;
  background: var(--bg-card);
  border: 1px solid var(--border-color-light);
  border-radius: 10rpx;
}

.deep-stat-val {
  font-size: 30rpx;
  font-weight: 700;
}

.deep-stat-lbl {
  font-size: 18rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.deep-stat-lbl-on {
  background: var(--accent);
  color: #fff;
}

.deep-c-best { color: var(--success); }
.deep-c-good { color: #22c55e; }
.deep-c-inacc { color: var(--warning); }
.deep-c-mistake { color: #fb923c; }
.deep-c-blunder { color: var(--danger); }

.deep-filter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.deep-filter-chip {
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  background: var(--bg-card-hover);
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
}

.deep-filter-chip-on {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}

.deep-count {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--text-dim);
}

/* 逐步卡片 */
.deep-move-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color-light);
  border-radius: 12rpx;
  margin-bottom: 10rpx;
  overflow: hidden;
}

.deep-move-active {
  border-color: var(--accent);
}

.deep-move-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx;
}

.deep-move-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.deep-move-num {
  font-size: 20rpx;
  color: var(--text-dim);
  flex-shrink: 0;
}

.deep-side-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.side-white {
  background: #fff;
  border: 1px solid #999;
}

.side-black {
  background: #1a1a1a;
  border: 1px solid #999;
}

.deep-move-san {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex-shrink: 0;
}

.deep-move-class {
  font-size: 19rpx;
  color: var(--text-muted);
}

.deep-move-score {
  margin-left: auto;
  font-size: 21rpx;
  font-family: monospace;
}

.deep-move-caret {
  font-size: 18rpx;
  color: var(--text-dim);
  flex-shrink: 0;
}

.deep-move-body {
  padding: 0 16rpx 16rpx;
  border-top: 1px solid var(--border-color-light);
  padding-top: 14rpx;
}

.deep-tag-row {
  margin-bottom: 10rpx;
}

.deep-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: var(--accent-bg);
  color: var(--accent);
  font-size: 19rpx;
}

.deep-commentary {
  display: block;
  font-size: 21rpx;
  color: var(--text-secondary);
  line-height: 1.65;
  margin-bottom: 12rpx;
}

.deep-best-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 14rpx;
  background: var(--bg-card-hover);
  border-radius: 10rpx;
  margin-bottom: 10rpx;
}

.deep-best-label {
  font-size: 19rpx;
  color: var(--text-dim);
}

.deep-best-move {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-primary);
  font-family: monospace;
}

.deep-best-score {
  margin-left: auto;
  font-size: 21rpx;
  color: var(--success);
  font-family: monospace;
}

.deep-block-warn, .deep-block-info {
  padding: 12rpx 14rpx;
  border-radius: 10rpx;
  margin-bottom: 10rpx;
}

.deep-block-warn { background: rgba(249, 115, 22, 0.12); }
.deep-block-info { background: rgba(59, 130, 246, 0.12); }

.deep-block-title {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.deep-block-warn .deep-block-title { color: var(--warning); }
.deep-block-info .deep-block-title { color: var(--info); }

.deep-block-text {
  display: block;
  font-size: 21rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.deep-goto-btn {
  margin-top: 8rpx;
  padding: 10rpx 0;
  text-align: center;
  background: var(--accent-bg);
  color: var(--accent);
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.deep-footer-row {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 0 40rpx;
}

.deep-footer-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: var(--bg-card-hover);
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
}

.deep-footer-danger {
  background: var(--danger-bg);
  color: var(--danger);
  border-color: transparent;
}
