<view class="analysis-page {{__theme__ ? 'theme-' + __theme__ : ''}}">
  <!-- 页面新手引导（同网页版 PageGuide） -->
  <page-guide
    storageKey="page_analysis"
    icon="🔍"
    title="分析模式"
    desc="在这里你可以回放对局、逐走复盘、查看引擎分析与走势"
    hint="复盘会自动开始，分析线与推荐走法直接标注在棋盘上"
  ></page-guide>

  <!-- 顶部导航 -->
  <view class="top-bar glass gradient-top">
    <view class="top-bar-left">
      <text class="mode-badge">🔍 分析模式</text>
      <text class="ai-gen-flag ai-gen-flag-top">AI生成</text>
      <block wx:if="{{game}}">
        <view class="player-tag"><text class="player-dot-white"></text><text>{{game.whiteName || game.white || '白方'}}</text></view>
        <text class="vs-text">VS</text>
        <view class="player-tag"><text class="player-dot-black"></text><text>{{game.blackName || game.black || '黑方'}}</text></view>
        <text wx:if="{{game.result}}" class="result-tag">{{game.result}}</text>
      </block>
    </view>
    <view class="top-bar-right">
      <!-- 右下角菜单遮罩 -->
      <view wx:if="{{showMoreMenu}}" class="more-mask" catchtap="onMoreTap"></view>
      <!-- 更多操作按钮 -->
      <view class="more-btn" catchtap="onMoreTap">
        <text class="more-icon">☰</text>
      </view>
      <!-- 下拉菜单 -->
      <view wx:if="{{showMoreMenu}}" class="more-dropdown">
        <!-- 复盘默认自动运行，此项用于查看分析线 / 失败后重试 -->
        <view class="more-item {{reviewLoading ? 'more-item-disabled' : ''}}" catchtap="onToggleReview">
          <text>{{reviewLoading ? '⏳ ' + reviewProgress + '%' : (moveReviewCount > 0 ? '📊 查看分析线' : (reviewError ? '🔄 重试复盘' : '🤖 复盘'))}}</text>
        </view>
        <view class="more-item {{explorationMode ? 'more-item-active' : ''}}" catchtap="onToggleExploration">
          <text>{{explorationMode ? '📝 退出推演' : '✏️ 推演'}}</text>
        </view>
        <view class="more-item {{deepOpen ? 'more-item-active' : ''}}" catchtap="onToggleDeepReview">
          <text>🧠 深度复盘</text>
        </view>
        <view class="more-item" catchtap="onShowAiAnalysis">
          <text>🤖 AI推荐</text>
        </view>
        <view class="more-item" catchtap="onShowShare">
          <text>📤 分享</text>
        </view>
        <view class="more-item" catchtap="onFlip">
          <text>🔄 翻转棋盘</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 优劣势走势图（复盘时显示在棋盘上方，点击数据点跳转到对应步；分析线与推荐走法均可折叠） -->
  <view wx:if="{{!showMoreMenu && (reviewLoading || reviewError || reviewNeedLogin || (reviewDone && chartData.length >= 2))}}" class="chart-section-top">
    <!-- 分析线：折叠头 -->
    <view class="collapse-bar" catchtap="onToggleChartLine">
      <text class="collapse-title">📈 分析线</text>
      <text wx:if="{{!chartLineExpanded && !reviewNeedLogin}}" class="collapse-hint">
        {{reviewLoading ? '分析中 ' + reviewProgress + '%' : (reviewError ? '加载失败' : chartData.length + ' 个局面点')}}
      </text>
      <text wx:if="{{!chartLineExpanded && reviewNeedLogin}}" class="collapse-hint">登录后可查看</text>
      <text wx:if="{{!reviewNeedLogin}}" class="collapse-icon">{{chartLineExpanded ? '收起 ▲' : '展开 ▼'}}</text>
    </view>
    <view class="ai-disclaimer-inline"><text>本服务为AI生成内容，结果仅供参考</text></view>
    <view wx:if="{{chartLineExpanded}}">
      <canvas wx:if="{{reviewDone && chartData.length >= 2}}" type="2d" id="evalChart" class="eval-chart-top" catchtap="onChartTap"></canvas>
      <view wx:elif="{{reviewNeedLogin}}" class="chart-placeholder-top">
        <text class="chart-need-login">🔒 登录后才能加载分析线</text>
      </view>
      <view wx:elif="{{reviewLoading}}" class="chart-placeholder-top">
        <text>⏳ 正在分析优劣势... {{reviewProgress > 0 ? reviewProgress + '%' : ''}}</text>
      </view>
      <view wx:else class="chart-placeholder-top">
        <text class="text-warn">⚠️ {{reviewErrorText || '分析加载失败'}}</text>
      </view>
    </view>

    <!-- 每一步的推荐走法（分阶段高亮摘要）：折叠头 -->
    <block wx:if="{{chartPhaseInfo.length > 0}}">
      <view class="collapse-bar collapse-bar-divided" catchtap="onTogglePhaseMoves">
        <text class="collapse-title">🎯 每阶段推荐走法</text>
        <text wx:if="{{!phaseMovesExpanded}}" class="collapse-hint">{{chartPhaseInfo.length}} 个阶段</text>
        <text class="collapse-icon">{{phaseMovesExpanded ? '收起 ▲' : '展开 ▼'}}</text>
      </view>
      <view wx:if="{{phaseMovesExpanded}}" class="phase-summary">
        <view class="phase-row" wx:for="{{chartPhaseInfo}}" wx:key="phaseLabel"
              wx:for-item="ph">
          <text class="phase-dot" style="color:{{ph.phaseColor}}">⬤</text>
          <text class="phase-label">{{ph.phaseLabel}}</text>
          <view class="phase-moves">
            <text class="phase-tag phase-tag-best" data-index="{{ph.best.index}}" catchtap="onPhaseMoveTap">
              ⭐{{ph.best.san}}
            </text>
            <text class="phase-tag phase-tag-worst" data-index="{{ph.worst.index}}" catchtap="onPhaseMoveTap">
              ❌{{ph.worst.san}}
            </text>
            <text wx:if="{{ph.turningPoint.index !== ph.best.index && ph.turningPoint.index !== ph.worst.index}}"
                  class="phase-tag phase-tag-turn" data-index="{{ph.turningPoint.index}}" catchtap="onPhaseMoveTap">
              ⚡{{ph.turningPoint.san}}
            </text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 棋盘 -->
  <view class="board-area">
    <chess-board id="analysisBoard"
      interactive="{{explorationMode ? true : false}}"
      flipped="{{flipped}}"
      fen="{{displayFen}}"
      isCheck="{{isCheck}}"
      isCheckmate="{{isCheckmate}}"
      isStalemate="{{isStalemate}}"
      boardColorPreset="wood"
      lastMoveFrom="{{lastMoveFrom}}"
      lastMoveTo="{{lastMoveTo}}"
      selectedSquare="{{selectedSquare}}"
      legalMoves="{{legalMoves}}"
      canvasHidden="{{showMoreMenu}}"
      labelVariant="inline"
      showHints="{{true}}"
      analysis="{{displayFen === analysisFen ? analysisCandidates : []}}"
      bind:squaretap="onExploreSquareTap"
      bind:scrolltocandidate="onBoardCandidateTap">
    </chess-board>
  </view>

  <!-- Rex 教练闲聊气泡（同网页版 CoachChatter） -->
  <coach-chatter
    fen="{{displayFen}}"
    moveHistory="{{moves}}"
    playerSide="{{playerSide}}"
    gameStarted="{{gameStarted}}"
    gameOver="{{gameOver}}"
    enabled="{{true}}"
  ></coach-chatter>

  <!-- 导航控制 -->
  <view class="nav-controls">
    <view class="nav-btn {{currentMoveIndex <= 0 ? 'nav-disabled' : ''}}" catchtap="goToStart">⏮</view>
    <view class="nav-btn {{currentMoveIndex <= 0 ? 'nav-disabled' : ''}}" catchtap="goToPrevious">◀</view>
    <text class="replay-info">{{currentMoveIndex + 1}} / {{totalMoves}}</text>
    <view class="nav-btn {{currentMoveIndex >= totalMoves - 1 ? 'nav-disabled' : ''}}" catchtap="goToNext">▶</view>
    <view class="nav-btn {{currentMoveIndex >= totalMoves - 1 ? 'nav-disabled' : ''}}" catchtap="goToEnd">⏭</view>
  </view>

  <!-- 推演模式状态栏 -->
  <view wx:if="{{explorationMode}}" class="explore-bar glass">
    <view class="explore-nav">
      <view class="nav-arrow {{exploreStepIndex <= 0 ? 'nav-disabled' : ''}}" catchtap="onExplorePrev">◀</view>
      <text class="explore-step">{{exploreStepIndex + 1}}/{{exploreSteps.length}}</text>
      <view class="nav-arrow {{exploreStepIndex >= exploreSteps.length - 1 ? 'nav-disabled' : ''}}" catchtap="onExploreNext">▶</view>
    </view>
    <text class="explore-mode-label">
      {{explorationMode === 'auto' ? '🤖 自动推演' : '📝 手动推演'}}
    </text>
    <view wx:if="{{explorationMode === 'auto'}}">
      <view class="explore-pause-btn {{exploreAutoRunning ? '' : 'explore-hidden'}}" catchtap="onStartAutoExploration">⏸</view>
      <view class="explore-play-btn {{exploreAutoPaused ? '' : 'explore-hidden'}}" catchtap="onStartAutoExploration">▶</view>
    </view>
    <text class="explore-exit" catchtap="onExitExploration">✕ 退出</text>
  </view>

  <!-- 可滚动内容区域（面板+复盘+详情+棋谱） -->
  <scroll-view class="content-scroll" scroll-y>
    <!-- 局面分析面板（评估条 + 当前步推荐走法，可折叠） -->
    <view class="section-card">
      <view class="collapse-bar collapse-bar-flush" catchtap="onToggleAnalysisPanel">
        <text class="collapse-title">🧭 局面分析</text>
        <!-- 手动推演：当前局面相对推演前的赚亏（正=赚 / 负=亏，己方视角） -->
        <text wx:if="{{exploreDeltaLabel}}" class="explore-delta" style="color: {{exploreDeltaColor}};">{{exploreDeltaLabel}}</text>
        <text wx:if="{{!panelExpanded}}" class="collapse-hint">
          {{analysisCandidates.length > 0 ? analysisCandidates.length + ' 条推荐走法' : '评估条与推荐走法'}}
        </text>
        <text class="collapse-icon">{{panelExpanded ? '收起 ▲' : '展开 ▼'}}</text>
      </view>
      <view class="{{panelExpanded ? '' : 'collapse-hidden'}}">
        <analysis-panel id="analysisPanel"
          gameStarted="{{true}}"
          fen="{{displayFen}}"
          analysis="{{analysisCandidates}}"
          openingName="{{openingName}}"
          openingNameCN="{{openingNameCN}}"
          ecoCode="{{ecoCode}}"
          showHints="{{true}}"
          playerSide="{{playerSide}}"
          bind:startexploration="onExplorationStart"
          bind:playcontinuation="onPlayContinuation"
          bind:autocontinuation="onAutoContinuation">
        </analysis-panel>
      </view>
    </view>

    <!-- 复盘总结 -->
    <view wx:if="{{summary}}" class="section-card">
      <text class="section-title">📊 复盘总结</text>
      <view class="summary-grid">
        <view class="summary-cell"><text class="sum-val" style="color:var(--success)">{{summary.best}}</text><text class="sum-lbl">最佳</text></view>
        <view class="summary-cell"><text class="sum-val" style="color:#22c55e">{{summary.good}}</text><text class="sum-lbl">好棋</text></view>
        <view class="summary-cell"><text class="sum-val" style="color:var(--warning)">{{summary.inaccuracy}}</text><text class="sum-lbl">缓着</text></view>
        <view class="summary-cell"><text class="sum-val" style="color:#fb923c">{{summary.mistake}}</text><text class="sum-lbl">失误</text></view>
        <view class="summary-cell"><text class="sum-val" style="color:var(--danger)">{{summary.blunder}}</text><text class="sum-lbl">大漏</text></view>
      </view>
    </view>

    <!-- 复盘进度 -->
    <view wx:if="{{reviewLoading}}" class="review-progress section-card">
      <view class="progress-bar-bg">
        <view class="progress-bar-fill" style="width: {{reviewProgress}}%"></view>
      </view>
      <text class="progress-text">分析中 {{reviewProgress}}%</text>
    </view>

    <!-- 复盘列表 -->
    <view wx:if="{{moveReviewList.length > 0}}" class="section-card">
      <text class="section-title">📋 复盘详情</text>
      <view class="review-item {{reviewDetailIndex === item.index ? 'review-item-active' : ''}}"
            wx:for="{{moveReviewList}}" wx:key="index"
            data-index="{{item.index}}" catchtap="onReviewItemTap">
        <text class="review-icon {{item.classColor}}">{{item.classIcon}}</text>
        <text class="review-move-num">#{{item.playerMoveNumber}}</text>
        <text class="review-san">{{item.san}}</text>
        <text wx:if="{{!item.isBest && item.bestUciShort}}" class="review-best">推荐 {{item.bestUciShort.from}}→{{item.bestUciShort.to}}</text>
      </view>
    </view>

    <!-- 走法详情面板 -->
    <view wx:if="{{reviewDetail}}" class="detail-panel">
      <view class="detail-header">
        <view class="detail-title-wrap">
          <text class="detail-title">
            第 {{reviewDetail.playerMoveNumber}} 手
          </text>
          <text class="detail-class {{reviewDetail.meta.color}}">{{reviewDetail.meta.icon}} {{reviewDetail.meta.label}}</text>
          <text class="ai-gen-flag">AI生成</text>
        </view>
        <text class="detail-close" catchtap="onCloseDetail">✕</text>
      </view>
      <view class="score-compare">
        <view class="score-box">
          <text class="score-box-label">实际走法</text>
          <text class="score-box-val {{reviewDetail.playedScore <= -0.5 ? 'score-negative' : 'score-positive'}}">{{reviewDetail.playedScoreFormatted}}</text>
        </view>
        <view class="score-box">
          <text class="score-box-label">推荐走法</text>
          <text class="score-box-val score-positive">{{reviewDetail.bestScoreFormatted}}</text>
        </view>
      </view>
      <view wx:if="{{!reviewDetail.isBest && reviewDetail.bestUciShort}}" class="detail-recommend">
        <text class="recommend-label">推荐: {{reviewDetail.bestUciShort.from}}→{{reviewDetail.bestUciShort.to}}</text>
      </view>
      <view wx:if="{{reviewDetail.cons.length > 0}}" class="detail-section">
        <text class="section-label-warn">⚠️ 问题</text>
        <text class="detail-item" wx:for="{{reviewDetail.cons}}" wx:for-item="c" wx:key="*this">• {{c}}</text>
      </view>
      <view wx:if="{{reviewDetail.pros.length > 0}}" class="detail-section">
        <text class="section-label-success">✅ 优势</text>
        <text class="detail-item" wx:for="{{reviewDetail.pros}}" wx:for-item="p" wx:key="*this">• {{p}}</text>
      </view>
      <view wx:if="{{reviewDetail.tactics.length > 0}}" class="detail-tactics">
        <text class="tactic-tag" wx:for="{{reviewDetail.tactics}}" wx:for-item="t" wx:key="*this">{{t}}</text>
      </view>
    </view>

    <!-- 棋谱历史：复盘时与棋盘上方的逐步导航重复，按需求不展示 -->

    <!-- AI生成内容免责声明 -->
    <view class="ai-disclaimer"><text>本服务为AI生成内容，结果仅供参考</text></view>
  </scroll-view>

  <!-- 深度复盘抽屉（引擎分析 + LLM 战略战术解析，对齐网页版 DeepReviewPanel） -->
  <view wx:if="{{deepOpen}}" class="deep-mask" catchtap="onCloseDeepReview"></view>
  <view class="deep-drawer {{deepOpen ? 'deep-drawer-open' : ''}}">
    <!-- 抽屉把手 -->
    <view class="deep-handle" catchtap="onCloseDeepReview">
      <text class="deep-handle-title">🧠 深度复盘</text>
      <text class="deep-handle-hint">收起 ▾</text>
    </view>

    <scroll-view class="deep-body" scroll-y>
      <!-- AI生成内容免责声明 -->
      <view class="ai-disclaimer-inline deep-disclaimer">
        <text class="ai-gen-flag">AI生成</text>
        <text>本服务为AI生成内容，结果仅供参考</text>
      </view>
      <!-- 未分析：启动入口 -->
      <view wx:if="{{deepResults.length === 0 && !deepLoading}}" class="deep-empty">
        <text class="deep-empty-icon">🧠</text>
        <text class="deep-empty-desc">对每步走法进行引擎分析 + LLM 战略战术深度解析</text>
        <view class="deep-start-btn" catchtap="onStartDeepReview">开始深度复盘</view>
      </view>

      <!-- 进度 -->
      <view wx:if="{{deepLoading}}" class="deep-progress">
        <view class="deep-progress-bg">
          <view class="deep-progress-fill" style="width: {{deepProgress}}%"></view>
        </view>
        <text class="deep-progress-text">
          {{deepProgress < 50 ? '引擎分析中 (' + deepProgress + '%)' : (deepProgress < 100 ? 'LLM 战略分析中 (' + deepProgress + '%)' : '分析完成')}}
        </text>
      </view>

      <!-- LLM 分析进行中（引擎已完成） -->
      <view wx:if="{{deepResults.length > 0 && deepLoading && deepProgress >= 50}}" class="deep-llm-running">
        <view class="deep-spinner"></view>
        <text>LLM 正在分析每一步的战略战术…</text>
      </view>

      <!-- 错误 -->
      <view wx:if="{{deepError}}" class="deep-error">
        <text class="deep-error-title">分析失败</text>
        <text>{{deepError}}</text>
        <view class="deep-retry-btn" catchtap="onStartDeepReview">重新分析</view>
      </view>

      <!-- LLM 战略分析失败（引擎结果仍有效） -->
      <view wx:if="{{!deepLoading && deepLlmFailed && deepResults.length > 0}}" class="deep-llm-failed">
        <text class="deep-error-title">⚠️ LLM 战略分析未生成</text>
        <text>{{deepLlmFailed}}</text>
        <view class="deep-retry-btn" catchtap="onClearDeepReview">清除后重新分析</view>
      </view>

      <!-- 整局总结 -->
      <block wx:if="{{deepSummary}}">
        <view wx:if="{{deepSummary.phaseSummary}}" class="deep-summary-card deep-phase-card">
          <text class="deep-summary-title">📋 三阶段总评</text>
          <view wx:if="{{deepSummary.phaseSummary.opening}}" class="deep-phase-row">
            <text class="deep-phase-label deep-phase-opening">开局</text>
            <text class="deep-phase-text">{{deepSummary.phaseSummary.opening}}</text>
          </view>
          <view wx:if="{{deepSummary.phaseSummary.middlegame}}" class="deep-phase-row">
            <text class="deep-phase-label deep-phase-mid">中局</text>
            <text class="deep-phase-text">{{deepSummary.phaseSummary.middlegame}}</text>
          </view>
          <view wx:if="{{deepSummary.phaseSummary.endgame}}" class="deep-phase-row">
            <text class="deep-phase-label deep-phase-end">残局</text>
            <text class="deep-phase-text">{{deepSummary.phaseSummary.endgame}}</text>
          </view>
        </view>
        <view class="deep-summary-card">
          <view wx:if="{{deepSummary.gameSummary}}" class="deep-summary-block">
            <text class="deep-summary-label">对局评价</text>
            <text class="deep-summary-text">{{deepSummary.gameSummary}}</text>
          </view>
          <view wx:if="{{deepSummary.keyTurningPoints}}" class="deep-summary-block">
            <text class="deep-summary-label">关键转折</text>
            <text class="deep-summary-text">{{deepSummary.keyTurningPoints}}</text>
          </view>
          <view wx:if="{{deepSummary.playerStrengths}}" class="deep-summary-block">
            <text class="deep-summary-label deep-label-good">优点</text>
            <text class="deep-summary-text">{{deepSummary.playerStrengths}}</text>
          </view>
          <view wx:if="{{deepSummary.playerWeaknesses}}" class="deep-summary-block">
            <text class="deep-summary-label deep-label-warn">待改进</text>
            <text class="deep-summary-text">{{deepSummary.playerWeaknesses}}</text>
          </view>
          <view wx:if="{{deepSummary.recommendedTraining}}" class="deep-summary-block">
            <text class="deep-summary-label deep-label-info">推荐训练</text>
            <text class="deep-summary-text">{{deepSummary.recommendedTraining}}</text>
          </view>
        </view>
      </block>

      <!-- 统计 + 过滤 -->
      <block wx:if="{{deepStats}}">
        <view class="deep-stats">
          <view class="deep-stat" catchtap="onDeepClassTap" data-cls="best">
            <text class="deep-stat-val deep-c-best">{{deepStats.best}}</text>
            <text class="deep-stat-lbl {{deepFilterMap.best ? 'deep-stat-lbl-on' : ''}}">最佳</text>
          </view>
          <view class="deep-stat" catchtap="onDeepClassTap" data-cls="good">
            <text class="deep-stat-val deep-c-good">{{deepStats.good}}</text>
            <text class="deep-stat-lbl {{deepFilterMap.good ? 'deep-stat-lbl-on' : ''}}">良好</text>
          </view>
          <view class="deep-stat" catchtap="onDeepClassTap" data-cls="inaccuracy">
            <text class="deep-stat-val deep-c-inacc">{{deepStats.inacc}}</text>
            <text class="deep-stat-lbl {{deepFilterMap.inaccuracy ? 'deep-stat-lbl-on' : ''}}">不精确</text>
          </view>
          <view class="deep-stat" catchtap="onDeepClassTap" data-cls="mistake">
            <text class="deep-stat-val deep-c-mistake">{{deepStats.mistake}}</text>
            <text class="deep-stat-lbl {{deepFilterMap.mistake ? 'deep-stat-lbl-on' : ''}}">失误</text>
          </view>
          <view class="deep-stat" catchtap="onDeepClassTap" data-cls="blunder">
            <text class="deep-stat-val deep-c-blunder">{{deepStats.blunder}}</text>
            <text class="deep-stat-lbl {{deepFilterMap.blunder ? 'deep-stat-lbl-on' : ''}}">大错</text>
          </view>
        </view>
        <view class="deep-filter-row">
          <view class="deep-filter-chip {{deepOnlyMine ? 'deep-filter-chip-on' : ''}}" catchtap="onToggleDeepOnlyMine">
            仅看我方
          </view>
          <view wx:if="{{deepOnlyMine || deepClassFilter.length > 0}}" class="deep-filter-chip" catchtap="onDeepClearFilters">
            清除筛选
          </view>
          <text class="deep-count">共 {{deepStats.total}} 步</text>
        </view>
      </block>

      <!-- 逐步分析列表 -->
      <view wx:for="{{deepList}}" wx:key="index" wx:for-item="rv"
            class="deep-move-card {{reviewDetailIndex === rv.index ? 'deep-move-active' : ''}}">
        <view class="deep-move-head" catchtap="onDeepToggleMove" data-index="{{rv.index}}">
          <text class="deep-move-icon {{rv.classColor}}">{{rv.classIcon}}</text>
          <text class="deep-move-num">#{{rv.playerMoveNumber}}</text>
          <text class="deep-side-dot {{rv.sideIsWhite ? 'side-white' : 'side-black'}}"></text>
          <text class="deep-move-san">{{rv.san}}</text>
          <text class="deep-move-class">{{rv.classLabel}}</text>
          <text class="deep-move-score {{rv.playedScore <= -0.5 ? 'score-negative' : 'score-positive'}}">{{rv.playedScoreFormatted}}</text>
          <text class="deep-move-caret">{{deepExpanded[rv.index] ? '▲' : '▼'}}</text>
        </view>

        <view wx:if="{{deepExpanded[rv.index]}}" class="deep-move-body">
          <view wx:if="{{rv.strategicTag}}" class="deep-tag-row">
            <text class="deep-tag">{{rv.strategicTag}}</text>
          </view>
          <text wx:if="{{rv.strategicCommentary}}" class="deep-commentary">{{rv.strategicCommentary}}</text>
          <view wx:if="{{!rv.isBest && rv.bestMoveText}}" class="deep-best-row">
            <text class="deep-best-label">推荐走法</text>
            <text class="deep-best-move">{{rv.bestMoveText}}</text>
            <text class="deep-best-score">{{rv.bestScoreFormatted}}</text>
          </view>
          <view wx:if="{{rv.mistakeReason}}" class="deep-block-warn">
            <text class="deep-block-title">⚠️ 失误原因</text>
            <text class="deep-block-text">{{rv.mistakeReason}}</text>
          </view>
          <view wx:if="{{rv.alternativePlan}}" class="deep-block-info">
            <text class="deep-block-title">💡 后续计划</text>
            <text class="deep-block-text">{{rv.alternativePlan}}</text>
          </view>
          <view class="deep-goto-btn" catchtap="onDeepGoToMove" data-index="{{rv.index}}">
            跳到第 {{rv.playerMoveNumber}} 手
          </view>
        </view>
      </view>

      <!-- 底部操作 -->
      <view wx:if="{{deepResults.length > 0 && !deepLoading}}" class="deep-footer-row">
        <view class="deep-footer-btn" catchtap="onStartDeepReview">重新分析</view>
        <view class="deep-footer-btn deep-footer-danger" catchtap="onClearDeepReview">清除</view>
      </view>
    </scroll-view>
  </view>

  <!-- AI 推荐走法弹窗 -->
  <view wx:if="{{showAiAnalysis}}" class="modal-overlay" catchtap="onHideAiAnalysis">
    <view class="ai-analysis-modal glass-strong" catchtap="stopPropagation">
      <view class="modal-header">
        <view class="modal-title-wrap">
          <text class="modal-title">🤖 AI 推荐走法讲解</text>
          <text class="ai-gen-flag">AI生成</text>
        </view>
        <text class="modal-close" catchtap="onHideAiAnalysis">✕</text>
      </view>
      <view class="ai-gen-notice"><text>以下内容由人工智能（AI）自动生成，仅供参考</text></view>
      <scroll-view class="modal-body" scroll-y>
        <text wx:if="{{aiAnalysisLoading}}" class="modal-loading">⏳ AI 正在分析当前局面...</text>
        <text wx:if="{{aiAnalysisText}}" class="modal-text">{{aiAnalysisText}}</text>
  <!-- AI生成内容免责声明 -->
  <view class="ai-disclaimer"><text>本服务为AI生成内容，结果仅供参考</text></view>
      </scroll-view>
    </view>
  </view>

  <!-- AI 教练 -->
  <coach-chat fen="{{displayFen}}" moveHistory="{{moves}}" gameStarted="{{true}}"></coach-chat>

  <!-- 视频生成弹窗 -->
  <view wx:if="{{showVideoModal}}" class="modal-overlay" catchtap="onHideVideoModal">
    <view class="video-modal glass-strong" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">🎬 生成讲解视频</text>
        <text class="modal-close" catchtap="onHideVideoModal">✕</text>
      </view>
      <view class="modal-body">
        <view wx:if="{{videoGenerating}}" class="modal-loading">
          <text>⏳ 视频生成中...</text>
          <text class="video-status">{{videoStatus}}</text>
        </view>
        <view wx:else>
          <text class="video-desc">将本局棋谱生成带 AI 幽默解说的讲解视频（MP4），视频内容由人工智能（AI）自动生成，仅供参考</text>
          <view class="btn-row">
            <view class="btn primary" catchtap="onGenerateVideo">
              <text class="btn-text">开始生成</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 分享弹窗 -->
  <view wx:if="{{showShareModal}}" class="modal-overlay" catchtap="onHideShare">
    <view class="share-modal glass-strong" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">📤 分享对局</text>
        <text class="modal-close" catchtap="onHideShare">✕</text>
      </view>
      <view class="modal-body">
        <text class="share-desc">复制链接分享给好友，对方可查看本局棋谱与分析</text>
        <view class="share-link-box">
          <text class="share-link-text">{{shareLink || '生成中...'}}</text>
        </view>
        <view class="btn-row">
          <view class="btn primary" catchtap="onCopyShareLink">
            <text class="btn-text">复制链接</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>