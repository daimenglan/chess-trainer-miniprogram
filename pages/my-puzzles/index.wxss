.page {
  background: var(--bg-page, #0f0f23);
  color: var(--text-primary, #e8e8f0);
  min-height: 100vh;
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--bg-card, #1a1a2e);
  border-bottom: 1rpx solid var(--border-color, #2a2a4a);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: var(--bg-hover, #252545);
  margin-right: 24rpx;
}

.nav-back-icon { font-size: 32rpx; color: var(--text-primary, #e8e8f0); }
.nav-back-text { font-size: 26rpx; color: var(--text-primary, #e8e8f0); }
.nav-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); flex: 1; }

.nav-add {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6c63ff, #8b8bff);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-add text { font-size: 28rpx; color: #fff; font-weight: 700; }

.scroll-content { padding: 24rpx 32rpx; height: calc(100vh - 100rpx); }

.stats-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.stat-box {
  flex: 1;
  background: var(--bg-card, #1a1a2e);
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  border: 1rpx solid var(--border-color, #2a2a4a);
}

.stat-num { font-size: 32rpx; font-weight: 700; color: var(--accent, #6c63ff); display: block; }
.stat-label { font-size: 20rpx; color: var(--text-secondary, #a0a0c0); display: block; margin-top: 4rpx; }

.puzzle-list { display: flex; flex-direction: column; gap: 16rpx; }

.puzzle-card {
  background: var(--bg-card, #1a1a2e);
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
}

.puzzle-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.puzzle-title { font-size: 26rpx; font-weight: 600; color: var(--text-primary, #e8e8f0); flex: 1; }

.puzzle-status {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.puzzle-status[status="mastered"] { color: #22c55e; background: rgba(34, 197, 94, 0.1); }
.puzzle-status[status="due"] { color: #f59e0b; background: rgba(245, 158, 11, 0.1); }

.puzzle-desc { font-size: 22rpx; color: var(--text-secondary, #a0a0c0); margin-bottom: 12rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

.puzzle-meta { display: flex; gap: 16rpx; margin-bottom: 16rpx; }

.meta-item { font-size: 20rpx; color: var(--text-muted, #888); }

.puzzle-actions { display: flex; gap: 12rpx; }

.action-mini {
  flex: 1;
  padding: 12rpx;
  background: var(--bg-input, #15152a);
  border-radius: 10rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
  text-align: center;
}

.action-mini text { font-size: 22rpx; color: var(--accent, #6c63ff); }
.action-mini.del text { color: #ef4444; }

.empty-tip { text-align: center; padding: 60rpx 32rpx; }
.empty-tip text { font-size: 24rpx; color: var(--text-muted, #666); }
.loading-tip { text-align: center; padding: 40rpx; }
.loading-tip text { font-size: 24rpx; color: var(--text-muted, #666); }