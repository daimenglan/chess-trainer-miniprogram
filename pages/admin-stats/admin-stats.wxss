/* 统计分析 */
.stats-page {
  min-height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
}

.page-body {
  height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.panel {
  padding: 28rpx 24rpx;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 20rpx;
  margin-bottom: 28rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: var(--text-primary);
}

.empty-tip {
  text-align: center;
  color: var(--text-muted);
  font-size: 26rpx;
  padding: 40rpx 0;
}

/* CSS 条形图（难度分布 / 模块时长） */
.bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 0;
}

.bar-label {
  width: 90rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: right;
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  height: 24rpx;
  background: var(--bg-card-hover);
  border-radius: 12rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #6c63ff, #4834d4);
  min-width: 4rpx;
}

.bar-value {
  width: 100rpx;
  font-size: 24rpx;
  color: var(--text-primary);
  flex-shrink: 0;
}

.module-row {
  padding: 12rpx 0;
}

.module-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.module-name {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.module-meta {
  font-size: 22rpx;
  color: var(--text-muted);
}

.module-fill {
  background: linear-gradient(90deg, #4ade80, #22c55e);
}

.loading-tip {
  text-align: center;
  color: var(--text-muted);
  font-size: 26rpx;
  padding: 24rpx 0 60rpx;
}

.error-tip {
  text-align: center;
  color: var(--danger);
  font-size: 26rpx;
  padding: 24rpx 0 60rpx;
}
