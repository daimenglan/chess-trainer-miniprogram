.agreement-page {
  min-height: 100vh;
  background: var(--bg-primary);
  padding: 24rpx;
  box-sizing: border-box;
}

.doc-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 20rpx;
  padding: 40rpx 36rpx;
}

.doc-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 12rpx;
}

.doc-update {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
  margin-bottom: 32rpx;
}

.doc-section {
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
}

.doc-h2 {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.doc-p {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}

.doc-strong {
  font-weight: 600;
  color: var(--text-primary);
}

.doc-contact {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
  padding-top: 24rpx;
  border-top: 1px dashed var(--border-color);
}
