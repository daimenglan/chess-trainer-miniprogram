.page {
  background: var(--bg-page, #0f0f23);
  color: var(--text-primary, #e8e8f0);
  min-height: 100vh;
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--bg-card, #1a1a2e);
  border-bottom: 1rpx solid var(--border-color, #2a2a4a);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: var(--bg-hover, #252545);
  margin-right: 24rpx;
}

.nav-back-icon { font-size: 32rpx; color: var(--text-primary, #e8e8f0); }
.nav-back-text { font-size: 26rpx; color: var(--text-primary, #e8e8f0); }
.nav-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); flex: 1; }

.scroll-content { padding: 24rpx 32rpx; height: calc(100vh - 100rpx); }

.balance-card {
  background: linear-gradient(135deg, #6c63ff, #8b8bff);
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.balance-label { font-size: 24rpx; color: rgba(255,255,255,0.8); display: block; margin-bottom: 8rpx; }
.balance-num { font-size: 48rpx; font-weight: 700; color: #fff; display: block; }

.section { margin-bottom: 24rpx; }

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary, #e8e8f0);
  display: block;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--border-color, #2a2a4a);
}

.config-list { display: flex; flex-direction: column; gap: 12rpx; }

.config-card {
  background: var(--bg-card, #1a1a2e);
  border-radius: 16rpx;
  padding: 22rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
}

.config-card.selected {
  border-color: var(--accent, #6c63ff);
  background: rgba(108, 99, 255, 0.08);
}

.config-name { font-size: 26rpx; font-weight: 600; color: var(--text-primary, #e8e8f0); display: block; margin-bottom: 4rpx; }
.config-desc { font-size: 22rpx; color: var(--text-secondary, #a0a0c0); display: block; margin-bottom: 8rpx; }
.config-cost { font-size: 20rpx; color: var(--accent, #6c63ff); display: block; }

.exchange-box {
  background: var(--bg-card, #1a1a2e);
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
}

.exchange-label { font-size: 24rpx; color: var(--text-secondary, #a0a0c0); display: block; margin-bottom: 16rpx; }

.amount-control {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.amount-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg-input, #15152a);
  border: 1rpx solid var(--border-color, #2a2a4a);
  display: flex;
  align-items: center;
  justify-content: center;
}

.amount-btn text { font-size: 32rpx; color: var(--text-primary, #e8e8f0); }

.amount-input {
  width: 80rpx;
  height: 56rpx;
  text-align: center;
  background: var(--bg-input, #15152a);
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
  color: var(--text-primary, #e8e8f0);
  font-size: 28rpx;
}

.exchange-total { font-size: 24rpx; color: var(--text-secondary, #a0a0c0); display: block; text-align: center; margin-bottom: 20rpx; }

.exchange-btn {
  padding: 22rpx;
  background: linear-gradient(135deg, #6c63ff, #8b8bff);
  border-radius: 12rpx;
  text-align: center;
}

.exchange-btn-text { font-size: 28rpx; font-weight: 700; color: #fff; }

.record-list { display: flex; flex-direction: column; gap: 12rpx; }

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 22rpx;
  background: var(--bg-card, #1a1a2e);
  border-radius: 14rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
}

.record-info { display: flex; flex-direction: column; gap: 4rpx; }
.record-name { font-size: 24rpx; color: var(--text-primary, #e8e8f0); }
.record-date { font-size: 20rpx; color: var(--text-muted, #888); }
.record-amount { font-size: 22rpx; color: #f59e0b; font-weight: 600; }

.empty-tip { text-align: center; padding: 40rpx; }
.empty-tip text { font-size: 24rpx; color: var(--text-muted, #666); }