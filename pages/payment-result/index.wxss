.payment-result-page {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  min-height: 0;
  padding: 48rpx;
  background: var(--bg-primary);
}

.pr-container {
  width: 100%;
  max-width: 640rpx;
}

.pr-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 28rpx;
  padding: 48rpx;
  text-align: center;
}

.pr-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.pr-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4px solid var(--border-color);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: pr-spin 1s linear infinite;
}

@keyframes pr-spin {
  to { transform: rotate(360deg); }
}

.pr-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.pr-icon.success {
  background: #4ade80;
}

.pr-icon.error {
  background: #ef4444;
}

.pr-icon.timeout {
  background: #f59e0b;
}

.pr-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.pr-subtitle {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.4;
}

.pr-time {
  font-size: 20rpx;
  color: var(--text-muted);
  display: block;
}

.pr-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
  width: 100%;
}

.pr-btn {
  padding: 22rpx;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 14rpx;
  border: none;
}

.pr-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #6366f1, #ec4899);
}

.pr-btn:not(.primary) {
  color: var(--text-primary);
  background: var(--bg-card);
  border: 1px solid var(--border-color);
}