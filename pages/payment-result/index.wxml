<view class="payment-result-page">
  <view class="pr-container">
    <view class="pr-card">
      <!-- 加载中 -->
      <view wx:if="{{status === 'loading'}}" class="pr-state">
        <view class="pr-spinner"></view>
        <text class="pr-title">正在确认支付结果</text>
        <text class="pr-subtitle">{{message || '请耐心等待…'}}</text>
      </view>

      <!-- 成功 -->
      <view wx:if="{{status === 'success'}}" class="pr-state">
        <view class="pr-icon success">
          <text>✓</text>
        </view>
        <text class="pr-title">支付成功</text>
        <text class="pr-subtitle">{{levelName ? '「' + levelName + '」会员已开通' : '会员已开通'}}</text>
        <text wx:if="{{expireAt}}" class="pr-time">支付时间：{{expireAt}}</text>
        <view class="pr-actions">
          <button class="pr-btn primary" bindtap="onGoMembership">返回会员中心</button>
          <button class="pr-btn" bindtap="onGoHome">返回首页</button>
        </view>
      </view>

      <!-- 失败 -->
      <view wx:if="{{status === 'failed'}}" class="pr-state">
        <view class="pr-icon error">
          <text>✕</text>
        </view>
        <text class="pr-title">支付失败</text>
        <text class="pr-subtitle">{{message || '支付未成功，请重新尝试'}}</text>
        <view class="pr-actions">
          <button class="pr-btn primary" bindtap="onGoMembership">返回重新购买</button>
          <button class="pr-btn" bindtap="onGoHome">返回首页</button>
        </view>
      </view>

      <!-- 超时 -->
      <view wx:if="{{status === 'timeout'}}" class="pr-state">
        <view class="pr-icon timeout">
          <text>⏳</text>
        </view>
        <text class="pr-title">确认中</text>
        <text class="pr-subtitle">{{message}}</text>
        <view class="pr-actions">
          <button class="pr-btn primary" bindtap="onGoMembership">查看订单状态</button>
          <button class="pr-btn" bindtap="onGoHome">返回首页</button>
        </view>
      </view>
    </view>
  </view>
  <!-- AI生成内容免责声明 -->
  <view class="ai-disclaimer"><text>本服务为AI生成、人工智能生成内容，结果仅供参考</text></view>
</view>