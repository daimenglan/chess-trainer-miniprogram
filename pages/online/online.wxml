<view class="online-page {{__theme__ ? 'theme-' + __theme__ : ''}}">
  <!-- ===== 空闲/摆桌/匹配状态 ===== -->
  <block wx:if="{{status === 'idle' || status === 'tabling' || status === 'matching'}}">

    <!-- 标题区域 -->
    <view class="match-container">
      <view class="match-title">在线对弈</view>
      <view class="match-desc">摆下棋桌等待挑战，或主动匹配随机对手</view>

      <!-- 状态提示 -->
      <view wx:if="{{statusMessage}}" class="status-toast {{statusToastType}}">
        <text>{{statusMessage}}</text>
      </view>

      <!-- 匹配/摆桌双按钮 -->
      <view wx:if="{{status === 'idle'}}" class="table-actions">
        <view class="table-action-btn card-match" catchtap="onJoinMatch">
          <text class="table-action-icon">🎯</text>
          <text class="table-action-label">匹配对手</text>
          <text class="table-action-desc">系统自动匹配</text>
        </view>
        <view class="table-action-btn card-table" catchtap="onOpenTable">
          <text class="table-action-icon">⚡</text>
          <text class="table-action-label">摆下棋桌</text>
          <text class="table-action-desc">等待他人挑战</text>
        </view>
      </view>

      <!-- 匹配中 -->
      <block wx:if="{{status === 'matching'}}">
        <view class="match-card">
          <view class="match-icon spinning">🔄</view>
          <text class="match-label">匹配中...</text>
        </view>
        <text class="match-timer">已等待 {{waitingSeconds}} 秒</text>
        <view class="match-cancel" catchtap="onCancelMatch">✕ 取消匹配</view>
      </block>

      <!-- 摆桌等待中 -->
      <block wx:if="{{status === 'tabling'}}">
        <view class="tabling-banner">
          <view class="tabling-icon-wrap">
            <text class="tabling-pulse-icon">⚡</text>
          </view>
          <text class="tabling-title">棋桌已摆好</text>
          <text class="tabling-subtitle">等待对手挑战...</text>
          <text class="tabling-info">⏱ {{currentTimeLabel}}</text>
          <view class="tabling-cancel" catchtap="onCloseTable">✕ 撤下棋桌</view>
        </view>
      </block>
    </view>

    <!-- ===== 棋桌大厅 ===== -->
    <view class="table-lobby-section">
      <view class="lobby-header">
        <text class="lobby-title">🏆 棋桌大厅</text>
        <text class="lobby-count">{{activeTables.length}} 张棋桌</text>
        <view class="lobby-history-btn" catchtap="onToggleHistory">
          📋 历史记录
        </view>
      </view>

      <!-- 历史面板 -->
      <view wx:if="{{showHistory}}" class="history-panel">
        <view wx:if="{{historyLoading}}" class="loading-mini">加载中...</view>
        <view wx:else class="history-list">
          <view wx:if="{{gameHistory.length === 0}}" class="history-empty">
            <text>暂无历史对局</text>
          </view>
          <view class="history-item" wx:for="{{gameHistory}}" wx:key="gameId" wx:for-index="idx">
            <view class="history-players">
              <text class="history-name">{{item.whiteName}}</text>
              <text class="history-vs">VS</text>
              <text class="history-name">{{item.blackName}}</text>
            </view>
            <view class="history-meta">
              <text class="history-result {{item.resultLabel === '白胜' ? 'res-win' : item.resultLabel === '黑胜' ? 'res-loss' : 'res-draw'}}">{{item.resultLabel}}</text>
              <text wx:if="{{item.dateFormatted}}" class="history-date">{{item.dateFormatted}}</text>
            </view>
            <view class="history-actions">
              <view class="history-replay-btn" catchtap="onReplayGame" data-idx="{{idx}}">▶ 回放</view>
            </view>
          </view>
        </view>
      </view>

      <scroll-view wx:if="{{!showHistory}}" scroll-y class="lobby-scroll">
        <view wx:if="{{activeTables.length === 0}}" class="lobby-empty">
          <text class="lobby-empty-icon">🪑</text>
          <text class="lobby-empty-text">暂无棋桌，快去摆下一张吧</text>
        </view>

        <view wx:for="{{activeTables}}" wx:key="tableId" class="table-card">
          <view class="table-card-left">
            <view class="table-host-row">
              <text class="table-host-avatar">{{getHostInitial(item)}}</text>
              <text class="table-host-name">{{getHostName(item)}}</text>
            </view>
            <view class="table-meta-row">
              <text class="table-meta-time">⏱ {{formatTableTime(item)}}</text>
              <text class="table-meta-wait">🕐 {{formatWaitingTime(item.createdAt)}}</text>
              <text wx:if="{{getSpectatorCount(item) > 0}}" class="table-meta-spec">👁 {{getSpectatorCount(item)}}</text>
            </view>
          </view>
          <view class="table-card-right">
            <view class="table-join-btn" catchtap="onChallengeTable" data-tableid="{{item.tableId}}">
              挑战
            </view>
            <view class="table-spectate-btn" catchtap="onSpectateTable" data-tableid="{{item.tableId}}">
              观战
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </block>

  <!-- ===== 对局中 ===== -->
  <block wx:if="{{status === 'playing'}}">
    <!-- 对手信息 -->
    <view class="opponent-bar">
      <view class="player-info {{!isMyTurn ? 'active-turn' : ''}}">
        <text class="player-color-signal {{opponentColor === 'w' ? 'color-white' : 'color-black'}}"></text>
        <text class="player-name">{{opponentName}}</text>
        <text class="player-time {{opponentTime <= 30 ? 'time-low' : ''}}">
          {{formatTime(opponentTime)}}
        </text>
      </view>
      <text class="vs-label">VS</text>
    </view>

    <!-- 观战人数 -->
    <view class="spectator-bar" wx:if="{{spectatorCount > 0}}">
      <text class="spectator-icon">👁</text>
      <text class="spectator-count">{{spectatorCount}} 人观战</text>
    </view>

    <!-- 棋盘 -->
    <view class="online-board-area">
      <chess-board id="onlineBoard"
        fen="{{fen}}"
        isCheck="{{isCheck}}"
        interactive="{{isMyTurn && !gameOver}}"
        flipped="{{flipped}}"
        selectedSquare="{{selectedSquare}}"
        legalMoves="{{legalMoves}}"
        lastMoveFrom="{{lastMoveFrom}}"
        lastMoveTo="{{lastMoveTo}}"
        boardColorPreset="blueWhite"
        bind:squaretap="onSquareTap">
      </chess-board>
    </view>

    <!-- 己方信息 -->
    <view class="my-info">
      <view class="player-info {{isMyTurn ? 'active-turn' : ''}}">
        <text class="player-color-signal {{myColor === 'w' ? 'color-white' : 'color-black'}}"></text>
        <text class="player-name">{{myName}}</text>
        <text class="player-time {{myTime <= 30 ? 'time-low' : ''}}">
          {{formatTime(myTime)}}
        </text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar">
      <view class="action-btn {{isMyTurn ? '' : 'action-disabled'}}" catchtap="onFlipBoard">
        🔄 翻转
      </view>
      <view class="action-btn {{canOfferDraw ? '' : 'action-disabled'}}" catchtap="onDrawOffer">
        🤝 和棋
      </view>
      <view class="action-btn {{canTakeback ? '' : 'action-disabled'}}" catchtap="onTakebackRequest">
        ↩ 悔棋
      </view>
      <view class="action-btn action-danger" catchtap="onResign">
        🏳️ 认输
      </view>
    </view>

    <!-- 状态提示 -->
    <view wx:if="{{statusMessage}}" class="status-toast {{statusToastType}}">
      <text>{{statusMessage}}</text>
    </view>

    <!-- 和棋/悔棋确认弹窗 -->
    <view wx:if="{{showConfirm}}" class="confirm-overlay" catchtap="onConfirmCancel">
      <view class="confirm-dialog" catchtap="stopPropagation">
        <text class="confirm-title">{{confirmTitle}}</text>
        <text class="confirm-desc">{{confirmDesc}}</text>
        <view class="confirm-actions">
          <view class="confirm-btn" catchtap="onConfirmYes">同意</view>
          <view class="confirm-btn confirm-btn-no" catchtap="onConfirmCancel">拒绝</view>
        </view>
      </view>
    </view>
  </block>

  <!-- ===== 回放模式 ===== -->
  <block wx:if="{{status === 'replay'}}">
    <view class="replay-bar-inline">
      <view class="replay-btn" catchtap="replayPrev">◀ 上一步</view>
      <text class="replay-info">{{replayIndex + 1}} / {{replayTotal}}</text>
      <view class="replay-btn" catchtap="replayNext">下一步 ▶</view>
      <view class="replay-btn" catchtap="exitReplay">✕ 退出</view>
    </view>

    <view class="online-board-area">
      <chess-board
        fen="{{fen}}"
        isCheck="{{isCheck}}"
        interactive="false"
        flipped="{{flipped}}"
        selectedSquare=""
        legalMoves="[]"
        lastMoveFrom=""
        lastMoveTo=""
        boardColorPreset="blueWhite">
      </chess-board>
    </view>

    <view class="replay-info-bar">
      <text class="replay-players">{{opponentName}} VS {{myName}}</text>
      <text class="replay-progress">回放进度：{{replayIndex}} / {{replayTotal}}</text>
    </view>
  </block>

  <!-- ===== 对局结束弹窗 ===== -->
  <view wx:if="{{showGameOver}}" class="overlay">
    <view class="gameover-dialog">
      <text class="gameover-icon">{{gameOverIcon}}</text>
      <text class="gameover-title">{{gameOverTitle}}</text>
      <text class="gameover-desc">{{gameOverDesc}}</text>
      <view class="gameover-actions">
        <view class="btn-primary" catchtap="onRematch">🔁 再来一局</view>
        <view class="btn-secondary" catchtap="onBackToLobby">🏠 回到大厅</view>
      </view>
    </view>
  </view>

  <!-- ===== 邀请弹窗 ===== -->
  <view wx:if="{{showInviteDialog}}" class="confirm-overlay">
    <view class="confirm-dialog invite-dialog" catchtap="stopPropagation">
      <text class="invite-emoji">🤺</text>
      <text class="confirm-title">对弈邀请</text>
      <text class="invite-desc">
        <text class="invite-username">{{inviteData.fromUsername || '对手'}}</text>
        向你发起对弈挑战！
      </text>
      <view class="invite-detail-row">
        <text class="invite-detail-label">⏱ 用时</text>
        <text class="invite-detail-value">{{formatTableTime(inviteData)}}</text>
      </view>
      <view wx:if="{{inviteData.fromRating}}" class="invite-detail-row">
        <text class="invite-detail-label">📊 等级分</text>
        <text class="invite-detail-value">{{inviteData.fromRating}}</text>
      </view>
      <view class="confirm-actions">
        <view class="confirm-btn" catchtap="onInviteAccept">接受</view>
        <view class="confirm-btn confirm-btn-no" catchtap="onInviteDecline">拒绝</view>
      </view>
    </view>
  </view>

  <!-- 升变弹窗 -->
  <promotion-dialog show="{{showPromotion}}" color="{{myColor}}"
                    bind:select="onPromotionSelect" bind:cancel="onPromotionCancel"></promotion-dialog>

</view>