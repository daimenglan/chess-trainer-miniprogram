.online-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0f0f23;
  padding: 20rpx;
  box-sizing: border-box;
}

/* ===== 匹配界面 ===== */
.match-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
}

.match-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #e0e0ff;
}

.match-desc {
  font-size: 24rpx;
  color: #8888aa;
  text-align: center;
  padding: 0 60rpx;
}

.match-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 60rpx;
  background: linear-gradient(135deg, #6c63ff, #5a52d5);
  border-radius: 20rpx;
  cursor: pointer;
  transition: transform 0.2s;
}

.match-card:active {
  transform: scale(0.95);
}

.match-icon {
  font-size: 40rpx;
}

.spinning {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.match-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.match-timer {
  font-size: 24rpx;
  color: #8888aa;
}

.match-cancel {
  font-size: 26rpx;
  color: #f87171;
  padding: 16rpx 40rpx;
  cursor: pointer;
}

/* ===== 对局信息栏 ===== */
.opponent-bar, .my-info {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
}

.vs-label {
  font-size: 24rpx;
  color: #6666aa;
  margin-left: 20rpx;
}

.player-info {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: rgba(108, 99, 255, 0.06);
  border: 1px solid rgba(108, 99, 255, 0.15);
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
}

.player-color-signal {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
}

.color-white { background: #fff; }
.color-black { background: #262626; }

.player-name {
  font-size: 26rpx;
  color: #e0e0ff;
  font-weight: 500;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-time {
  font-size: 28rpx;
  font-weight: 700;
  color: #ccccee;
  font-variant-numeric: tabular-nums;
  min-width: 70rpx;
  text-align: right;
}

.time-low {
  color: #f87171;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

/* ===== 棋盘区域 ===== */
.online-board-area {
  width: 100%;
  max-width: 700rpx;
  margin: 0 auto;
}

/* ===== 操作按钮 ===== */
.action-bar {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 0;
  flex-wrap: wrap;
}

.action-btn {
  padding: 14rpx 24rpx;
  background: rgba(108, 99, 255, 0.1);
  border: 1px solid rgba(108, 99, 255, 0.2);
  border-radius: 14rpx;
  color: #ccccee;
  font-size: 22rpx;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.15s;
}

.action-btn:active {
  background: rgba(108, 99, 255, 0.2);
}

.action-disabled {
  opacity: 0.4;
  pointer-events: none;
}

.action-danger {
  border-color: rgba(248, 113, 113, 0.3);
  color: #f87171;
}

/* ===== 状态提示 ===== */
.status-toast {
  position: fixed;
  top: 100rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 12rpx 32rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  z-index: 100;
  animation: fadeInOut 3s ease forwards;
}

.status-toast.info {
  background: rgba(108, 99, 255, 0.2);
  border: 1px solid rgba(108, 99, 255, 0.3);
  color: #ccccee;
}

.status-toast.warn {
  background: rgba(248, 113, 113, 0.2);
  border: 1px solid rgba(248, 113, 113, 0.3);
  color: #f87171;
}

@keyframes fadeInOut {
  0% { opacity: 0; transform: translateX(-50%) translateY(-20rpx); }
  10% { opacity: 1; transform: translateX(-50%) translateY(0); }
  80% { opacity: 1; }
  100% { opacity: 0; }
}

/* ===== 确认弹窗 ===== */
.confirm-overlay, .overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}

.confirm-dialog, .gameover-dialog {
  background: #1a1a2e;
  border: 1px solid rgba(108, 99, 255, 0.3);
  border-radius: 24rpx;
  padding: 40rpx;
  width: 80%;
  max-width: 500rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.confirm-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #e0e0ff;
}

.confirm-desc {
  font-size: 24rpx;
  color: #8888aa;
  text-align: center;
}

.confirm-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}

.confirm-btn {
  padding: 14rpx 40rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: #6c63ff;
  color: #fff;
  cursor: pointer;
}

.confirm-btn-no {
  background: rgba(255, 255, 255, 0.1);
  color: #8888aa;
}

/* ===== 结束弹窗 ===== */
.gameover-icon {
  font-size: 72rpx;
}

.gameover-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #e0e0ff;
}

.gameover-desc {
  font-size: 24rpx;
  color: #8888aa;
}

.gameover-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.btn-primary {
  padding: 16rpx 40rpx;
  background: #6c63ff;
  border-radius: 14rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  cursor: pointer;
}

.btn-secondary {
  padding: 16rpx 40rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 14rpx;
  color: #8888aa;
  font-size: 26rpx;
  cursor: pointer;
}