<view class="page {{__theme__ ? 'theme-' + __theme__ : ''}}">
  <view class="nav-bar">
    <view class="nav-back" bindtap="onBack">
      <text class="nav-back-icon">←</text>
      <text class="nav-back-text">返回</text>
    </view>
    <text class="nav-title">设置账号密码</text>
  </view>

  <view class="setpw-container">
    <view class="setpw-hero">
      <text class="setpw-emoji">🔐</text>
      <text class="setpw-title">设置账号密码</text>
      <text class="setpw-desc">设置密码后即可使用账号密码登录，并解除功能拦截（如 Lichess 绑定）。</text>
    </view>

    <view class="setpw-form">
      <input class="input-field" value="{{username}}" bindinput="onUsernameInput" placeholder="用户名（2-20位）" placeholder-class="placeholder" maxlength="20" />

      <input class="input-field" value="{{newPassword}}" bindinput="onNewPasswordInput" type="password" placeholder="新密码（至少6位）" placeholder-class="placeholder" />

      <input class="input-field" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" type="password" placeholder="确认新密码" placeholder-class="placeholder" />

      <view wx:if="{{error}}" class="error-tip"><text>{{error}}</text></view>

      <view class="submit-btn {{loading ? 'btn-disabled' : ''}}" catchtap="onSubmit">
        <text class="submit-btn-text">{{loading ? '设置中...' : '确认设置'}}</text>
      </view>
    </view>
  </view>
  <!-- AI生成内容免责声明 -->
  <view class="ai-disclaimer"><text>本服务为AI生成、人工智能生成内容，结果仅供参考</text></view>
</view>