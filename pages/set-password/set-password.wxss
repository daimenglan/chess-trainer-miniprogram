.setpw-container { padding: 40rpx 32rpx; height: calc(100vh - 100rpx); display: flex; flex-direction: column; }
.setpw-hero { display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: 48rpx; }
.setpw-emoji { font-size: 64rpx; margin-bottom: 16rpx; }
.setpw-title { font-size: 36rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); margin-bottom: 12rpx; }
.setpw-desc { font-size: 24rpx; color: var(--text-secondary, #a0a0c0); line-height: 1.6; max-width: 80%; }
.setpw-form { display: flex; flex-direction: column; }
.input-field { width: 100%; padding: 20rpx 24rpx; background: var(--bg-input, #15152a); border-radius: 12rpx; border: 1rpx solid var(--border-color, #2a2a4a); color: var(--text-primary, #e8e8f0); font-size: 28rpx; margin-bottom: 16rpx; }
.placeholder { color: var(--text-muted, #666); }
.error-tip { margin-top: 8rpx; padding: 16rpx; background: rgba(239, 68, 68, 0.1); border-radius: 12rpx; border: 1rpx solid rgba(239, 68, 68, 0.3); }
.error-tip text { font-size: 24rpx; color: #ef4444; }
.submit-btn { margin-top: 12rpx; padding: 22rpx; background: linear-gradient(135deg, #6c63ff, #8b8bff); border-radius: 12rpx; text-align: center; }
.submit-btn.btn-disabled { opacity: 0.6; }
.submit-btn-text { font-size: 28rpx; font-weight: 700; color: #fff; }
.ai-disclaimer { text-align: center; padding: 24rpx 32rpx; }
.ai-disclaimer text { font-size: 20rpx; color: var(--text-muted, #666); }