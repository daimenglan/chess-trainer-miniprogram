.shell-page { position: relative; width: 100%; height: 100vh; overflow: hidden; background: var(--shell-bg, #0f0f23); }
.shell-web-view { position: absolute; inset: 0; width: 100%; height: 100%; }
.shell-loading, .shell-error { position: absolute; inset: 0; z-index: 10; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20rpx; padding: 40rpx; background: var(--shell-bg, #0f0f23); color: var(--shell-text, #8888aa); }
.loading-spinner { width: 64rpx; height: 64rpx; border: 6rpx solid rgba(255,255,255,.15); border-top-color: #6c63ff; border-radius: 50%; animation: shell-spin .8s linear infinite; }
@keyframes shell-spin { to { transform: rotate(360deg); } }
.error-icon { font-size: 72rpx; }
.error-text { text-align: center; line-height: 1.6; }
.error-btn { padding: 20rpx 48rpx; border-radius: 48rpx; background: #6c63ff; color: #fff; }
.theme-light { --shell-bg: #f5f5f7; --shell-text: #6b7280; }

/* ===== 未登录访客页 ===== */
.guest-page {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 48rpx;
  box-sizing: border-box;
  background: var(--shell-bg, #0f0f23);
  color: var(--shell-text, #8888aa);
}

.guest-header { text-align: center; margin-bottom: 56rpx; }
.guest-logo {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  color: #a78bfa;
  margin-bottom: 28rpx;
  font-family: 'Georgia', serif;
}
.guest-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--shell-title, #e8e8f0);
  margin-bottom: 16rpx;
}
.guest-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--shell-text, #8888aa);
}

.guest-benefits {
  width: 100%;
  max-width: 560rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 64rpx;
}
.guest-benefit {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.06);
}
.guest-benefit-icon { font-size: 32rpx; }

.guest-actions {
  width: 100%;
  max-width: 560rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.guest-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  transition: all 0.2s;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.25);
}
.guest-login-btn:active { transform: scale(0.97); }
.guest-wechat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  font-size: 22rpx;
  font-weight: 700;
}

.guest-browse-btn {
  padding: 24rpx;
  text-align: center;
  border-radius: 16rpx;
  border: 1px solid rgba(255, 255, 255, 0.18);
  color: var(--shell-title, #e8e8f0);
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s;
}
.guest-browse-btn:active { background: rgba(255, 255, 255, 0.06); transform: scale(0.97); }

.guest-hint {
  margin-top: 40rpx;
  font-size: 22rpx;
  color: var(--shell-text, #8888aa);
  text-align: center;
  line-height: 1.6;
}

.theme-light .guest-page { --shell-title: #1f2937; }
.theme-light .guest-benefit { background: rgba(0, 0, 0, 0.03); border-color: rgba(0, 0, 0, 0.06); }
.theme-light .guest-browse-btn { border-color: rgba(0, 0, 0, 0.15); }
