.profile-page {
  height: 100vh;
  background: var(--bg-primary);
  overflow: hidden;
}

.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  gap: 16rpx;
  padding: 40rpx;
}

.prompt-icon {
  font-size: 100rpx;
  opacity: 0.5;
}

.prompt-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.prompt-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  text-align: center;
}

.profile-content {
  height: 100%;
  overflow: hidden;
}

.profile-content scroll-view {
  height: 100%;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  margin: 16rpx;
  background: var(--bg-card);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--accent-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
}

.user-bio {
  font-size: 20rpx;
  color: var(--text-muted);
  display: block;
}

.user-join {
  font-size: 16rpx;
  color: var(--text-dim);
  display: block;
  margin-top: 4rpx;
}

.user-actions {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.action-btn {
  font-size: 28rpx;
  padding: 8rpx;
}

/* ===== 统计概览卡片 ===== */
.stats-overview-card {
  margin: 0 16rpx 16rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 20rpx;
}
.stats-overview-title {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}
.stats-overview-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.stat-box {
  background: var(--bg-card-hover);
  border-radius: 12rpx;
  padding: 14rpx 8rpx;
  text-align: center;
}
.stat-box-icon {
  font-size: 24rpx;
  display: block;
  margin-bottom: 2rpx;
}
.stat-box-value {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-primary);
  display: block;
}
.stat-box-value.green { color: #10b981; }
.stat-box-value.yellow { color: #eab308; }
.stat-box-value.emerald { color: #34d399; }
.stat-box-value.purple { color: #8b5cf6; }
.stat-box-value.indigo { color: #6366f1; }
.stat-box-value.pink { color: #ec4899; }
.stat-box-value.rose { color: #f43f5e; }
.stat-box-value.orange { color: #f97316; }
.stat-box-label {
  font-size: 16rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 2rpx;
}

/* 胜率进度条 */
.winrate-bar-wrap {
  margin-top: 4rpx;
}
.winrate-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.winrate-label {
  font-size: 18rpx;
  color: var(--text-secondary);
  font-weight: 600;
}
.winrate-value {
  font-size: 20rpx;
  font-weight: 800;
  color: var(--text-primary);
}
.winrate-bar-bg {
  height: 16rpx;
  background: var(--bg-card-hover);
  border-radius: 8rpx;
  overflow: hidden;
}
.winrate-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #10b981, #eab308, #ef4444);
  border-radius: 8rpx;
  transition: width 1s;
}
.winrate-detail {
  display: block;
  text-align: center;
  font-size: 16rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
}

/* ===== 基础统计 ===== */
.stats-card {
  display: flex;
  justify-content: space-around;
  padding: 16rpx;
  margin: 0 16rpx 16rpx;
  background: var(--bg-card);
  border-radius: 12rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.stat-label {
  font-size: 18rpx;
  color: var(--text-muted);
}

/* ===== 分析区域 ===== */
.analysis-section {
  margin: 0 16rpx 16rpx;
  background: var(--bg-card);
  border-radius: 12rpx;
  padding: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.analyze-btn {
  padding: 8rpx 20rpx;
  background: var(--accent-gradient);
  border-radius: 8rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

.analysis-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.tab-item {
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 18rpx;
  color: var(--text-muted);
  background: var(--bg-card);
}

.tab-active {
  background: var(--accent-bg);
  color: var(--accent);
  font-weight: 600;
}

.analysis-content {
  min-height: 100rpx;
}

.analysis-placeholder, .analysis-loading {
  text-align: center;
  padding: 40rpx 0;
  font-size: 20rpx;
  color: var(--text-dim);
}

.analysis-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  white-space: pre-wrap;
}

/* ===== 优劣势Tab ===== */
.strength-tab {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.strength-box {
  padding: 16rpx;
  border-radius: 12rpx;
  border: 1px solid rgba(16,185,129,0.3);
  background: rgba(16,185,129,0.05);
}
.weakness-box {
  border-color: rgba(245,158,11,0.3);
  background: rgba(245,158,11,0.05);
}
.strength-box-title {
  font-size: 20rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}
.strength-box:first-child .strength-box-title { color: #10b981; }
.strength-box:last-child .strength-box-title { color: #f59e0b; }
.strength-box-text {
  font-size: 20rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  display: block;
  white-space: pre-wrap;
}

/* ===== 训练推荐Tab ===== */
.training-tab-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.training-assessment-entry {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  background: rgba(108,99,255,0.08);
  border: 1px solid rgba(108,99,255,0.25);
  border-radius: 12rpx;
}
.training-entry-icon {
  font-size: 36rpx;
}
.training-entry-info {
  flex: 1;
  min-width: 0;
}
.training-entry-title {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
}
.training-entry-desc {
  font-size: 16rpx;
  color: var(--text-muted);
  display: block;
}

.training-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
}
.training-stat-item {
  text-align: center;
  padding: 12rpx;
  background: var(--bg-card-hover);
  border-radius: 10rpx;
}
.ts-label {
  font-size: 16rpx;
  color: var(--text-muted);
  display: block;
}
.ts-value {
  font-size: 28rpx;
  font-weight: 800;
  color: #6c63ff;
  display: block;
}

.training-section-label {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.training-plan-item {
  padding: 16rpx;
  background: var(--bg-card-hover);
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}
.tpi-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 4rpx;
}
.tpi-title {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.tpi-tag {
  font-size: 14rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.tag-orange { background: rgba(239,68,68,0.15); color: #ef4444; }
.tag-amber { background: rgba(245,158,11,0.15); color: #f59e0b; }
.tag-indigo { background: rgba(99,102,241,0.15); color: #6366f1; }
.tpi-reason {
  font-size: 18rpx;
  color: var(--text-muted);
  display: block;
  margin-bottom: 8rpx;
}
.tpi-meta {
  display: flex;
  gap: 12rpx;
  font-size: 16rpx;
  color: var(--text-muted);
  margin-bottom: 10rpx;
}

/* 成就网格 */
.achievement-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}
.ach-item {
  text-align: center;
  padding: 8rpx 4rpx;
  border-radius: 10rpx;
}
.ach-locked {
  opacity: 0.45;
}
.ach-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin: 0 auto 4rpx;
  background: var(--bg-card-hover);
}
.ach-icon-glow {
  background: linear-gradient(135deg, rgba(139,92,246,0.2), rgba(168,85,247,0.2));
}
.ach-name {
  font-size: 16rpx;
  color: var(--text-secondary);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 难度推荐 */
.training-diff-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.td-badge {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #f43f5e, #f97316);
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  flex-shrink: 0;
}
.td-badge-num {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1;
}
.td-badge-label {
  font-size: 16rpx;
  opacity: 0.85;
}
.td-info {
  flex: 1;
  min-width: 0;
}
.td-info-title {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
}
.td-info-range {
  font-size: 16rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 2rpx;
}

.btn-small-indigo {
  display: inline-block;
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #6c63ff, #a855f7);
  color: #fff;
  border-radius: 10rpx;
  font-size: 18rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.btn-small-blue {
  display: inline-block;
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #3b82f6, #6366f1);
  color: #fff;
  border-radius: 10rpx;
  font-size: 18rpx;
  font-weight: 600;
}
.btn-small-green {
  display: inline-block;
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #10b981, #34d399);
  color: #fff;
  border-radius: 10rpx;
  font-size: 18rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.section-link {
  font-size: 18rpx;
  color: var(--accent);
}

/* ===== 最近对局 ===== */
.recent-games-card {
  margin: 0 16rpx 16rpx;
  background: var(--bg-card);
  border-radius: 12rpx;
  padding: 16rpx;
}

.games-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  max-height: 400rpx;
}

.game-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx;
  background: var(--bg-card-hover);
  border-radius: 10rpx;
}

.game-row-players {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.game-row .player-name {
  font-size: 18rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vs-text {
  font-size: 14rpx;
  color: var(--text-dim);
  flex-shrink: 0;
}

.game-row-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.result-badge {
  font-size: 14rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-weight: 600;
}
.badge-win { background: rgba(16,185,129,0.15); color: #10b981; }
.badge-loss { background: rgba(239,68,68,0.15); color: #ef4444; }
.badge-draw { background: rgba(245,158,11,0.15); color: #f59e0b; }

.game-diff {
  font-size: 14rpx;
  color: var(--text-dim);
}

.game-date {
  font-size: 14rpx;
  color: var(--text-dim);
}

.game-row-actions {
  flex-shrink: 0;
}

.action-btn-sm {
  font-size: 16rpx;
  padding: 6rpx 12rpx;
  background: var(--accent-bg);
  color: var(--accent);
  border-radius: 8rpx;
  border: 1px solid var(--accent-border);
}

/* ===== 成就墙 ===== */
.achievements-card {
  margin: 0 16rpx 16rpx;
  background: var(--bg-card);
  border-radius: 12rpx;
  padding: 16rpx;
}

/* ===== AI定级入口 ===== */
.assessment-entry {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 16rpx 16rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, rgba(108,99,255,0.1), rgba(168,85,247,0.06));
  border: 1px solid rgba(108,99,255,0.3);
  border-radius: 14rpx;
}
.assessment-entry-icon {
  font-size: 40rpx;
}
.assessment-entry-info {
  flex: 1;
  min-width: 0;
}
.assessment-entry-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #6c63ff;
  display: block;
}
.assessment-entry-desc {
  font-size: 18rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 2rpx;
}
.assessment-entry-arrow {
  font-size: 28rpx;
  color: #6c63ff;
}

/* ===== 快捷操作 ===== */
.quick-actions {
  display: flex;
  gap: 12rpx;
  padding: 0 16rpx 40rpx;
}

.quick-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: var(--bg-card-hover);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
}