.about-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-primary);
  overflow-y: auto;
}

.about-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
  gap: 8rpx;
}

.app-icon {
  font-size: 100rpx;
  margin-bottom: 8rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #6c63ff, #a78bfa);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-family: 'Georgia', serif;
}

.app-version {
  font-size: 22rpx;
  color: var(--text-muted);
}

.app-desc {
  font-size: 24rpx;
  color: var(--text-dim);
}

.features-section {
  flex: 1;
  padding: 0 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  display: block;
}

.feature-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  margin-bottom: 8rpx;
  background: var(--bg-card);
  border-radius: 12rpx;
  border: 1px solid var(--border-color-light);
}

.feature-icon {
  font-size: 40rpx;
  width: 56rpx;
  text-align: center;
}

.feature-info {
  flex: 1;
}

.feature-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
}

.feature-desc {
  font-size: 20rpx;
  color: var(--text-muted);
  display: block;
}

.about-footer {
  text-align: center;
  padding: 40rpx 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.footer-text {
  font-size: 18rpx;
  color: var(--text-dim);
}

.footer-copy {
  font-size: 16rpx;
  color: var(--text-placeholder);
  margin-top: 8rpx;
}