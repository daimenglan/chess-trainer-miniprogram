.login-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--bg-primary);
  overflow: hidden;
  position: relative;
}

.login-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.float-piece {
  position: absolute;
  color: #fff;
  animation: floatUp 8s ease-in-out infinite;
}

@keyframes floatUp {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-20rpx) rotate(10deg); }
}

.login-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 44rpx 40rpx;
  width: 640rpx;
  max-width: 90vw;
  background: rgba(26, 26, 46, 0.96);
  border: 1px solid var(--border-color-strong);
  border-radius: 24rpx;
  z-index: 1;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
}

.login-header {
  text-align: center;
  margin-bottom: 36rpx;
}

.logo-text {
  font-size: 48rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #6c63ff, #a78bfa);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-family: 'Georgia', serif;
}

.logo-sub {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
  display: block;
}

.form {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.form-header {
  text-align: center;
  margin-bottom: 8rpx;
}

.form-header-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 6rpx;
}

.form-header-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  display: block;
  line-height: 1.5;
}

.error-msg {
  font-size: 20rpx;
  color: var(--danger);
  text-align: center;
  padding: 8rpx;
}

.submit-btn {
  text-align: center;
  padding: 18rpx;
  background: var(--accent-gradient);
  border-radius: 12rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 20rpx rgba(108, 99, 255, 0.3);
  margin-top: 4rpx;
}

.submit-btn:active {
  transform: scale(0.97);
}

.btn-loading {
  opacity: 0.7;
}

/* ===== 微信一键登录按钮 ===== */
.wechat-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  background: rgba(7, 193, 96, 0.12);
  border: 1px solid rgba(7, 193, 96, 0.45);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 600;
  transition: all 0.2s;
}

.wechat-login-btn:active {
  transform: scale(0.97);
  background: rgba(7, 193, 96, 0.22);
}

.wechat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  background: #07c160;
  border-radius: 50%;
  flex-shrink: 0;
}

.wechat-icon-text {
  font-size: 20rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1;
}

/* ===== scheme 拉起落地 / web-view 唤起状态遮罩 ===== */
.wx-landing-mask {
  position: fixed;
  inset: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-primary);
}

.wx-landing-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 44rpx;
  width: 560rpx;
  max-width: 84vw;
  text-align: center;
}

.wx-landing-spinner {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 24rpx;
  border: 5rpx solid var(--border-color);
  border-top-color: #07c160;
  border-radius: 50%;
  animation: wxSpin 0.9s linear infinite;
}

@keyframes wxSpin {
  to { transform: rotate(360deg); }
}

.wx-landing-emoji {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.wx-landing-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}

.wx-landing-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.5;
}

.wx-landing-btn {
  width: 100%;
  margin-top: 28rpx;
}

/* ===== 顶部返回栏：允许用户取消登录 ===== */
.login-back-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 5;
  padding: 28rpx 24rpx 0;
  display: flex;
  align-items: flex-start;
}

.login-back-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  background: rgba(26, 26, 46, 0.85);
  border: 1px solid var(--border-color-strong);
  border-radius: 30rpx;
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  transition: all 0.2s;
}

.login-back-btn:active {
  background: rgba(26, 26, 46, 0.95);
  transform: scale(0.96);
}

.login-back-icon {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1;
}

.login-back-btn text {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 600;
}

/* ===== 取消/拒绝登录按钮（显著可见，不强制登录） ===== */
.cancel-login-btn {
  margin-top: 18rpx;
  padding: 16rpx 24rpx;
  text-align: center;
  border: 1px solid var(--border-color-strong);
  border-radius: 12rpx;
  background: transparent;
  transition: all 0.2s;
}

.cancel-login-btn:active {
  background: rgba(255, 255, 255, 0.06);
  transform: scale(0.97);
}

.cancel-login-btn text {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 500;
}

/* ===== 用户协议与隐私政策授权 ===== */
.agreement-row {
  display: flex;
  align-items: flex-start;
  width: 100%;
  margin-top: 24rpx;
  padding: 0 8rpx;
}

.agreement-checkbox {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  margin: 2rpx 14rpx 0 0;
  border: 2rpx solid var(--border-color-strong);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.agreement-checkbox.checked {
  background: #6c63ff;
  border-color: #6c63ff;
}

.agreement-check-icon {
  font-size: 20rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1;
}

.agreement-text {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.6;
}

.agreement-link {
  color: #6c63ff;
}
