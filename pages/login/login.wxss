.login-page {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-primary);
  overflow: hidden;
  position: relative;
}

.login-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.float-piece {
  position: absolute;
  color: #fff;
  animation: floatUp 8s ease-in-out infinite;
}

@keyframes floatUp {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-20rpx) rotate(10deg); }
}

.login-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 40rpx;
  width: 520rpx;
  max-width: 85vw;
  background: rgba(26, 26, 46, 0.95);
  border: 1px solid var(--border-color);
  z-index: 1;
}

.login-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.logo-text {
  font-size: 48rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #6c63ff, #a78bfa);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-family: 'Georgia', serif;
}

.logo-sub {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
  display: block;
}

.mode-tabs {
  display: flex;
  background: var(--bg-card-hover);
  border-radius: 12rpx;
  padding: 4rpx;
  margin-bottom: 24rpx;
  width: 100%;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 500;
  transition: all 0.2s;
}

.mode-active {
  background: var(--accent-bg);
  color: var(--accent);
  font-weight: 700;
}

.form {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.form-input::placeholder {
  color: var(--text-placeholder);
}

.error-msg {
  font-size: 20rpx;
  color: var(--danger);
  text-align: center;
  padding: 8rpx;
}

.submit-btn {
  text-align: center;
  padding: 18rpx;
  background: var(--accent-gradient);
  border-radius: 12rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 20rpx rgba(108, 99, 255, 0.3);
}

.submit-btn:active {
  transform: scale(0.97);
}

.btn-loading {
  opacity: 0.7;
}

/* ===== 忘记密码 ===== */
.forgot-link {
  font-size: 22rpx;
  color: var(--accent);
  text-align: right;
  padding: 0 4rpx;
  margin-top: -6rpx;
  cursor: pointer;
}

.forgot-link:active {
  opacity: 0.7;
}

.form-header {
  text-align: center;
  margin-bottom: 8rpx;
}

.form-header-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 6rpx;
}

.form-header-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  display: block;
  line-height: 1.5;
}

.code-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.code-input {
  flex: 1;
}

.send-code-btn {
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  background: var(--accent-bg);
  border: 1px solid var(--accent-border);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 600;
  white-space: nowrap;
  text-align: center;
  min-width: 140rpx;
}

.send-code-btn:active {
  opacity: 0.7;
}

.code-btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.back-link {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
  padding: 8rpx;
  cursor: pointer;
}

.back-link:active {
  opacity: 0.7;
}
