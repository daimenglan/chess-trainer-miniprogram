<view class="login-page {{__theme__ ? 'theme-' + __theme__ : ''}}">
  <view class="login-bg">
    <view wx:for="{{floatPieces}}" wx:key="ch"
          class="float-piece" style="left: {{item.left}}%; top: {{item.top}}%;
          font-size: {{item.size}}rpx; opacity: 0.06; animation-delay: {{item.delay}}s;">
      <text>{{item.ch}}</text>
    </view>
  </view>

  <!-- ===== scheme 拉起落地 / web-view 唤起：自动登录状态遮罩 ===== -->
  <view wx:if="{{wxLanding}}" class="wx-landing-mask">
    <view class="wx-landing-card glass-strong">
      <block wx:if="{{wxStatus === 'loading'}}">
        <view class="wx-landing-spinner"></view>
        <text class="wx-landing-title">正在登录</text>
        <text class="wx-landing-desc">正在使用微信身份登录，请稍候…</text>
      </block>
      <block wx:elif="{{wxStatus === 'success'}}">
        <text class="wx-landing-emoji">✅</text>
        <text class="wx-landing-title">登录成功</text>
        <text class="wx-landing-desc">{{wxMessage}}</text>
      </block>
      <block wx:else>
        <text class="wx-landing-emoji">⚠️</text>
        <text class="wx-landing-title">登录失败</text>
        <text class="wx-landing-desc">{{wxMessage}}</text>
        <view class="submit-btn wx-landing-btn" catchtap="onWeChatRetry">
          <text>重试</text>
        </view>
      </block>
    </view>
  </view>

  <view class="login-card glass-strong">
    <view class="login-header">
      <text class="logo-text">Mychess</text>
      <text class="logo-sub">国际象棋陪练</text>
    </view>

    <view class="form">
      <!-- 引导说明：小程序内只用微信授权，未注册将自动创建账号 -->
      <view class="form-header">
        <text class="form-header-title">🔑 微信登录</text>
        <text class="form-header-desc">点击下方按钮使用微信授权登录，未注册的手机号将自动创建账号</text>
      </view>

      <view wx:if="{{error}}" class="error-msg">{{error}}</view>

      <view class="wechat-login-btn {{loading ? 'btn-loading' : ''}}" catchtap="onWeChatLogin">
        <view class="wechat-icon"><text class="wechat-icon-text">微</text></view>
        <text>{{loading ? '登录中...' : '微信一键登录'}}</text>
      </view>
    </view>

    <!-- ===== 用户协议与隐私政策授权 ===== -->
    <view class="agreement-row">
      <view class="agreement-checkbox {{agreed ? 'checked' : ''}}" catchtap="onToggleAgreement">
        <text wx:if="{{agreed}}" class="agreement-check-icon">✓</text>
      </view>
      <view class="agreement-text">
        <text>我已阅读并同意</text>
        <text class="agreement-link" catchtap="onOpenAgreement" data-doc="service">《用户服务协议》</text>
        <text>和</text>
        <text class="agreement-link" catchtap="onOpenAgreement" data-doc="privacy">《隐私政策》</text>
      </view>
    </view>
  </view>

  <!-- AI生成内容免责声明 -->
  <view class="ai-disclaimer"><text>本服务为AI生成内容，结果仅供参考</text></view>
</view>
