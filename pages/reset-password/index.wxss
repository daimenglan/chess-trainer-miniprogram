.page { background: var(--bg-page, #0f0f23); color: var(--text-primary, #e8e8f0); min-height: 100vh; }
.nav-bar { display: flex; align-items: center; padding: 24rpx 32rpx; background: var(--bg-card, #1a1a2e); border-bottom: 1rpx solid var(--border-color, #2a2a4a); position: sticky; top: 0; z-index: 100; }
.nav-back { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 20rpx; border-radius: 12rpx; background: var(--bg-hover, #252545); margin-right: 24rpx; }
.nav-back-icon { font-size: 32rpx; color: var(--text-primary, #e8e8f0); }
.nav-back-text { font-size: 26rpx; color: var(--text-primary, #e8e8f0); }
.nav-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); flex: 1; }
.reset-container { padding: 40rpx 32rpx; height: calc(100vh - 100rpx); display: flex; flex-direction: column; }
.reset-step { display: flex; flex-direction: column; }
.step-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); text-align: center; margin-bottom: 12rpx; }
.step-desc { font-size: 24rpx; color: var(--text-secondary, #a0a0c0); text-align: center; margin-bottom: 32rpx; }
.input-field { width: 100%; padding: 20rpx 24rpx; background: var(--bg-input, #15152a); border-radius: 12rpx; border: 1rpx solid var(--border-color, #2a2a4a); color: var(--text-primary, #e8e8f0); font-size: 28rpx; margin-bottom: 16rpx; }
.code-input { text-align: center; letter-spacing: 4rpx; }
.placeholder { color: var(--text-muted, #666); }
.submit-btn { margin-top: 12rpx; padding: 22rpx; background: linear-gradient(135deg, #6c63ff, #8b8bff); border-radius: 12rpx; text-align: center; }
.submit-btn-text { font-size: 28rpx; font-weight: 700; color: #fff; }
.resend { text-align: center; margin-top: 20rpx; }
.resend-text { font-size: 22rpx; color: var(--text-muted, #888); }
.resend-link { font-size: 22rpx; color: var(--accent, #6c63ff); }
.error-tip { margin-top: 16rpx; padding: 16rpx; background: rgba(239, 68, 68, 0.1); border-radius: 12rpx; border: 1rpx solid rgba(239, 68, 68, 0.3); }
.error-tip text { font-size: 24rpx; color: #ef4444; }