.daily-challenge-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  padding: 24rpx;
  background: var(--bg-primary);
}

.dc-loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-muted);
}

/* 错误态：文案与操作按钮竖排居中（.dc-loading 默认横排） */
.dc-error {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding: 0 40rpx;
}

.dc-error-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.7;
}

.dc-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.dc-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
}

.dc-subtitle {
  font-size: 24rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 8rpx;
}

.dc-info-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.dc-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1px solid var(--border-color);
}

.dc-info-row:last-child { border-bottom: none; }

.dc-label {
  font-size: 26rpx;
  color: var(--text-muted);
}

.dc-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.dc-themes {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}

.dc-theme-tag {
  font-size: 22rpx;
  color: var(--accent);
  background: var(--accent);
  background-opacity: 0.1;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.dc-summary-card {
  background: rgba(74, 222, 128, 0.1);
  border: 1px solid rgba(74, 222, 128, 0.3);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.dc-summary-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #4ade80;
  display: block;
  margin-bottom: 12rpx;
}

.dc-summary-row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
  font-size: 24rpx;
  color: var(--text-primary);
}

.dc-start-btn {
  width: 100%;
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #6366f1, #ec4899);
  border-radius: 20rpx;
  border: none;
}

.dc-playing {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
}

.dc-timer-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.dc-timer {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--accent);
  font-family: monospace;
}

.dc-move-count {
  font-size: 26rpx;
  color: var(--text-muted);
}

.dc-board-wrap {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dc-board-wrap chess-board {
  width: 100%;
  height: 100%;
  max-width: 100%;
  max-height: 100%;
}

.dc-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.dc-action-btn {
  flex: 1;
  padding: 20rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 14rpx;
}

.dc-summary {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
}

.dc-summary-card-full {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
  width: 100%;
  max-width: 600rpx;
}

.dc-summary-emoji {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}

.dc-summary-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 28rpx;
}

.dc-summary-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
}

.dc-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dc-stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.dc-stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.dc-streak-badge {
  font-size: 26rpx;
  color: #f59e0b;
  font-weight: 600;
  margin-bottom: 28rpx;
  display: block;
}

.dc-summary-btn {
  width: 100%;
  padding: 22rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #6366f1, #ec4899);
  border-radius: 14rpx;
  border: none;
  margin-bottom: 12rpx;
}

.dc-summary-btn.secondary {
  color: var(--text-primary);
  background: var(--bg-card);
  border: 1px solid var(--border-color);
}