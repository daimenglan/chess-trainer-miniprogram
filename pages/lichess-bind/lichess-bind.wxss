.bind-page {
  min-height: 100vh;
  background: var(--bg-primary);
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ===== 已绑定卡片 ===== */
.bound-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 20rpx;
  padding: 24rpx;
}

.bound-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.bound-avatar-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--bg-card-hover);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.bound-avatar {
  width: 100%;
  height: 100%;
}

.bound-avatar-fallback {
  font-size: 40rpx;
}

.bound-info {
  flex: 1;
  min-width: 0;
}

.bound-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.bound-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.bound-title {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--purple);
  background: var(--purple-bg);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}

.bound-tag {
  font-size: 18rpx;
  color: var(--text-dim);
  margin-left: auto;
}

.bound-perf-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.bound-games {
  color: var(--text-dim);
}

.bound-status {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--success);
  background: var(--success-bg);
  border-radius: 10rpx;
  padding: 12rpx 18rpx;
}

.bind-actions {
  display: flex;
}

.btn-secondary {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  border-radius: 16rpx;
  padding: 22rpx 0;
}

.btn-secondary:active {
  opacity: 0.7;
}

.rebind-hint {
  font-size: 22rpx;
  color: var(--text-dim);
  text-align: center;
}

/* ===== 引导说明 ===== */
.guide-card {
  background: var(--bg-card);
  border: 1px solid var(--accent-border);
  border-radius: 20rpx;
  padding: 24rpx;
}

.guide-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.guide-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.step-item {
  display: flex;
  gap: 16rpx;
}

.step-num {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--accent-bg);
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
  line-height: 40rpx;
}

.step-body {
  flex: 1;
  min-width: 0;
}

.step-text {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.step-btn {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--accent);
  background: var(--accent-bg);
  border-radius: 10rpx;
  padding: 8rpx 20rpx;
}

.step-btn:active {
  opacity: 0.7;
}

.step-url {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--text-dim);
  word-break: break-all;
  line-height: 1.5;
}

.step-scope {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--success);
  background: var(--success-bg);
  border-radius: 8rpx;
  padding: 8rpx 14rpx;
  font-family: monospace;
}

/* ===== 输入区 ===== */
.input-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 20rpx;
  padding: 24rpx;
}

.input-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 14rpx;
}

.token-input {
  width: 100%;
  min-height: 120rpx;
  background: var(--bg-input);
  border: 1px solid var(--border-color);
  border-radius: 14rpx;
  padding: 18rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

.token-placeholder {
  color: var(--text-placeholder);
  font-size: 24rpx;
}

.error-text {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--danger);
  line-height: 1.5;
}

.btn-primary {
  margin-top: 22rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: var(--accent-gradient);
  border-radius: 16rpx;
  padding: 24rpx 0;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-disabled {
  opacity: 0.6;
}

.safety-hint {
  font-size: 20rpx;
  color: var(--text-dim);
  line-height: 1.6;
  padding: 0 8rpx;
}

/* ===== OAuth 主路径 ===== */
.oauth-benefit {
  font-size: 22rpx;
  color: var(--success);
  background: var(--success-bg);
  border-radius: 10rpx;
  padding: 12rpx 18rpx;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.oauth-waiting {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--accent);
  background: var(--accent-bg);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  text-align: center;
}

/* ===== 备用路径折叠入口 ===== */
.faq-toggle {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
  padding: 8rpx 0;
}

.faq-toggle:active {
  opacity: 0.7;
}
