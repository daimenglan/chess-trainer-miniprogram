<view class="admin-page theme-{{__theme__}}">
  <scroll-view scroll-y class="page-body">
    <view class="page-header"><text class="page-title">分销设置</text></view>
    <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
    <view class="settings-group">
      <view class="settings-item">
        <text class="settings-label">启用分销系统</text>
        <switch checked="{{settings.enabled}}" color="#6c63ff" bindchange="onEnabledChange" />
      </view>
      <view class="settings-item">
        <text class="settings-label">默认佣金比例 (%)</text>
        <input class="input-field" value="{{settings.defaultCommissionRate}}" bindinput="onRateInput" placeholder="10" placeholder-class="placeholder" type="number" />
      </view>
      <view class="settings-item">
        <text class="settings-label">最低提现金额</text>
        <input class="input-field" value="{{settings.minWithdrawal}}" bindinput="onMinInput" placeholder="10" placeholder-class="placeholder" type="number" />
      </view>
    </view>
    <view class="btn-row">
      <view class="btn primary" catchtap="onSave"><text class="btn-text">保存设置</text></view>
    </view>
  <!-- AI生成内容免责声明 -->
  <view class="ai-disclaimer"><text>本服务为AI生成、人工智能生成内容，结果仅供参考</text></view>
  </scroll-view>
</view>