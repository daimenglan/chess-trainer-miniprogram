.admin-page { background: var(--bg-page, #0f0f23); color: var(--text-primary, #e8e8f0); min-height: 100vh; }
.page-body { padding: 24rpx 32rpx; }
.page-header { margin-bottom: 24rpx; }
.page-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); }
.detail-card { background: var(--bg-card, #1a1a2e); border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; border: 1rpx solid var(--border-color, #2a2a4a); }
.detail-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); display: block; margin-bottom: 8rpx; }
.detail-desc { font-size: 24rpx; color: var(--text-secondary, #a0a0c0); display: block; margin-bottom: 8rpx; }
.detail-info { font-size: 22rpx; color: var(--text-muted, #888); display: block; margin-bottom: 6rpx; }
.btn-row { display: flex; gap: 16rpx; }
.btn { flex: 1; padding: 22rpx; border-radius: 12rpx; background: var(--bg-hover, #252545); text-align: center; }
.btn-text { font-size: 28rpx; font-weight: 600; color: var(--text-primary, #e8e8f0); }
.loading-tip { text-align: center; color: var(--text-muted, #888); font-size: 24rpx; padding: 40rpx 0; }