<view class="admin-page theme-{{__theme__}}">
  <scroll-view scroll-y class="page-body">
    <view class="page-header">
      <text class="page-title">棋谱管理</text>
    </view>
    <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
    <view wx:for="{{games}}" class="item-card" catchtap="onGameDetail" data-index="{{index}}">
      <view class="item-row">
        <text class="item-name">{{item.whiteName || '白方'}} vs {{item.blackName || '黑方'}}</text>
        <text class="item-result">{{item.result || ''}}</text>
      </view>
      <text class="item-desc">{{item.date || ''}} · {{item.moves ? item.moves.length + '步' : '无数据'}}</text>
      <view class="item-actions">
        <view class="action-btn danger" catchtap="onDeleteGame" data-index="{{index}}"><text>删除</text></view>
      </view>
    </view>
    <view wx:if="{{games.length === 0 && !loading}}" class="empty-tip">暂无棋谱</view>
  <!-- AI生成内容免责声明 -->
  <view class="ai-disclaimer"><text>本服务为AI生成、人工智能生成内容，结果仅供参考</text></view>
  </scroll-view>
</view>