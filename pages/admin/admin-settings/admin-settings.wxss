.admin-page { background: var(--bg-page, #0f0f23); color: var(--text-primary, #e8e8f0); min-height: 100vh; }
.page-body { padding: 24rpx 32rpx; }
.page-header { margin-bottom: 24rpx; }
.page-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); }
.settings-group { display: flex; flex-direction: column; gap: 16rpx; }
.settings-item { display: flex; align-items: center; justify-content: space-between; padding: 20rpx; background: var(--bg-card, #1a1a2e); border-radius: 12rpx; }
.settings-label { font-size: 26rpx; color: var(--text-primary, #e8e8f0); }
.btn-row { margin-top: 32rpx; }
.btn { padding: 22rpx; border-radius: 12rpx; background: var(--bg-hover, #252545); text-align: center; }
.btn.primary { background: var(--accent, #6c63ff); }
.btn-text { font-size: 28rpx; font-weight: 600; color: #fff; }
.loading-tip { text-align: center; color: var(--text-muted, #888); font-size: 24rpx; padding: 40rpx 0; }