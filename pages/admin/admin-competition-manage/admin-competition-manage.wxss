.admin-page { background: var(--bg-page, #0f0f23); color: var(--text-primary, #e8e8f0); min-height: 100vh; }
.page-body { padding: 24rpx 32rpx; }
.page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.page-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); }
.add-btn { padding: 12rpx 20rpx; background: var(--accent, #6c63ff); border-radius: 12rpx; }
.add-btn-text { font-size: 26rpx; color: #fff; font-weight: 600; }
.detail-card { background: var(--bg-card, #1a1a2e); border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; border: 1rpx solid var(--border-color, #2a2a4a); }
.detail-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); display: block; margin-bottom: 8rpx; }
.detail-desc { font-size: 24rpx; color: var(--text-secondary, #a0a0c0); display: block; margin-bottom: 8rpx; }
.detail-info { font-size: 22rpx; color: var(--text-muted, #888); }
.section-title { font-size: 26rpx; font-weight: 600; color: var(--text-secondary, #a0a0c0); margin: 24rpx 0 16rpx; }
.item-card { background: var(--bg-card, #1a1a2e); border-radius: 12rpx; padding: 20rpx; margin-bottom: 12rpx; border: 1rpx solid var(--border-color, #2a2a4a); }
.item-row { display: flex; align-items: center; justify-content: space-between; }
.item-name { font-size: 26rpx; color: var(--text-primary, #e8e8f0); }
.item-amount { font-size: 24rpx; color: var(--accent, #6c63ff); font-weight: 600; }
.loading-tip, .empty-tip { text-align: center; color: var(--text-muted, #888); font-size: 24rpx; padding: 40rpx 0; }