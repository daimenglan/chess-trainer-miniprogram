<view class="admin-page theme-{{__theme__}}">
  <scroll-view scroll-y class="page-body">
    <view class="page-header"><text class="page-title">分销商管理</text></view>
    <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
    <view wx:for="{{distributors}}" class="item-card">
      <view class="item-row">
        <text class="item-name">{{item.userNickname || '用户'}}</text>
        <text class="item-status" wx:if="{{item.status === 'active'}}">启用</text>
        <text class="item-status disabled" wx:else>禁用</text>
      </view>
      <text class="item-desc">等级：{{item.level || '-'}} · 佣金：{{item.commissionRate || 0}}%</text>
    </view>
    <view wx:if="{{distributors.length === 0 && !loading}}" class="empty-tip">暂无分销商</view>
  <!-- AI生成内容免责声明 -->
  <view class="ai-disclaimer"><text>本服务为AI生成、人工智能生成内容，结果仅供参考</text></view>
  </scroll-view>
</view>