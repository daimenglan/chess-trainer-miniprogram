<view class="admin-page theme-{{__theme__}}">
  <scroll-view scroll-y class="page-body">
    <view class="page-header">
      <text class="page-title">竞赛管理</text>
      <view class="add-btn" catchtap="onCreate"><text class="add-btn-text">+ 创建</text></view>
    </view>
    <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
    <view wx:for="{{competitions}}" class="item-card">
      <view class="item-row">
        <text class="item-name">{{item.title}}</text>
        <text class="item-status" wx:if="{{item.status === 'active' || item.status === 'registration'}}">进行中</text>
        <text class="item-status disabled" wx:else>已结束</text>
      </view>
      <text class="item-desc">{{item.description || '无描述'}} · {{item.participants || 0}}人参与</text>
      <view class="item-actions">
        <view class="action-row">
          <text class="action-label">邀请制</text>
          <view class="toggle-btn {{item.invitationOnly ? 'on' : 'off'}}" catchtap="onToggleInvite" data-index="{{index}}">
            <view class="toggle-knob"></view>
          </view>
        </view>
      </view>
      <view class="item-actions">
        <view class="action-btn" catchtap="onEdit" data-index="{{index}}"><text>编辑</text></view>
        <view class="action-btn danger" catchtap="onDelete" data-index="{{index}}"><text>删除</text></view>
      </view>
    </view>
    <view wx:if="{{competitions.length === 0 && !loading}}" class="empty-tip">暂无竞赛</view>
  <!-- AI生成内容免责声明 -->
  <view class="ai-disclaimer"><text>本服务为AI生成、人工智能生成内容，结果仅供参考</text></view>
  </scroll-view>
</view>