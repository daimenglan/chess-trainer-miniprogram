<view class="admin-page theme-{{__theme__}}">
  <scroll-view scroll-y class="page-body">
    <view class="page-header">
      <text class="page-title">AI Bot 管理</text>
      <view class="add-btn" catchtap="onCreateBot"><text class="add-btn-text">+ 新建</text></view>
    </view>
    <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
    <view wx:for="{{bots}}" class="item-card">
      <view class="item-row">
        <text class="item-name">{{item.name}}</text>
        <view class="toggle-btn {{item.enabled ? 'on' : 'off'}}" catchtap="onToggleBot" data-index="{{index}}">
          <view class="toggle-knob"></view>
        </view>
      </view>
      <text class="item-desc">{{item.description || '无描述'}}</text>
      <view class="item-actions">
        <view class="action-btn" catchtap="onEditBot" data-index="{{index}}"><text>编辑</text></view>
        <view class="action-btn danger" catchtap="onDeleteBot" data-index="{{index}}"><text>删除</text></view>
      </view>
    </view>
    <view wx:if="{{bots.length === 0 && !loading}}" class="empty-tip">暂无 AI Bot</view>
  </scroll-view>
</view>