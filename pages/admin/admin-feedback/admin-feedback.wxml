<view class="admin-page theme-{{__theme__}}">
  <scroll-view scroll-y class="page-body">
    <view class="page-header"><text class="page-title">反馈管理</text></view>
    <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
    <view wx:for="{{feedbacks}}" class="item-card">
      <view class="item-row">
        <text class="item-name">{{item.userNickname || '用户'}}</text>
        <text class="item-status" wx:if="{{item.status === 'replied'}}">已回复</text>
        <text class="item-status disabled" wx:else>待处理</text>
      </view>
      <text class="item-desc">{{item.content}}</text>
      <text class="item-reply" wx:if="{{item.reply}}">回复：{{item.reply}}</text>
      <view class="item-actions" wx:if="{{item.status !== 'replied'}}">
        <view class="action-btn" catchtap="onReply" data-index="{{index}}"><text>回复</text></view>
      </view>
    </view>
    <view wx:if="{{feedbacks.length === 0 && !loading}}" class="empty-tip">暂无反馈</view>
  </scroll-view>
</view>