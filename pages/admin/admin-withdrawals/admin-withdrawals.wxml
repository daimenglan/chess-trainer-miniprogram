<view class="admin-page theme-{{__theme__}}">
  <scroll-view scroll-y class="page-body">
    <view class="page-header"><text class="page-title">提现管理</text></view>
    <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
    <view wx:for="{{withdrawals}}" class="item-card">
      <view class="item-row">
        <text class="item-name">{{item.userNickname || '用户'}}</text>
        <text class="item-amount">¥{{item.amount || 0}}</text>
      </view>
      <text class="item-desc">{{item.status === 'pending' ? '待处理' : item.status === 'approved' ? '已批准' : item.status === 'completed' ? '已完成' : '已拒绝'}} · {{item.createdAt || ''}}</text>
      <view class="item-actions" wx:if="{{item.status === 'pending'}}">
        <view class="action-btn success" catchtap="onApprove" data-index="{{index}}"><text>批准</text></view>
        <view class="action-btn danger" catchtap="onReject" data-index="{{index}}"><text>拒绝</text></view>
      </view>
      <view class="item-actions" wx:if="{{item.status === 'approved'}}">
        <view class="action-btn" catchtap="onComplete" data-index="{{index}}"><text>完成</text></view>
      </view>
    </view>
    <view wx:if="{{withdrawals.length === 0 && !loading}}" class="empty-tip">暂无提现申请</view>
  <!-- AI生成内容免责声明 -->
  <view class="ai-disclaimer"><text>本服务为AI生成、人工智能生成内容，结果仅供参考</text></view>
  </scroll-view>
</view>