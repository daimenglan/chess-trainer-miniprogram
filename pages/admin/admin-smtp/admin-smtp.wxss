.admin-page { background: var(--bg-page, #0f0f23); color: var(--text-primary, #e8e8f0); min-height: 100vh; }
.page-body { padding: 24rpx 32rpx; }
.page-header { margin-bottom: 24rpx; }
.page-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); }
.form-group { display: flex; flex-direction: column; gap: 16rpx; }
.form-label { font-size: 24rpx; color: var(--text-secondary, #a0a0c0); }
.input-field { padding: 20rpx; background: var(--bg-input, #15152a); border-radius: 12rpx; border: 1rpx solid var(--border-color, #2a2a4a); color: var(--text-primary, #e8e8f0); font-size: 28rpx; }
.placeholder { color: var(--text-muted, #666); }
.btn-row { display: flex; gap: 16rpx; margin-top: 32rpx; }
.btn { flex: 1; padding: 22rpx; border-radius: 12rpx; background: var(--bg-hover, #252545); text-align: center; }
.btn.primary { background: var(--accent, #6c63ff); }
.btn-text { font-size: 28rpx; font-weight: 600; color: #fff; }
.loading-tip { text-align: center; color: var(--text-muted, #888); font-size: 24rpx; padding: 40rpx 0; }