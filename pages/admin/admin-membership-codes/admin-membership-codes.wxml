<view class="admin-page theme-{{__theme__}}">
  <scroll-view scroll-y class="page-body">
    <view class="page-header">
      <text class="page-title">会员兑换码</text>
      <view class="add-btn" catchtap="onGenerate"><text class="add-btn-text">+ 生成</text></view>
    </view>
    <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
    <view wx:for="{{codes}}" class="item-card">
      <view class="item-row">
        <text class="item-name">{{item.code}}</text>
        <text class="item-status" wx:if="{{item.status === 'active'}}">可用</text>
        <text class="item-status disabled" wx:else>已使用/禁用</text>
      </view>
      <text class="item-desc">天数：{{item.days || 0}}天 · 创建：{{item.createdAt || ''}}</text>
      <view class="item-actions" wx:if="{{item.status === 'active'}}">
        <view class="action-btn danger" catchtap="onDisable" data-index="{{index}}"><text>禁用</text></view>
      </view>
    </view>
    <view wx:if="{{codes.length === 0 && !loading}}" class="empty-tip">暂无兑换码</view>
  </scroll-view>
</view>