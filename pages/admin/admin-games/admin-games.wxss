.admin-page { background: var(--bg-page, #0f0f23); color: var(--text-primary, #e8e8f0); min-height: 100vh; }
.page-body { padding: 24rpx 32rpx; }
.page-header { margin-bottom: 24rpx; }
.page-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); }
.item-card { background: var(--bg-card, #1a1a2e); border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; border: 1rpx solid var(--border-color, #2a2a4a); }
.item-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.item-name { font-size: 28rpx; font-weight: 600; color: var(--text-primary, #e8e8f0); }
.item-result { font-size: 22rpx; color: var(--text-secondary, #a0a0c0); }
.item-desc { font-size: 22rpx; color: var(--text-secondary, #a0a0c0); margin-bottom: 12rpx; }
.loading-tip, .empty-tip { text-align: center; color: var(--text-muted, #888); font-size: 24rpx; padding: 40rpx 0; }