.settings-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-primary);
  overflow: hidden;
}

/* ===== 竖屏模式：头部（同网页版 glass） ===== */
.page-header {
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

/* ===== 竖屏模式：设置区块（同网页版 glass rounded-2xl p-5） ===== */
.setting-section {
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 20rpx;
  padding: 20rpx;
  position: relative;
  overflow: hidden;
}

/* 顶部渐变装饰线（同网页版 absolute top-0 h-1 bg-gradient-accent） */
.setting-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, var(--accent), var(--purple));
}

.page-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.settings-content {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx;
}

.setting-section {
  margin-bottom: 24rpx;
  background: var(--bg-card);
  border-radius: 12rpx;
  padding: 16rpx;
}

.section-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  display: block;
}

/* 主题切换开关 */
.theme-switch-row {
  display: flex;
  gap: 12rpx;
}

.theme-switch-opt {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 10rpx;
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  font-size: 22rpx;
  color: var(--text-muted);
}

.theme-switch-active {
  background: var(--accent-bg);
  border-color: var(--accent);
  color: var(--accent);
  font-weight: 700;
}

.theme-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.theme-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx;
  border-radius: 10rpx;
  background: var(--bg-card);
  border: 1px solid var(--border-color-light);
  min-width: 100rpx;
}

.theme-item:active {
  background: var(--accent-bg-light);
}

.theme-active {
  border-color: var(--accent);
  background: var(--accent-bg-light);
}

.theme-preview {
  display: flex;
  gap: 2rpx;
  width: 60rpx;
  height: 60rpx;
  overflow: hidden;
  border-radius: 6rpx;
}

.theme-square {
  width: 50%;
  height: 100%;
}

.theme-label {
  font-size: 18rpx;
  color: var(--text-dim);
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1px solid var(--border-color-light);
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.arrow {
  font-size: 20rpx;
  color: var(--text-muted);
}

.slider-marks {
  display: flex;
  justify-content: space-between;
  font-size: 14rpx;
  color: var(--text-placeholder);
  margin-top: -8rpx;
}

.password-form {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1px solid var(--border-color-light);
}

.form-input {
  height: 72rpx;
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  color: var(--text-primary);
}

.error-msg {
  font-size: 18rpx;
  color: var(--danger);
  text-align: center;
}

.submit-btn {
  text-align: center;
  padding: 14rpx;
  background: var(--accent-gradient);
  border-radius: 8rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

.btn-loading {
  opacity: 0.7;
}