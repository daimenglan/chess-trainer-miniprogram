.page {
  background: var(--bg-page, #0f0f23);
  color: var(--text-primary, #e8e8f0);
  min-height: 100vh;
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--bg-card, #1a1a2e);
  border-bottom: 1rpx solid var(--border-color, #2a2a4a);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: var(--bg-hover, #252545);
  margin-right: 24rpx;
}

.nav-back-icon { font-size: 32rpx; color: var(--text-primary, #e8e8f0); }
.nav-back-text { font-size: 26rpx; color: var(--text-primary, #e8e8f0); }
.nav-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); flex: 1; }

.scroll-content { padding: 24rpx 32rpx; height: calc(100vh - 100rpx); }

.puzzle-container {
  background: var(--bg-card, #1a1a2e);
  border-radius: 20rpx;
  padding: 32rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
}

.puzzle-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); display: block; margin-bottom: 12rpx; }
.puzzle-desc { font-size: 24rpx; color: var(--text-secondary, #a0a0c0); display: block; margin-bottom: 28rpx; line-height: 1.5; }

.answer-section { display: flex; flex-direction: column; gap: 16rpx; }

.section-label { font-size: 24rpx; font-weight: 600; color: var(--text-secondary, #a0a0c0); display: block; margin-bottom: 12rpx; }

.answer-btn { padding: 24rpx; border-radius: 16rpx; text-align: center; }
.answer-btn.correct { background: rgba(34, 197, 94, 0.15); border: 1rpx solid #22c55e; }
.answer-btn.wrong { background: rgba(239, 68, 68, 0.15); border: 1rpx solid #ef4444; }
.answer-btn-text { font-size: 28rpx; font-weight: 600; color: #22c55e; display: block; }
.answer-btn.wrong .answer-btn-text { color: #ef4444; }

.result-section { margin-top: 28rpx; padding: 20rpx; background: var(--bg-input, #15152a); border-radius: 12rpx; border: 1rpx solid var(--border-color, #2a2a4a); }
.result-text { font-size: 24rpx; color: var(--text-primary, #e8e8f0); display: block; margin-bottom: 8rpx; }
.result-next { font-size: 22rpx; color: var(--text-secondary, #a0a0c0); display: block; }

.loading-tip { text-align: center; padding: 60rpx 32rpx; }
.loading-tip text { font-size: 24rpx; color: var(--text-muted, #666); }