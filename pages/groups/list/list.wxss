.page {
  background: var(--bg-page, #0f0f23);
  color: var(--text-primary, #e8e8f0);
  min-height: 100vh;
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--bg-card, #1a1a2e);
  border-bottom: 1rpx solid var(--border-color, #2a2a4a);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: var(--bg-hover, #252545);
  margin-right: 24rpx;
}

.nav-back-icon { font-size: 32rpx; color: var(--text-primary, #e8e8f0); }
.nav-back-text { font-size: 26rpx; color: var(--text-primary, #e8e8f0); }
.nav-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); flex: 1; }

.nav-add {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6c63ff, #8b8bff);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-add text { font-size: 28rpx; color: #fff; font-weight: 700; }

.scroll-content { padding: 24rpx 32rpx; height: calc(100vh - 100rpx); }

.group-list { display: flex; flex-direction: column; gap: 20rpx; }

.group-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--bg-card, #1a1a2e);
  border-radius: 20rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
}

.group-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6c63ff, #8b8bff);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.avatar-text { font-size: 32rpx; color: #fff; font-weight: 700; }

.group-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }

.group-name { font-size: 28rpx; font-weight: 600; color: var(--text-primary, #e8e8f0); }
.group-desc { font-size: 22rpx; color: var(--text-secondary, #a0a0c0); }
.group-meta { font-size: 20rpx; color: var(--text-muted, #888); margin-top: 4rpx; }

.group-arrow { font-size: 28rpx; color: var(--text-muted, #666); }

.empty-tip, .loading-tip { text-align: center; padding: 60rpx 32rpx; }
.empty-tip text, .loading-tip text { font-size: 24rpx; color: var(--text-muted, #666); }