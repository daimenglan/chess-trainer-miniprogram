<view class="page {{__theme__ ? 'theme-' + __theme__ : ''}}">
  <view class="nav-bar">
    <view class="nav-back" bindtap="onBack">
      <text class="nav-back-icon">←</text>
      <text class="nav-back-text">返回</text>
    </view>
    <text class="nav-title">群组</text>
    <view class="nav-add" bindtap="onCreateGroup">
      <text>＋</text>
    </view>
  </view>

  <scroll-view class="scroll-content" scroll-y="true">
    <view class="group-list">
      <view class="group-card" wx:for="{{groups}}" wx:key="id" bindtap="onGroupTap" data-id="{{item.id}}">
        <view class="group-avatar">
          <text class="avatar-text">{{item.name ? item.name.substring(0,1) : '?'}}</text>
        </view>
        <view class="group-info">
          <text class="group-name">{{item.name}}</text>
          <text class="group-desc">{{item.description || '暂无描述'}}</text>
          <text class="group-meta">👥 {{item.memberCount || 0}}人</text>
        </view>
        <view class="group-arrow">></view>
      </view>
      <view class="empty-tip" wx:if="{{groups.length === 0 && !loading}}">
        <text>暂无群组</text>
      </view>
      <view class="loading-tip" wx:if="{{loading}}">
        <text>加载中...</text>
      </view>
    </view>
  <!-- AI生成内容免责声明 -->
  <view class="ai-disclaimer"><text>本服务为AI生成内容，结果仅供参考</text></view>
  </scroll-view>
</view>