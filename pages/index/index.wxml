<view class="game-page {{__theme__ ? 'theme-' + __theme__ : ''}}">
  <!-- 游戏状态栏（右上功能下拉） -->
  <view class="status-bar">
    <view class="status-left"></view>
    <view class="status-center">
      <view class="status-item {{playerSide === 'w' ? 'status-active' : ''}}">
        <text class="status-label">白方</text>
        <text class="status-name">{{playerSide === 'w' ? '你' : 'AI'}}</text>
      </view>
      <view class="status-result">
        <text wx:if="{{offlineMode}}" class="offline-badge">离线</text>
        <text wx:if="{{gameOver}}">{{resultLabel}}</text>
        <text wx:elif="{{isAIThinking}}">AI 思考中...</text>
        <text wx:else>{{turn === 'w' ? '白方走棋' : '黑方走棋'}}</text>
      </view>
      <view class="status-item {{playerSide === 'b' ? 'status-active' : ''}}">
        <text class="status-label">黑方</text>
        <text class="status-name">{{playerSide === 'b' ? '你' : 'AI'}}</text>
      </view>
    </view>
    <!-- 右上角功能下拉按钮 -->
    <view class="status-right">
      <view class="more-btn" catchtap="onMoreTap">
        <text class="more-icon">☰</text>
      </view>
    </view>
  </view>

  <!-- 功能下拉菜单（覆盖在状态栏下方，右上角） -->
  <view wx:if="{{showMoreMenu}}" class="more-mask" catchtap="onMoreTap"></view>
  <view wx:if="{{showMoreMenu}}" class="more-dropdown">
    <view class="more-item {{moveHistory.length === 0 || isAIThinking ? 'more-item-disabled' : ''}}" catchtap="onUndo">↩ 悔棋</view>
    <view class="more-item" catchtap="onFlipBoard">🔄 翻转棋盘</view>
    <view class="more-item" catchtap="onStartManualExploration">📝 手动推演</view>
    <view class="more-item {{settings.showHints ? 'more-item-active' : ''}}" catchtap="onCoachRex">🤖 AI教练 Rex</view>
    <view class="more-item {{settings.pieceStyle3d ? 'more-item-active' : ''}}" catchtap="onToggle3D">🎲 3D 棋子</view>
    <view class="more-item" catchtap="onExportPGN">📥 导出 PGN</view>
    <view class="more-item" catchtap="onShareGame">🔗 分享对局</view>
    <view class="more-item more-item-danger" catchtap="onResign">🏳️ 认输</view>
    <!-- 难度滑块 -->
    <view class="more-slider">
      <text class="more-slider-label">AI 难度：{{difficulty}}/10</text>
      <slider min="1" max="10" step="1" value="{{difficulty}}"
              activeColor="#6c63ff" block-size="16"
              bindchange="onDifficultyChange"/>
    </view>
  </view>

  <!-- 计时器 -->
  <timer-display timeControlMode="{{timeControlMode}}"
                 whiteTime="{{whiteTime}}" blackTime="{{blackTime}}"
                 activeSide="{{timerActiveSide}}" gameStarted="{{gameStarted}}"
                 playerSide="{{playerSide}}"></timer-display>

  <!-- 上方被吃棋子 -->
  <captured-pieces side="top" fen="{{fen}}"></captured-pieces>

  <!-- 棋盘区域 -->
  <view class="board-area">
    <chess-board id="chessBoard"
      fen="{{explorationMode ? explorationFen : fen}}"
      isCheck="{{isCheck}}"
      interactive="{{!gameOver && !isAIThinking && !isReplay}}"
      flipped="{{boardFlipped}}"
      selectedSquare="{{selectedSquare}}"
      legalMoves="{{legalMoves}}"
      lastMoveFrom="{{lastMoveFrom}}"
      lastMoveTo="{{lastMoveTo}}"
      showHints="{{settings.showHints}}"
      boardColorPreset="{{settings.boardColorPreset}}"
      analysis="{{analysis}}"
      explorationMode="{{explorationMode}}"
      moveHistory="{{moveHistory}}"
      replayIndex="{{replayIndex}}"
      isReplay="{{isReplay}}"
      canvasHidden="{{showMoreMenu || showPromotion || showBadMove || showGameOver}}"
      bind:squaretap="onSquareTap"
      bind:scrolltocandidate="onScrollToCandidate"
      bind:startexploration="onStartExploration"
      bind:playcontinuation="onPlayContinuation"
      bind:gotomove="onGoToMove">
    </chess-board>
  </view>

  <!-- 推演模式状态栏 -->
  <view wx:if="{{explorationMode}}" class="exploration-bar">
    <view class="exploration-nav">
      <view class="exploration-nav-btn {{explorationStepIndex <= 0 ? 'exploration-nav-disabled' : ''}}" catchtap="explorationPrev">◀</view>
      <text class="exploration-label">📝 {{explorationMode === 'auto' ? '🤖 自动推演' : '手动推演'}} · {{explorationStepIndex + 1}}/{{explorationSteps.length}}</text>
      <view class="exploration-nav-btn {{explorationStepIndex >= explorationSteps.length - 1 ? 'exploration-nav-disabled' : ''}}" catchtap="explorationNext">▶</view>
    </view>
    <view class="exploration-actions">
      <view wx:if="{{explorationMode === 'auto'}}">
        <view class="exploration-pause-btn {{exploreAutoRunning ? '' : 'explore-hidden'}}" catchtap="onStartAutoExploration">⏸</view>
        <view class="exploration-pause-btn {{exploreAutoPaused ? '' : 'explore-hidden'}}" catchtap="onStartAutoExploration">▶</view>
      </view>
      <view class="exploration-btn" catchtap="exitExploration">✕ 退出</view>
    </view>
  </view>

  <!-- 下方被吃棋子 -->
  <captured-pieces side="bottom" fen="{{fen}}"></captured-pieces>

<!-- 分析/提示面板（可展开收起） -->
  <view wx:if="{{gameStarted}}" class="panel-tabs {{panelExpanded ? '' : 'panel-collapsed'}}">
    <!-- 折叠/展开条 -->
    <view class="panel-toggle-bar" catchtap="onTogglePanel">
      <view class="panel-toggle-handle"></view>
      <text class="panel-toggle-icon">{{panelExpanded ? '▼' : '▲'}}</text>
    </view>
    <view class="panel-body" wx:if="{{panelExpanded}}">
      <analysis-panel id="analysis-panel"
        gameStarted="{{gameStarted}}"
        gameOver="{{gameOver}}"
        fen="{{fen}}"
        analysis="{{analysis}}"
        analysisError="{{analysisError}}"
        openingName="{{openingName}}"
        openingNameCN="{{openingNameCN}}"
        ecoCode="{{ecoCode}}"
        exploration="{{explorationMode}}"
        isAIThinking="{{isAIThinking}}"
        showHints="{{settings.showHints}}"
        analysisDepth="{{settings.analysisDepth}}"
        playerSide="{{playerSide}}"
        turn="{{turn}}"
        bind:startexploration="onStartExploration"
        bind:playcontinuation="onPlayContinuation"
        bind:autocontinuation="onAutoContinuation">
      </analysis-panel>
    </view>
  </view>

  <!-- 重演模式导航 -->
  <view wx:if="{{isReplay}}" class="replay-bar-inline">
    <view class="replay-btn" catchtap="replayPrev">◀ 上一步</view>
    <text class="replay-info">{{replayIndex + 1}} / {{moveHistory.length}}</text>
    <view class="replay-btn" catchtap="replayNext">下一步 ▶</view>
    <view class="replay-btn" catchtap="exitReplay">✕ 退出</view>
  </view>

  <!-- 未开始状态 -->
  <view wx:if="{{!gameStarted}}" class="start-screen">
    <view class="start-card glass-strong">
      <text class="start-title">♟ mychess AI</text>
      <text class="start-subtitle">国际象棋陪练系统</text>
      <view class="start-actions">
        <view class="btn-primary" catchtap="onNewGame">🎮 新建对局</view>
        <view class="btn-secondary" catchtap="onTimeClick">⏱ {{currentTimeLabel}}</view>
      </view>
      <!-- 时间选项 -->
      <view wx:if="{{showTimeOptions}}" class="time-options">
        <view class="time-option" wx:for="{{TIME_PRESETS}}" wx:for-index="idx" wx:key="label"
              data-index="{{idx}}" catchtap="onTimeSelect">
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 弹窗 -->
  <promotion-dialog show="{{showPromotion}}" color="{{playerSide}}"
                    bind:select="onPromotionSelect" bind:cancel="onPromotionCancel"></promotion-dialog>

  <bad-move-dialog show="{{showBadMove}}"
                   moveDesc="{{badMoveData.moveDesc}}"
                   userScore="{{badMoveData.userScore}}"
                   bestScore="{{badMoveData.bestScore}}"
                   loss="{{badMoveData.loss}}"
                   bind:explore="onBadMoveExplore"
                   bind:autoexplore="onBadMoveAutoExplore"
                   bind:confirm="onBadMoveConfirm"
                   bind:cancel="onBadMoveCancel"></bad-move-dialog>

  <game-over-modal show="{{showGameOver}}" result="{{result}}" playerSide="{{playerSide}}"
                   bind:undo="onGameOverUndo" bind:newgame="onGameOverNewGame"></game-over-modal>

  <!-- 右下角AI教练 -->
  <coach-chat fen="{{fen}}" moveHistory="{{moveHistory}}" gameStarted="{{gameStarted}}"></coach-chat>
</view>