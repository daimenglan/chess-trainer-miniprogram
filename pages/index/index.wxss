.shell-page { position: relative; width: 100%; height: 100vh; overflow: hidden; background: var(--shell-bg, #0f0f23); }
.shell-web-view { position: absolute; inset: 0; width: 100%; height: 100%; }
.shell-loading, .shell-error { position: absolute; inset: 0; z-index: 10; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20rpx; padding: 40rpx; background: var(--shell-bg, #0f0f23); color: var(--shell-text, #8888aa); }
.loading-spinner { width: 64rpx; height: 64rpx; border: 6rpx solid rgba(255,255,255,.15); border-top-color: #6c63ff; border-radius: 50%; animation: shell-spin .8s linear infinite; }
@keyframes shell-spin { to { transform: rotate(360deg); } }
.error-icon { font-size: 72rpx; }
.error-text { text-align: center; line-height: 1.6; }
.error-btn { padding: 20rpx 48rpx; border-radius: 48rpx; background: #6c63ff; color: #fff; }
.theme-light { --shell-bg: #f5f5f7; --shell-text: #6b7280; }
