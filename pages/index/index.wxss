.game-page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #0f0f23;
}

/* 右上角功能下拉按钮（位于状态栏内） */
.more-btn {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.more-btn:active {
  background: rgba(108, 99, 255, 0.2);
}

.more-icon {
  font-size: 30rpx;
  color: #c0c0e0;
  line-height: 1;
}

/* 点击遮罩，点击空白处关闭菜单 */
.more-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  background: transparent;
}

/* 下拉菜单 */
.more-dropdown {
  position: absolute;
  top: 96rpx;
  right: 16rpx;
  background: #1a1a2e;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  width: 320rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.6);
  z-index: 100;
  overflow: hidden;
}

.more-item {
  padding: 22rpx 28rpx;
  font-size: 26rpx;
  color: #e0e0f0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  background: #1a1a2e;
}

.more-item:last-of-type {
  border-bottom: none;
}

.more-item:active {
  background: rgba(108, 99, 255, 0.2);
}

.more-item-active {
  color: #6c63ff;
  background: rgba(108, 99, 255, 0.15);
}

.more-item-disabled {
  color: #555577;
}

.more-item-danger {
  color: #f87171;
}

/* 下拉菜单内的难度滑块 */
.more-slider {
  padding: 16rpx 28rpx 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  background: #1a1a2e;
}

.more-slider-label {
  font-size: 22rpx;
  color: #8888aa;
  display: block;
  margin-bottom: 4rpx;
}

/* 状态栏 */
.status-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 8rpx 88rpx 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.03);
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  min-width: 100rpx;
}

.status-active {
  background: rgba(108, 99, 255, 0.12);
}

.status-label {
  font-size: 18rpx;
  color: #8888aa;
}

.status-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #e0e0f0;
}

.status-result {
  font-size: 20rpx;
  color: #6c63ff;
  font-weight: 600;
  text-align: center;
  min-width: 120rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.offline-badge {
  font-size: 16rpx;
  color: #facc15;
  border: 1rpx solid rgba(250, 204, 21, 0.4);
  background: rgba(250, 204, 21, 0.1);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}

/* 棋盘区域 */
.board-area {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 2rpx 0;
  max-height: 75vh;
}

/* 分析/棋谱 Tab 区域 */
.panel-tabs {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-height: 0;
}

.panel-tab-head {
  display: flex;
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.02);
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.panel-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx;
  font-size: 24rpx;
  color: #8888aa;
  border-bottom: 3rpx solid transparent;
  transition: all 0.2s;
}

.panel-tab-active {
  color: #6c63ff;
  border-bottom-color: #6c63ff;
}

.panel-body {
  flex: 1;
  overflow: hidden;
  min-height: 0;
}

.board-area chess-board {
  width: 100%;
  height: 100%;
}

/* 游戏控制栏 */
.game-controls {
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.02);
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  position: relative;
}

.controls-scroll {
  white-space: nowrap;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
}

.controls-scroll::-webkit-scrollbar {
  display: none;
}

.controls-row {
  display: flex;
  gap: 8rpx;
  padding: 4rpx 0;
  min-width: max-content;
}

.control-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
  font-size: 20rpx;
  color: #c0c0e0;
  white-space: nowrap;
  flex-shrink: 0;
}

.control-btn:active {
  background: rgba(255, 255, 255, 0.12);
}

.control-active {
  background: rgba(108, 99, 255, 0.15);
  border-color: rgba(108, 99, 255, 0.3);
  color: #6c63ff;
}

.control-danger {
  color: #f87171;
}

.difficulty-slider {
  padding: 8rpx 0;
}

.slider-label {
  font-size: 18rpx;
  color: #8888aa;
  margin-bottom: 4rpx;
  display: block;
}

.slider-marks {
  display: flex;
  justify-content: space-between;
  font-size: 14rpx;
  color: #555577;
  margin-top: -8rpx;
}

/* 开始界面 */
.start-screen {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #0f0f23;
  z-index: 10;
  padding: 40rpx;
}

.start-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 48rpx 60rpx;
  background: rgba(26, 26, 46, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.08);
  max-width: 500rpx;
  width: 100%;
}

.start-title {
  font-size: 48rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #6c63ff, #a78bfa);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.start-subtitle {
  font-size: 24rpx;
  color: #8888aa;
  margin-bottom: 16rpx;
}

.start-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
}

.time-options {
  width: 100%;
  margin-top: 8rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 10rpx;
  overflow: hidden;
}

.time-option {
  padding: 12rpx 20rpx;
  font-size: 22rpx;
  color: #a0a0c0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

.time-option:active {
  background: rgba(108, 99, 255, 0.1);
}

.time-option:last-child {
  border-bottom: none;
}

/* 重演栏 */
.replay-bar {
  position: fixed;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
}

/* 推演模式导航栏 */
.exploration-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 20rpx;
  background: rgba(108, 99, 255, 0.12);
  border-top: 1rpx solid rgba(108, 99, 255, 0.2);
  border-bottom: 1rpx solid rgba(108, 99, 255, 0.2);
}

.exploration-nav {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.exploration-nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(108, 99, 255, 0.15);
  border: 1rpx solid rgba(108, 99, 255, 0.3);
  font-size: 28rpx;
  color: #6c63ff;
  font-weight: 700;
}

.exploration-nav-btn:active {
  background: rgba(108, 99, 255, 0.3);
}

.exploration-nav-disabled {
  opacity: 0.3;
}

.exploration-label {
  font-size: 24rpx;
  color: #e0e0f0;
  font-weight: 600;
  min-width: 160rpx;
  text-align: center;
}

.exploration-actions {
  display: flex;
  gap: 12rpx;
}

.exploration-btn {
  padding: 10rpx 24rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  font-size: 22rpx;
  color: #f87171;
  font-weight: 500;
}

.exploration-btn:active {
  background: rgba(248, 113, 113, 0.15);
}

.replay-btn {
  padding: 12rpx 24rpx;
  background: rgba(108, 99, 255, 0.15);
  border: 1px solid rgba(108, 99, 255, 0.3);
  border-radius: 12rpx;
  color: #6c63ff;
  font-size: 22rpx;
  font-weight: 600;
}

/* ===== 提示面板（替代面板+控制栏） ===== */
.hints-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #0f0f23;
  border-top: 1px solid rgba(108, 99, 255, 0.15);
  min-height: 0;
}

.hints-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 28rpx;
}

/* 评估条 */
.hints-eval {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.hints-eval-bar {
  height: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 10rpx;
  overflow: hidden;
}

.hints-eval-fill {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.3s ease;
}

.hints-eval-score {
  font-size: 36rpx;
  font-weight: 700;
  font-family: 'Courier New', monospace;
  text-align: center;
}

.hints-eval-label {
  font-size: 24rpx;
  color: #8888aa;
  text-align: center;
  font-weight: 500;
}

/* 开局名称 */
.hints-opening {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: rgba(108, 99, 255, 0.1);
  border-radius: 12rpx;
  border: 1px solid rgba(108, 99, 255, 0.2);
  margin-bottom: 20rpx;
}

.hints-eco {
  font-size: 24rpx;
  font-weight: 700;
  color: #6c63ff;
  background: rgba(108, 99, 255, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.hints-opening-text {
  font-size: 24rpx;
  color: #a0a0c0;
}

/* AI 思考中 */
.hints-thinking {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 30rpx 0;
  font-size: 26rpx;
  color: #8888aa;
}

.hints-thinking-dot {
  width: 18rpx;
  height: 18rpx;
  background: #6c63ff;
  border-radius: 50%;
  animation: pulse 1s ease-in-out infinite;
}

/* 分析错误 */
.hints-error {
  padding: 16rpx 20rpx;
  background: rgba(239, 68, 68, 0.1);
  border-radius: 12rpx;
  border: 1px solid rgba(239, 68, 68, 0.2);
  font-size: 22rpx;
  color: #f87171;
  margin-bottom: 20rpx;
}

/* 候选走法列表 */
.hints-candidates {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hints-candidate {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.hints-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.hints-cinfo {
  flex: 1;
  min-width: 0;
}

.hints-cheader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.hints-clabel {
  font-size: 26rpx;
  font-weight: 600;
  color: #e0e0f0;
}

.hints-cscore {
  font-size: 26rpx;
  font-weight: 700;
  font-family: 'Courier New', monospace;
}

.hints-detail {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-bottom: 8rpx;
}

.hints-pro {
  font-size: 20rpx;
  color: #4ade80;
  line-height: 1.5;
}

.hints-con {
  font-size: 20rpx;
  color: #f87171;
  line-height: 1.5;
}

.hints-tactics {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.hints-tag {
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(234, 179, 8, 0.15);
  color: #facc15;
}

.hints-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4rpx;
}

.hints-line-label {
  font-size: 18rpx;
  color: #666688;
}

.hints-line-move {
  font-size: 20rpx;
  color: #a0a0c0;
  font-family: 'Courier New', monospace;
}

.hints-empty {
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: #666688;
}