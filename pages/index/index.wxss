.game-page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--bg-primary);
}

/* 右上角功能下拉按钮（位于状态栏右端） */
.more-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
}

.more-btn:active {
  background: var(--accent-border);
}

.more-icon {
  font-size: 36rpx;
  color: var(--text-secondary);
  line-height: 1;
}

/* 点击遮罩，点击空白处关闭菜单 */
.more-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  background: transparent;
}

/* 下拉菜单 */
.more-dropdown {
  position: absolute;
  top: 96rpx;
  right: 16rpx;
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 16rpx;
  width: 360rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.6);
  z-index: 100;
  overflow: hidden;
}

.more-item {
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  background: var(--bg-secondary);
}

.more-item:last-of-type {
  border-bottom: none;
}

.more-item:active {
  background: var(--accent-border);
}

.more-item-active {
  color: var(--accent);
  background: var(--accent-bg);
}

.more-item-disabled {
  color: var(--text-placeholder);
}

.more-item-danger {
  color: var(--danger);
}

/* 下拉菜单内的难度滑块 */
.more-slider {
  padding: 20rpx 28rpx 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  background: var(--bg-secondary);
}

.more-slider-label {
  font-size: 26rpx;
  color: var(--text-muted);
  display: block;
  margin-bottom: 4rpx;
}

/* 状态栏 */
.status-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 12rpx;
  background: var(--bg-card);
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  min-height: 88rpx;
  /* 高于棋盘区域，确保下拉菜单不被遮挡 */
  z-index: 1000;
  overflow: visible;
}

.status-left {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-width: 100rpx;
}

.status-center {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  flex: 1;
}

.status-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
  min-width: 100rpx;
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: 10rpx;
  min-width: 120rpx;
}

.status-active {
  background: var(--accent-bg);
}

.status-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.status-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.status-result {
  font-size: 26rpx;
  color: var(--accent);
  font-weight: 600;
  text-align: center;
  min-width: 150rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.offline-badge {
  font-size: 20rpx;
  color: var(--warning);
  border: 1rpx solid rgba(250, 204, 21, 0.4);
  background: rgba(250, 204, 21, 0.1);
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
}

/* 棋盘区域 */
.board-area {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 2rpx 0;
  max-height: 75vh;
}

/* 分析/提示面板区域 */
.panel-tabs {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-height: 0;
}

.panel-body {
  flex: 1;
  overflow: hidden;
  min-height: 0;
  height: 0;
}

/* 面板折叠/展开条 */
.panel-toggle-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0;
  gap: 10rpx;
  background: var(--bg-card);
  border-top: 1px solid rgba(255, 255, 255, 0.04);
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  cursor: pointer;
  flex-shrink: 0;
}

.panel-toggle-bar:active {
  background: var(--bg-card-hover);
}

.panel-toggle-handle {
  width: 60rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--text-placeholder);
}

.panel-toggle-icon {
  font-size: 20rpx;
  color: var(--text-placeholder);
}

.panel-collapsed {
  flex: 0 0 auto !important;
}

.board-area chess-board {
  width: 100%;
  height: 100%;
}

/* 游戏控制栏 */
.game-controls {
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.02);
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  position: relative;
}

.controls-scroll {
  white-space: nowrap;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
}

.controls-scroll::-webkit-scrollbar {
  display: none;
}

.controls-row {
  display: flex;
  gap: 8rpx;
  padding: 4rpx 0;
  min-width: max-content;
}

.control-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 22rpx;
  border-radius: 10rpx;
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  font-size: 26rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  flex-shrink: 0;
}

.control-btn:active {
  background: rgba(255, 255, 255, 0.12);
}

.control-active {
  background: var(--accent-bg);
  border-color: var(--accent-border);
  color: var(--accent);
}

.control-danger {
  color: var(--danger);
}

.difficulty-slider {
  padding: 8rpx 0;
}

.slider-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 4rpx;
  display: block;
}

.slider-marks {
  display: flex;
  justify-content: space-between;
  font-size: 18rpx;
  color: var(--text-placeholder);
  margin-top: -8rpx;
}

/* 开始界面 */
.start-screen {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--bg-primary);
  z-index: 10;
  padding: 40rpx;
}

.start-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 48rpx 60rpx;
  background: rgba(26, 26, 46, 0.95);
  border: 1px solid var(--border-color);
  max-width: 500rpx;
  width: 100%;
}

.start-title {
  font-size: 48rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #6c63ff, #a78bfa);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.start-subtitle {
  font-size: 28rpx;
  color: var(--text-muted);
  margin-bottom: 16rpx;
}

.start-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
}

.time-options {
  width: 100%;
  margin-top: 8rpx;
  background: var(--bg-card);
  border-radius: 10rpx;
  overflow: hidden;
}

.time-option {
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-dim);
  border-bottom: 1px solid var(--border-color-light);
}

.time-option:active {
  background: var(--accent-bg-light);
}

.time-option:last-child {
  border-bottom: none;
}

/* 重演栏 */
.replay-bar {
  position: fixed;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
}

/* 推演模式导航栏 */
.exploration-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 20rpx;
  background: var(--accent-bg);
  border-top: 1rpx solid rgba(108, 99, 255, 0.2);
  border-bottom: 1rpx solid rgba(108, 99, 255, 0.2);
}

.exploration-nav {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.exploration-nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--accent-bg);
  border: 1rpx solid rgba(108, 99, 255, 0.3);
  font-size: 32rpx;
  color: var(--accent);
  font-weight: 700;
}

.exploration-nav-btn:active {
  background: rgba(108, 99, 255, 0.3);
}

.exploration-nav-disabled {
  opacity: 0.3;
}

.exploration-label {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
  min-width: 200rpx;
  text-align: center;
}

.exploration-actions {
  display: flex;
  gap: 12rpx;
}

.exploration-btn {
  padding: 14rpx 28rpx;
  border-radius: 12rpx;
  background: var(--bg-card-hover);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  font-size: 28rpx;
  color: var(--danger);
  font-weight: 600;
}

.exploration-btn:active {
  background: rgba(248, 113, 113, 0.15);
}

.exploration-pause-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--accent-bg);
  border: 1rpx solid rgba(108, 99, 255, 0.3);
  font-size: 32rpx;
  color: var(--accent);
  font-weight: 700;
  cursor: pointer;
}

.exploration-pause-btn:active {
  background: rgba(108, 99, 255, 0.3);
}

.explore-hidden {
  display: none;
}

.replay-btn {
  padding: 16rpx 32rpx;
  background: var(--accent-bg);
  border: 1px solid rgba(108, 99, 255, 0.3);
  border-radius: 14rpx;
  color: var(--accent);
  font-size: 28rpx;
  font-weight: 600;
}

