.coin-shop-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  padding: 24rpx;
  background: var(--bg-primary);
  gap: 16rpx;
}

.cs-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #fef3c7, #fef9e7);
  border: 1px solid #fde68a;
  border-radius: 20rpx;
  padding: 24rpx;
}

.cs-balance {
  display: flex;
  flex-direction: column;
}

.cs-balance-label {
  font-size: 24rpx;
  color: #92400e;
}

.cs-balance-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #b45309;
}

.cs-streak {
  display: flex;
  gap: 16rpx;
}

.cs-streak-item {
  font-size: 24rpx;
  color: #92400e;
  background: rgba(255,255,255,0.5);
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
}

.cs-tabs {
  display: flex;
  gap: 8rpx;
  border-bottom: 2px solid var(--border-color);
}

.cs-tab {
  flex: 1;
  padding: 20rpx;
  font-size: 26rpx;
  color: var(--text-muted);
  background: transparent;
  border: none;
  border-bottom: 3px solid transparent;
  margin-bottom: -2px;
}

.cs-tab.active {
  color: var(--accent);
  border-bottom-color: var(--accent);
  font-weight: 600;
}

.cs-message {
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  text-align: center;
  background: rgba(74, 222, 128, 0.1);
  color: #4ade80;
}

.cs-message.error {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
}

.cs-tab-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  flex: 1;
  overflow-y: auto;
}

.cs-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.cs-section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.cs-chest-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.cs-chest {
  border: 1px solid var(--border-color);
  border-radius: 12rpx;
  padding: 12rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cs-chest-icon {
  font-size: 28rpx;
}

.cs-chest-name {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.cs-chest-days {
  font-size: 18rpx;
  color: var(--text-muted);
}

.cs-chest-coins {
  font-size: 18rpx;
  color: #b45309;
  font-weight: 600;
}

.cs-task {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  border: 1px solid var(--border-color);
  border-radius: 12rpx;
}

.cs-task.completed {
  background: rgba(74, 222, 128, 0.05);
}

.cs-task-info {
  flex: 1;
  min-width: 0;
}

.cs-task-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.cs-task-desc {
  font-size: 20rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 4rpx;
}

.cs-task-progress {
  height: 6rpx;
  background: var(--border-color);
  border-radius: 3rpx;
  margin-top: 8rpx;
  overflow: hidden;
}

.cs-task-bar {
  height: 100%;
  background: #6366f1;
  border-radius: 3rpx;
}

.cs-task-reward {
  text-align: right;
}

.cs-task-coin {
  font-size: 22rpx;
  font-weight: 600;
  color: #4ade80;
}

.cs-streak-items {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.cs-streak-item-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx;
  border: 1px solid var(--border-color);
  border-radius: 12rpx;
}

.cs-streak-item-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.cs-streak-item-desc {
  font-size: 22rpx;
  color: var(--text-muted);
}

.cs-streak-item-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cs-streak-item-price {
  font-size: 24rpx;
  font-weight: 600;
  color: #b45309;
}

.cs-streak-item-btn {
  padding: 14rpx 24rpx;
  font-size: 22rpx;
  color: #fff;
  background: #6366f1;
  border-radius: 10rpx;
  border: none;
}

.cs-streak-item-btn:disabled {
  background: var(--border-color);
  color: var(--text-muted);
}

.cs-rule {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  border: 1px solid var(--border-color);
  border-radius: 12rpx;
}

.cs-rule-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.cs-rule-coin {
  font-size: 22rpx;
  color: #4ade80;
  font-weight: 600;
}

.cs-rule-desc {
  font-size: 20rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 4rpx;
}

.cs-goods-category {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.cs-goods-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.cs-goods-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
}

.cs-goods-card {
  padding: 16rpx;
  border: 1px solid var(--border-color);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.cs-goods-name {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.cs-goods-desc {
  font-size: 18rpx;
  color: var(--text-muted);
}

.cs-goods-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.cs-goods-price {
  font-size: 20rpx;
  font-weight: 600;
  color: #b45309;
}

.cs-goods-btn {
  padding: 10rpx 18rpx;
  font-size: 20rpx;
  color: #fff;
  background: #6366f1;
  border-radius: 8rpx;
  border: none;
}

.cs-goods-btn:disabled {
  background: var(--border-color);
  color: var(--text-muted);
}

.cs-exchange-section {
  margin-top: 8rpx;
}

.cs-exchange-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  border: 1px solid var(--border-color);
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.cs-exchange-info {
  flex: 1;
}

.cs-exchange-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.cs-exchange-detail {
  font-size: 20rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 4rpx;
}

.cs-exchange-btn {
  padding: 12rpx 24rpx;
  font-size: 22rpx;
  color: #fff;
  background: #6366f1;
  border-radius: 10rpx;
  border: none;
}

.cs-exchange-btn:disabled {
  background: var(--border-color);
  color: var(--text-muted);
}

.cs-ledger, .cs-records {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.cs-ledger-row, .cs-record-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 16rpx;
  border: 1px solid var(--border-color);
  border-radius: 10rpx;
}

.cs-ledger-desc, .cs-record-name {
  font-size: 22rpx;
  color: var(--text-primary);
  flex: 1;
}

.cs-ledger-delta {
  font-size: 22rpx;
  font-weight: 600;
  margin: 0 12rpx;
}

.cs-ledger-delta.positive { color: #4ade80; }
.cs-ledger-delta.negative { color: #ef4444; }

.cs-ledger-balance {
  font-size: 20rpx;
  color: var(--text-muted);
}

.cs-record-cost {
  font-size: 20rpx;
  color: var(--text-muted);
  margin: 0 8rpx;
}

.cs-record-status {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: var(--border-color);
  color: var(--text-muted);
}

.cs-record-status.done {
  background: rgba(74, 222, 128, 0.15);
  color: #4ade80;
}

.cs-empty {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: var(--text-muted);
}

.cs-back-btn {
  margin-top: 16rpx;
  padding: 18rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 14rpx;
}