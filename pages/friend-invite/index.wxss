/* 好友邀请落地页：单卡片居中，内容随状态切换 */
.invite-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 48rpx;
  background: var(--bg-primary);
}

.invite-card {
  width: 100%;
  max-width: 620rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 56rpx 40rpx;
  border-radius: 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  box-shadow: var(--shadow-card);
}

.invite-icon { font-size: 88rpx; line-height: 1.2; }

.invite-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
}

.invite-sub {
  font-size: 25rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.5;
}

.invite-info {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 8rpx 0;
}

.invite-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 22rpx;
  border-radius: 14rpx;
  background: var(--bg-input);
}

.invite-info-label { font-size: 24rpx; color: var(--text-muted); }
.invite-info-value { font-size: 26rpx; font-weight: 600; color: var(--text-primary); }

.invite-btn {
  width: 100%;
  text-align: center;
  padding: 22rpx;
  border-radius: 16rpx;
  margin-top: 8rpx;
}

.invite-btn.primary {
  background: var(--accent-gradient);
}
.invite-btn.primary text { font-size: 29rpx; color: #fff; font-weight: 600; }

.invite-btn.ghost {
  background: transparent;
  border: 1rpx solid var(--border-color);
}
.invite-btn.ghost text { font-size: 27rpx; color: var(--text-secondary); }
