.page {
  background: var(--bg-page, #0f0f23);
  color: var(--text-primary, #e8e8f0);
  min-height: 100vh;
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--bg-card, #1a1a2e);
  border-bottom: 1rpx solid var(--border-color, #2a2a4a);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: var(--bg-hover, #252545);
  margin-right: 24rpx;
}

.nav-back-icon {
  font-size: 32rpx;
  color: var(--text-primary, #e8e8f0);
}

.nav-back-text {
  font-size: 26rpx;
  color: var(--text-primary, #e8e8f0);
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary, #e8e8f0);
  flex: 1;
}

.scroll-content {
  padding: 24rpx 32rpx;
  height: calc(100vh - 100rpx);
}

.form-section {
  background: var(--bg-card, #1a1a2e);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary, #e8e8f0);
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-color, #2a2a4a);
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary, #a0a0c0);
  margin-bottom: 12rpx;
  font-weight: 600;
}

.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--bg-input, #15152a);
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
}

.picker-input text {
  font-size: 28rpx;
  color: var(--text-primary, #e8e8f0);
}

.picker-arrow {
  font-size: 20rpx;
  color: var(--text-muted, #666);
}

.textarea-input {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: var(--bg-input, #15152a);
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
  color: var(--text-primary, #e8e8f0);
  font-size: 28rpx;
  line-height: 1.6;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-muted, #666);
  margin-top: 8rpx;
}

.input-field {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--bg-input, #15152a);
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
  color: var(--text-primary, #e8e8f0);
  font-size: 28rpx;
}

.placeholder {
  color: var(--text-muted, #666);
}

.submit-btn {
  margin-top: 12rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #6c63ff, #8b8bff);
  border-radius: 12rpx;
  text-align: center;
}

.submit-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.error-tip {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(239, 68, 68, 0.1);
  border-radius: 12rpx;
  border: 1rpx solid rgba(239, 68, 68, 0.3);
}

.error-tip text {
  font-size: 24rpx;
  color: #ef4444;
}

.success-tip {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(34, 197, 94, 0.1);
  border-radius: 12rpx;
  border: 1rpx solid rgba(34, 197, 94, 0.3);
}

.success-tip text {
  font-size: 24rpx;
  color: #22c55e;
}

.feedback-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feedback-item {
  padding: 20rpx 24rpx;
  background: var(--bg-input, #15152a);
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
}

.feedback-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.feedback-type {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary, #e8e8f0);
}

.feedback-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.feedback-status[status="pending"] {
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.1);
}

.feedback-status[status="processing"] {
  color: #3b82f6;
  background: rgba(59, 130, 246, 0.1);
}

.feedback-status[status="resolved"] {
  color: #22c55e;
  background: rgba(34, 197, 94, 0.1);
}

.feedback-status[status="rejected"] {
  color: #ef4444;
  background: rgba(239, 68, 68, 0.1);
}

.feedback-content {
  font-size: 26rpx;
  color: var(--text-secondary, #a0a0c0);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.feedback-date {
  font-size: 22rpx;
  color: var(--text-muted, #666);
  margin-top: 12rpx;
  display: block;
}

.empty-tip, .loading-tip {
  text-align: center;
  padding: 40rpx;
}

.empty-tip text, .loading-tip text {
  font-size: 24rpx;
  color: var(--text-muted, #666);
}