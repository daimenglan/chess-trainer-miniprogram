.records-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-primary);
  overflow: hidden;
}

.page-header {
  padding: 20rpx 24rpx;
  border-top: 2px solid transparent;
  border-image: linear-gradient(90deg, #6c63ff, #4834d4, #6c63ff) 1;
}

.page-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* 头部操作按钮 */
.header-actions {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
}

.header-btn {
  padding: 6rpx 14rpx;
  background: var(--bg-card-hover);
  border-radius: 8px;
  font-size: 18rpx;
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
}

/* 外部搜索面板 */
.external-search-panel {
  padding: 12rpx 16rpx;
  background: var(--bg-card);
  border-bottom: 1px solid var(--border-color);
}

.search-row {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.source-picker {
  padding: 8rpx 12rpx;
  background: var(--bg-card-hover);
  border-radius: 8px;
  font-size: 18rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.external-results {
  margin-top: 12rpx;
  max-height: 300rpx;
  overflow-y: auto;
}

.empty-hint {
  font-size: 18rpx;
  color: var(--text-dim);
  text-align: center;
  padding: 20rpx 0;
}

.ext-result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx;
  background: var(--bg-card-hover);
  border-radius: 10px;
  margin-bottom: 8px;
}

.ext-result-info {
  flex: 1;
  min-width: 0;
}

.ext-players {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
}

.ext-meta {
  font-size: 16rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 2rpx;
}

.ext-result-action {
  padding: 8rpx 16rpx;
  background: var(--success-bg);
  color: var(--success);
  border-radius: 8px;
  font-size: 18rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* URL导入面板 */
.url-import-panel {
  padding: 12rpx 16rpx;
  background: var(--bg-card);
  border-bottom: 1px solid var(--border-color);
}

.url-input-row {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.tab-bar {
  display: flex;
  background: var(--bg-card);
  border-bottom: 1px solid var(--border-color-light);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 500;
  border-bottom: 2px solid transparent;
}

.tab-active {
  color: var(--accent);
  border-bottom-color: var(--accent);
  font-weight: 700;
}

.tab-content {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.search-bar {
  display: flex;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 60rpx;
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  border-radius: 8rpx;
  padding: 0 12rpx;
  font-size: 20rpx;
  color: var(--text-primary);
}

.search-input-sm {
  max-width: 100rpx;
  text-align: center;
}

.search-btn, .import-btn {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.search-btn {
  background: var(--accent-bg);
  color: var(--accent);
}

.import-btn {
  background: var(--success-bg);
  color: var(--success);
}

.records-list {
  flex: 1;
  overflow-y: auto;
  padding: 8rpx 16rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 12rpx;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-dim);
}

.empty-action {
  padding: 12rpx 24rpx;
  background: var(--accent-bg);
  border-radius: 10rpx;
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
}

.record-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  margin-bottom: 8rpx;
  background: var(--bg-card);
  border-radius: 12rpx;
  border: 1px solid var(--border-color-light);
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-players {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.player-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.vs-text {
  font-size: 18rpx;
  color: var(--text-dim);
}

.record-meta {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 4rpx;
}

.record-result {
  font-size: 18rpx;
  color: var(--text-dim);
  padding: 2rpx 8rpx;
  background: var(--bg-card-hover);
  border-radius: 4rpx;
}

.record-eco {
  font-size: 16rpx;
  color: var(--accent);
  background: var(--accent-bg-light);
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
}

.record-diff {
  font-size: 16rpx;
  color: var(--warning);
  background: rgba(234, 179, 8, 0.1);
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
}

.record-date {
  font-size: 16rpx;
  color: var(--text-dim);
}

.record-event {
  font-size: 18rpx;
  color: var(--text-muted);
}

.record-actions {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.action-btn {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  background: var(--accent-bg-light);
  color: var(--accent);
  font-weight: 500;
}

.action-danger {
  background: var(--danger-bg);
  color: var(--danger);
}

.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
}

.page-btn {
  padding: 8rpx 20rpx;
  background: var(--bg-card-hover);
  border-radius: 8rpx;
  font-size: 20rpx;
  color: var(--text-secondary);
}

.page-disabled {
  opacity: 0.4;
}

.page-info {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 导入弹窗 */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: var(--bg-overlay);
  backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.import-modal {
  width: 80%;
  max-height: 70%;
  padding: 24rpx;
  background: rgba(26, 26, 46, 0.95);
  border: 1px solid var(--border-color);
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.modal-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.close-btn {
  font-size: 28rpx;
  color: var(--text-muted);
  padding: 8rpx;
}

.pgn-textarea {
  width: 100%;
  height: 300rpx;
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  border-radius: 8rpx;
  padding: 12rpx;
  font-size: 20rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  font-family: monospace;
}

.import-btn-main {
  text-align: center;
  padding: 14rpx;
  margin-top: 12rpx;
  background: var(--accent-gradient);
  border-radius: 10rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.import-result {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--success);
}

.import-errors {
  color: var(--danger);
  display: block;
  margin-top: 8rpx;
  white-space: pre-wrap;
}