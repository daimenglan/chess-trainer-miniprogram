.records-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0f0f23;
  overflow: hidden;
}

.page-header {
  padding: 20rpx 24rpx;
  border-top: 2px solid transparent;
  border-image: linear-gradient(90deg, #6c63ff, #4834d4, #6c63ff) 1;
}

.page-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #e0e0f0;
}

.tab-bar {
  display: flex;
  background: rgba(255, 255, 255, 0.03);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 24rpx;
  color: #8888aa;
  font-weight: 500;
  border-bottom: 2px solid transparent;
}

.tab-active {
  color: #6c63ff;
  border-bottom-color: #6c63ff;
  font-weight: 700;
}

.tab-content {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.search-bar {
  display: flex;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  padding: 0 12rpx;
  font-size: 20rpx;
  color: #e0e0f0;
}

.search-input-sm {
  max-width: 100rpx;
  text-align: center;
}

.search-btn, .import-btn {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.search-btn {
  background: rgba(108, 99, 255, 0.15);
  color: #6c63ff;
}

.import-btn {
  background: rgba(34, 197, 94, 0.15);
  color: #4ade80;
}

.records-list {
  flex: 1;
  overflow-y: auto;
  padding: 8rpx 16rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 12rpx;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 24rpx;
  color: #666688;
}

.empty-action {
  padding: 12rpx 24rpx;
  background: rgba(108, 99, 255, 0.15);
  border-radius: 10rpx;
  color: #6c63ff;
  font-size: 22rpx;
  font-weight: 600;
}

.record-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  margin-bottom: 8rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 12rpx;
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-players {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.player-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #e0e0f0;
}

.vs-text {
  font-size: 18rpx;
  color: #666688;
}

.record-meta {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 4rpx;
}

.record-result {
  font-size: 18rpx;
  color: #a0a0c0;
  padding: 2rpx 8rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 4rpx;
}

.record-eco {
  font-size: 16rpx;
  color: #6c63ff;
  background: rgba(108, 99, 255, 0.1);
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
}

.record-diff {
  font-size: 16rpx;
  color: #facc15;
  background: rgba(234, 179, 8, 0.1);
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
}

.record-date {
  font-size: 16rpx;
  color: #666688;
}

.record-event {
  font-size: 18rpx;
  color: #8888aa;
}

.record-actions {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.action-btn {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  background: rgba(108, 99, 255, 0.1);
  color: #6c63ff;
  font-weight: 500;
}

.action-danger {
  background: rgba(239, 68, 68, 0.1);
  color: #f87171;
}

.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
}

.page-btn {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #c0c0e0;
}

.page-disabled {
  opacity: 0.4;
}

.page-info {
  font-size: 20rpx;
  color: #8888aa;
}

/* 导入弹窗 */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.import-modal {
  width: 80%;
  max-height: 70%;
  padding: 24rpx;
  background: rgba(26, 26, 46, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.modal-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #e0e0f0;
}

.close-btn {
  font-size: 28rpx;
  color: #8888aa;
  padding: 8rpx;
}

.pgn-textarea {
  width: 100%;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  padding: 12rpx;
  font-size: 20rpx;
  color: #e0e0f0;
  box-sizing: border-box;
  font-family: monospace;
}

.import-btn-main {
  text-align: center;
  padding: 14rpx;
  margin-top: 12rpx;
  background: linear-gradient(135deg, #6c63ff, #4834d4);
  border-radius: 10rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.import-result {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #4ade80;
}

.import-errors {
  color: #f87171;
  display: block;
  margin-top: 8rpx;
  white-space: pre-wrap;
}