<view class="shell-page {{__theme__ ? 'theme-' + __theme__ : ''}}">
  <web-view class="shell-web-view" src="{{WebViewUrl}}" bindmessage="onMessage" binderror="onError"></web-view>
  <view wx:if="{{loading}}" class="shell-loading"><view class="loading-spinner"></view><text>正在加载 Mychess 网页版…</text></view>
  <view wx:if="{{error}}" class="shell-error"><text class="error-icon">⚠️</text><text class="error-text">{{error}}</text><view class="error-btn" catchtap="onRetry">重试</view></view>
</view>
