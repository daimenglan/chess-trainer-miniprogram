<view class="records-page {{__theme__ ? 'theme-' + __theme__ : ''}}">
  <!-- 头部 -->
  <view class="page-header glass gradient-top">
    <text class="page-title">📚 棋谱</text>
    <view class="header-actions">
      <view class="header-btn" catchtap="onToggleExternalSearch">🔍 搜索</view>
      <view class="header-btn" catchtap="onToggleUrlImport">🔗 URL</view>
      <view class="header-btn" catchtap="onShowImport">📋 PGN</view>
    </view>
  </view>

  <!-- 外部搜索面板 -->
  <view wx:if="{{showExternalSearch}}" class="external-search-panel">
    <view class="search-row">
      <input class="search-input" placeholder="搜索棋手名/对局ID/开局..." value="{{externalQuery}}" bindinput="onExternalQueryInput" />
      <picker mode="selector" range="{{['lichess', 'chess.com', 'web']}}" value="0" bindchange="onSourceChange" data-source="lichess">
        <view class="source-picker">lichess ▾</view>
      </picker>
      <view class="search-btn" catchtap="onExternalSearch">搜索</view>
    </view>
    <view wx:if="{{searchingExternal}}" class="loading">搜索中...</view>
    <view wx:else class="external-results">
      <view wx:if="{{externalResults.length === 0}}" class="empty-hint">输入关键词搜索全网棋谱</view>
      <view class="ext-result-item" wx:for="{{externalResults}}" wx:key="id" wx:for-index="idx">
        <view class="ext-result-info">
          <text class="ext-players">{{item.white}} VS {{item.black}}</text>
          <text class="ext-meta">{{item.event || ''}} {{item.year || ''}} {{item.result || ''}}</text>
        </view>
        <view class="ext-result-action" catchtap="onImportExternal" data-idx="{{idx}}">导入</view>
      </view>
    </view>
  </view>

  <!-- URL导入面板 -->
  <view wx:if="{{showUrlImport}}" class="url-import-panel">
    <view class="url-input-row">
      <input class="search-input" placeholder="粘贴 Lichess/Chess.com 对局链接..." value="{{importUrl}}" bindinput="onUrlInput" />
      <view class="search-btn {{importingUrl ? 'btn-loading' : ''}}" catchtap="onImportFromUrl">
        <text>{{importingUrl ? '导入中...' : '导入'}}</text>
      </view>
    </view>
  </view>

  <!-- Tab切换 -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'records' ? 'tab-active' : ''}}"
          data-tab="records" catchtap="onTabSwitch">
      <text>棋谱库</text>
    </view>
    <view class="tab-item {{activeTab === 'mygames' ? 'tab-active' : ''}}"
          data-tab="mygames" catchtap="onTabSwitch">
      <text>我的对局</text>
    </view>
  </view>

  <!-- 棋谱库Tab -->
  <view wx:if="{{activeTab === 'records'}}" class="tab-content">
    <!-- 搜索栏 -->
    <view class="search-bar">
      <input class="search-input" placeholder="搜索棋谱..." value="{{searchQuery}}" bindinput="onSearchInput" />
      <input class="search-input search-input-sm" placeholder="ECO" value="{{ecoFilter}}" bindinput="onEcoInput" />
      <view class="search-btn" catchtap="onSearch">搜索</view>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loadingRecords}}" class="loading">加载中...</view>

    <!-- 列表 -->
    <scroll-view wx:else class="records-list" scroll-y>
      <view wx:if="{{records.length === 0}}" class="empty-state">
        <text class="empty-icon">📭</text>
        <text class="empty-text">暂无棋谱</text>
        <view class="empty-action" catchtap="onShowImport">导入PGN</view>
      </view>

      <view wx:if="{{records.length > 0}}" class="record-card" wx:for="{{records}}" wx:key="recordId" wx:for-index="recIdx">
        <view class="record-info">
          <view class="record-players">
            <text class="player-name">{{item.white}}</text>
            <text class="vs-text">VS</text>
            <text class="player-name">{{item.black}}</text>
          </view>
          <view class="record-meta">
            <text class="record-result">{{item.result}}</text>
            <text wx:if="{{item.ecoCode}}" class="record-eco">{{item.ecoCode}}</text>
            <text wx:if="{{item.dateFormatted}}" class="record-date">{{item.dateFormatted}}</text>
          </view>
          <text wx:if="{{item.event}}" class="record-event">{{item.event}}</text>
        </view>
        <view class="record-actions">
          <view class="action-btn" catchtap="onReplayRecord" data-idx="{{recIdx}}">▶ 回放</view>
          <view class="action-btn" catchtap="onAnalyzeRecord" data-idx="{{recIdx}}">📊 分析</view>
          <view class="action-btn action-btn-danger" catchtap="onDeleteRecord" data-idx="{{recIdx}}">🗑</view>
        </view>
      </view>

      <!-- 分页 -->
      <view wx:if="{{records.length > 0}}" class="pagination">
        <view class="page-btn {{recordsPage <= 1 ? 'page-disabled' : ''}}" catchtap="onRecordsPagePrev">上一页</view>
        <text class="page-info">{{recordsPage}} / {{recordsTotalPages}}</text>
        <view class="page-btn {{recordsPage >= recordsTotalPages ? 'page-disabled' : ''}}" catchtap="onRecordsPageNext">下一页</view>
      </view>
    </scroll-view>
  </view>

  <!-- 我的对局Tab -->
  <view wx:if="{{activeTab === 'mygames'}}" class="tab-content">
    <scroll-view class="records-list" scroll-y>
      <view wx:if="{{games.length === 0}}" class="empty-state">
        <text class="empty-icon">🎮</text>
        <text class="empty-text">还没有对局记录</text>
        <view class="empty-action" catchtap="goToGame">去下棋</view>
      </view>

      <view wx:if="{{games.length > 0}}" class="record-card" wx:for="{{games}}" wx:key="gameId" wx:for-index="idx">
        <view class="record-info">
          <view class="record-players">
            <text class="player-name">{{item.whiteName}}</text>
            <text class="vs-text">VS</text>
            <text class="player-name">{{item.blackName}}</text>
          </view>
          <view class="record-meta">
            <text class="record-result">{{item.result}}</text>
            <text wx:if="{{item.difficulty}}" class="record-diff">难度{{item.difficulty}}</text>
            <text wx:if="{{item.dateFormatted}}" class="record-date">{{item.dateFormatted}}</text>
          </view>
        </view>
        <view class="record-actions">
          <view class="action-btn" catchtap="onAnalyzeGame" data-idx="{{idx}}">📊 分析</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 导入PGN弹窗 -->
  <view wx:if="{{showImportModal}}" class="modal-overlay" catchtap="onHideImport">
    <view class="import-modal glass-strong" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">导入PGN</text>
        <view class="close-btn" catchtap="onHideImport">✕</view>
      </view>
      <textarea class="pgn-textarea" placeholder="在此粘贴PGN文本..." value="{{importPgnText}}"
                bindinput="onImportPgnInput" maxlength="50000" />
      <view class="import-btn-main {{importing ? 'btn-loading' : ''}}" catchtap="onImport">
        <text>{{importing ? '导入中...' : '导入'}}</text>
      </view>
      <view wx:if="{{importResult}}" class="import-result">
        <text wx:if="{{importResult.count > 0}}">✅ 成功导入 {{importResult.count}} 局</text>
        <text wx:if="{{importResult.errors && importResult.errors.length > 0}}" class="import-errors">
          ⚠️ {{errorsText}}
        </text>
      </view>
    </view>
  </view>

</view>