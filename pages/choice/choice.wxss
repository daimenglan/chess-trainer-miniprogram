.choice-page {
  min-height: 100vh;
  background: var(--bg-primary);
}

.choice-scroll {
  height: 100vh;
  padding: 40rpx 28rpx 120rpx;
  box-sizing: border-box;
}

/* ===== 欢迎区 ===== */
.welcome-section {
  text-align: center;
  margin-bottom: 32rpx;
}
.welcome-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: 4rpx;
  display: block;
}
.welcome-subtitle {
  font-size: 22rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 6rpx;
}
.welcome-user {
  display: block;
  font-size: 22rpx;
  color: var(--text-dim);
  margin-top: 12rpx;
}

/* ===== 三大功能卡片 ===== */
.feature-cards {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.feature-card {
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 20rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
}

.card-bg-decor {
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
}

/* AI定级卡 - 紫渐变 */
.card-assessment {
  background: linear-gradient(135deg, #7c3aed, #6c63ff, #a855f7);
}

/* 棋手档案卡 - 蓝渐变 */
.card-profile {
  background: linear-gradient(135deg, #2563eb, #3b82f6, #6366f1);
}

/* 训练计划卡 - 橙渐变 */
.card-training {
  background: linear-gradient(135deg, #ea580c, #f59e0b, #f97316);
}

.card-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.card-icon {
  font-size: 40rpx;
}

.card-body {
  flex: 1;
  min-width: 0;
}
.card-label {
  font-size: 20rpx;
  font-weight: 600;
  opacity: 0.85;
  display: block;
  margin-bottom: 4rpx;
}
.card-main {
  font-size: 28rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 2rpx;
}
.card-sub {
  font-size: 20rpx;
  opacity: 0.8;
  display: block;
}

.card-stats-row {
  display: flex;
  gap: 20rpx;
}
.card-stat {
  text-align: center;
}
.card-stat-value {
  font-size: 28rpx;
  font-weight: 800;
  display: block;
}
.card-stat-label {
  font-size: 18rpx;
  opacity: 0.75;
  display: block;
}

.loading-text {
  font-size: 22rpx;
  opacity: 0.7;
}

/* ===== 2列功能入口 ===== */
.choice-grid {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.choice-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 20rpx;
  background: linear-gradient(135deg, rgba(108, 99, 255, 0.06), rgba(108, 99, 255, 0.02));
  border: 1px solid var(--accent-border);
  border-radius: 20rpx;
  cursor: pointer;
  text-align: center;
  transition: transform 0.2s, border-color 0.2s;
}
.choice-card:active {
  transform: scale(0.95);
  border-color: rgba(108, 99, 255, 0.5);
}

.choice-icon {
  font-size: 44rpx;
  display: block;
}

.choice-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.choice-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
}

.choice-desc {
  font-size: 18rpx;
  color: var(--text-muted);
  line-height: 1.4;
  display: block;
}

/* ===== 通用区块 ===== */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  margin-top: 12rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.section-sub {
  font-size: 18rpx;
  color: var(--text-muted);
}

.section-link {
  font-size: 18rpx;
  color: var(--accent);
  cursor: pointer;
}

.loading-mini {
  font-size: 18rpx;
  color: var(--text-dim);
  padding: 16rpx 0;
  text-align: center;
}

/* ===== 训练中心 ===== */
.training-center-section {
  margin-bottom: 24rpx;
}

.tc-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.tc-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 12rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  border: 1px solid var(--border-color);
  cursor: pointer;
  transition: transform 0.2s;
}

.tc-card:active {
  transform: scale(0.95);
}

.tc-icon {
  font-size: 32rpx;
}

.tc-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.tc-value {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
}

.tc-label {
  font-size: 16rpx;
  color: var(--text-muted);
  text-align: center;
}

/* ===== 周计划 ===== */
.weekly-plan-section {
  margin-bottom: 24rpx;
}

.weekly-plan-card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1px solid var(--border-color);
}

.wp-progress {
  height: 12rpx;
  background: var(--bg-card-hover);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.wp-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #6c63ff, #a855f7);
  border-radius: 6rpx;
  transition: width 1s;
}

.wp-progress-text {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
}

.wp-items {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.wp-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.wp-item-name {
  font-size: 18rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.wp-item-bar {
  height: 8rpx;
  background: var(--bg-card-hover);
  border-radius: 4rpx;
  overflow: hidden;
}

.wp-item-fill {
  height: 100%;
  background: linear-gradient(90deg, #10b981, #34d399);
  border-radius: 4rpx;
  transition: width 1s;
}

.wp-item-pct {
  font-size: 16rpx;
  color: var(--text-dim);
  text-align: right;
}

/* ===== 竞赛状态 ===== */
.competitions-section {
  margin-bottom: 24rpx;
}

.comp-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.comp-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: var(--bg-card);
  border-radius: 14rpx;
  border: 1px solid var(--border-color);
}

.comp-info {
  flex: 1;
  min-width: 0;
}

.comp-name {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.comp-meta {
  font-size: 16rpx;
  color: var(--text-muted);
  display: block;
}

.comp-action {
  padding: 8rpx 18rpx;
  background: var(--accent-bg);
  color: var(--accent);
  border-radius: 10rpx;
  font-size: 18rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* ===== 底部 ===== */
.choice-footer {
  text-align: center;
  padding-top: 60rpx;
}

.choice-footer-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.choice-footer-btn {
  font-size: 22rpx;
  color: var(--accent);
  cursor: pointer;
  padding: 8rpx 24rpx;
}

.choice-footer-btn:active {
  opacity: 0.6;
}

.choice-footer-logout {
  color: var(--danger);
}