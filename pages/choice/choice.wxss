.choice-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #0f0f23;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
}

.choice-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.choice-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #e0e0ff;
  letter-spacing: 4rpx;
}

.choice-subtitle {
  display: block;
  font-size: 24rpx;
  color: #8888aa;
  margin-top: 12rpx;
}

.choice-cards {
  width: 100%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.choice-card {
  display: flex;
  align-items: center;
  gap: 30rpx;
  padding: 40rpx 36rpx;
  background: linear-gradient(135deg, rgba(108, 99, 255, 0.08), rgba(108, 99, 255, 0.02));
  border: 1px solid rgba(108, 99, 255, 0.2);
  border-radius: 24rpx;
  cursor: pointer;
  transition: transform 0.2s, border-color 0.2s;
}

.choice-card:active {
  transform: scale(0.97);
  border-color: rgba(108, 99, 255, 0.5);
}

.choice-icon {
  font-size: 56rpx;
  flex-shrink: 0;
}

.choice-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.choice-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #e0e0ff;
}

.choice-desc {
  font-size: 22rpx;
  color: #8888aa;
  line-height: 1.5;
}

.choice-footer {
  margin-top: 80rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.choice-user {
  font-size: 24rpx;
  color: #6666aa;
}

.choice-logout {
  font-size: 22rpx;
  color: #f87171;
  cursor: pointer;
  padding: 8rpx 24rpx;
}