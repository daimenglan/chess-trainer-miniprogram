<view class="choice-page {{__theme__ ? 'theme-' + __theme__ : ''}}">
  <scroll-view scroll-y class="choice-scroll">

    <!-- 欢迎语 -->
    <view class="welcome-section">
      <text class="welcome-title">♟ mychess AI</text>
      <text class="welcome-subtitle">国际象棋陪练系统</text>
      <text class="welcome-user">{{username}}，欢迎回来</text>
    </view>

    <!-- ===== 训练中心概览 ===== -->
    <view class="training-center-section" wx:if="{{trainingCenter || trainingCenterLoading}}">
      <view class="section-header">
        <text class="section-title">🏋️ 训练中心</text>
        <view class="section-link" catchtap="onTrainingPlan">查看计划 →</view>
      </view>

      <!-- 加载中 -->
      <view wx:if="{{trainingCenterLoading}}" class="loading-mini">加载中...</view>

      <view wx:if="{{trainingCenter && !trainingCenterLoading}}" class="tc-grid">
        <view class="tc-card" catchtap="onTrainingPlan">
          <text class="tc-icon">📈</text>
          <view class="tc-body">
            <text class="tc-value">Lv.{{trainingCenter.level}}</text>
            <text class="tc-label">当前等级</text>
          </view>
        </view>
        <view class="tc-card" catchtap="onDynamicAssessment">
          <text class="tc-icon">🎯</text>
          <view class="tc-body">
            <text class="tc-value">{{trainingCenter.streak}}天</text>
            <text class="tc-label">连续打卡</text>
          </view>
        </view>
        <view class="tc-card" catchtap="onGoWrongBook">
          <text class="tc-icon">❌</text>
          <view class="tc-body">
            <text class="tc-value">{{mistakeSummary?.unresolved || 0}}</text>
            <text class="tc-label">待解决错题</text>
          </view>
        </view>
        <view class="tc-card" catchtap="onDynamicAssessment">
          <text class="tc-icon">⚡</text>
          <view class="tc-body">
            <text class="tc-value">动态评估</text>
            <text class="tc-label">重新测级</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 周计划进度 ===== -->
    <view class="weekly-plan-section" wx:if="{{weeklyPlan || weeklyPlanLoading}}">
      <view class="section-header">
        <text class="section-title">📅 本周计划</text>
        <text class="section-sub">{{weeklyPlan?.weekStart}} - {{weeklyPlan?.weekEnd}}</text>
      </view>

      <view wx:if="{{weeklyPlanLoading}}" class="loading-mini">加载中...</view>

      <view wx:if="{{weeklyPlan && !weeklyPlanLoading}}" class="weekly-plan-card">
        <view class="wp-progress">
          <view class="wp-progress-bar" style="width: {{weeklyPlan.overallPct}}%"></view>
        </view>
        <text class="wp-progress-text">本周完成 {{weeklyPlan.overallPct}}%</text>
        <view class="wp-items">
          <view class="wp-item" wx:for="{{weeklyPlan.items}}" wx:key="id">
            <text class="wp-item-name">{{item.title}}</text>
            <view class="wp-item-bar">
              <view class="wp-item-fill" style="width: {{item.completedPct}}%"></view>
            </view>
            <text class="wp-item-pct">{{item.completed}}/{{item.total}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 竞赛状态 ===== -->
    <view class="competitions-section" wx:if="{{activeCompetitions.length > 0 || competitionsLoading}}">
      <view class="section-header">
        <text class="section-title">🏆 热门竞赛</text>
        <view class="section-link" catchtap="onGoCompetitions">查看全部 →</view>
      </view>

      <view wx:if="{{competitionsLoading}}" class="loading-mini">加载中...</view>

      <view wx:if="{{activeCompetitions.length > 0}}" class="comp-list">
        <view class="comp-item" wx:for="{{activeCompetitions}}" wx:key="id">
          <view class="comp-info">
            <text class="comp-name">{{item.name}}</text>
            <text class="comp-meta">报名 {{item.registeredCount || 0}} 人 · {{item.level || ''}}</text>
          </view>
          <view class="comp-action" catchtap="onGoCompetitions">报名 →</view>
        </view>
      </view>
    </view>

    <!-- ===== 顶部三大功能卡片 ===== -->
    <view class="feature-cards">

      <!-- AI定级 -->
      <view class="feature-card card-assessment" catchtap="onAssessment">
        <view class="card-bg-decor"></view>
        <view class="card-icon-wrap">
          <text class="card-icon">🎯</text>
        </view>
        <view class="card-body">
          <text class="card-label">AI 定级测评</text>
          <block wx:if="{{assessmentInfo}}">
            <text class="card-main">{{assessmentInfo.estimatedElo}} 分</text>
            <text class="card-sub">{{assessmentInfo.gradeLabel}} · 置信度 {{assessmentInfo.confidencePct}}%</text>
          </block>
          <block wx:elif="{{assessmentLoading}}">
            <text class="card-main loading-text">加载中…</text>
          </block>
          <block wx:else>
            <text class="card-main">还不知道水平？</text>
            <text class="card-sub">一局对弈或几道战术题帮你定级 →</text>
          </block>
        </view>
      </view>

      <!-- 棋手档案 -->
      <view class="feature-card card-profile" catchtap="onProfile">
        <view class="card-bg-decor"></view>
        <view class="card-icon-wrap">
          <text class="card-icon">👤</text>
        </view>
        <view class="card-body">
          <text class="card-label">棋手档案</text>
          <block wx:if="{{profileInfo}}">
            <view class="card-stats-row">
              <view class="card-stat">
                <text class="card-stat-value">{{profileInfo.estimatedRating || '-'}}</text>
                <text class="card-stat-label">等级分</text>
              </view>
              <view class="card-stat">
                <text class="card-stat-value">{{profileInfo.style || '-'}}</text>
                <text class="card-stat-label">棋风</text>
              </view>
              <view class="card-stat">
                <text class="card-stat-value">{{profileInfo.winRate || 0}}%</text>
                <text class="card-stat-label">胜率</text>
              </view>
            </view>
          </block>
          <block wx:elif="{{profileLoading}}">
            <text class="card-main loading-text">加载中…</text>
          </block>
          <block wx:else>
            <text class="card-main">暂无档案数据</text>
            <text class="card-sub">分析对局，了解你的棋风 →</text>
          </block>
        </view>
      </view>

      <!-- 训练计划 -->
      <view class="feature-card card-training" catchtap="onTrainingPlan">
        <view class="card-bg-decor"></view>
        <view class="card-icon-wrap">
          <text class="card-icon">🏋️</text>
        </view>
        <view class="card-body">
          <text class="card-label">训练计划</text>
          <block wx:if="{{trainingInfo}}">
            <view class="card-stats-row">
              <view class="card-stat">
                <text class="card-stat-value">Lv.{{trainingInfo.level}}</text>
                <text class="card-stat-label">等级</text>
              </view>
              <view class="card-stat">
                <text class="card-stat-value">{{trainingInfo.currentStreak}}天</text>
                <text class="card-stat-label">连续打卡</text>
              </view>
              <view class="card-stat">
                <text class="card-stat-value">{{trainingInfo.todayCompleted}}/{{trainingInfo.todayTarget}}</text>
                <text class="card-stat-label">今日进度</text>
              </view>
            </view>
          </block>
          <block wx:elif="{{trainingLoading}}">
            <text class="card-main loading-text">加载中…</text>
          </block>
          <block wx:else>
            <text class="card-main">开始训练</text>
            <text class="card-sub">个性化训练计划等你开启 →</text>
          </block>
        </view>
      </view>
    </view>

    <!-- ===== 功能入口 2列网格 ===== -->
    <view class="choice-grid">
      <view class="choice-card" catchtap="onAICoach">
        <text class="choice-icon">🧠</text>
        <view class="choice-info">
          <text class="choice-name">AI 教练</text>
          <text class="choice-desc">与 AI 对弈，1-10级难度调节</text>
        </view>
      </view>
      <view class="choice-card" catchtap="onOnlineMatch">
        <text class="choice-icon">🌐</text>
        <view class="choice-info">
          <text class="choice-name">对弈</text>
          <text class="choice-desc">真人玩家实时匹配</text>
        </view>
      </view>
      <view class="choice-card" catchtap="onPuzzles">
        <text class="choice-icon">🧩</text>
        <view class="choice-info">
          <text class="choice-name">习题</text>
          <text class="choice-desc">多维筛选，AI讲解，错题本</text>
        </view>
      </view>
      <view class="choice-card" catchtap="onReview">
        <text class="choice-icon">📊</text>
        <view class="choice-info">
          <text class="choice-name">复盘</text>
          <text class="choice-desc">对局回放，SSE流式复盘</text>
        </view>
      </view>
      <view class="choice-card" catchtap="onStudy">
        <text class="choice-icon">📚</text>
        <view class="choice-info">
          <text class="choice-name">打谱</text>
          <text class="choice-desc">棋谱库浏览，AI讲解</text>
        </view>
      </view>
      <view class="choice-card" catchtap="onMembership" wx:if="{{showMembership}}">
        <text class="choice-icon">👑</text>
        <view class="choice-info">
          <text class="choice-name">会员</text>
          <text class="choice-desc">等级权益，兑换码开通</text>
        </view>
      </view>
      <view class="choice-card" catchtap="onCompetitions">
        <text class="choice-icon">🏆</text>
        <view class="choice-info">
          <text class="choice-name">竞赛</text>
          <text class="choice-desc">报名参赛，赢取排名</text>
        </view>
      </view>
      <view class="choice-card" catchtap="onFriends">
        <text class="choice-icon">👥</text>
        <view class="choice-info">
          <text class="choice-name">好友</text>
          <text class="choice-desc">添加好友，私聊对弈</text>
        </view>
      </view>
      <view class="choice-card" catchtap="onGroups">
        <text class="choice-icon">💬</text>
        <view class="choice-info">
          <text class="choice-name">群组</text>
          <text class="choice-desc">创建群聊，多人交流</text>
        </view>
      </view>
      <view class="choice-card" catchtap="onFeedback" wx:if="{{showFeedback}}">
        <text class="choice-icon">📝</text>
        <view class="choice-info">
          <text class="choice-name">反馈</text>
          <text class="choice-desc">意见与建议</text>
        </view>
      </view>
      <view class="choice-card" catchtap="onDistribution" wx:if="{{showDistribution}}">
        <text class="choice-icon">📈</text>
        <view class="choice-info">
          <text class="choice-name">分销</text>
          <text class="choice-desc">推广赚佣金</text>
        </view>
      </view>
      <view class="choice-card" catchtap="onDragonCoin">
        <text class="choice-icon">🪙</text>
        <view class="choice-info">
          <text class="choice-name">龙币</text>
          <text class="choice-desc">兑换奖励</text>
        </view>
      </view>
      <view class="choice-card" catchtap="onRewardCenter">
        <text class="choice-icon">🎁</text>
        <view class="choice-info">
          <text class="choice-name">奖励中心</text>
          <text class="choice-desc">领取成就奖励</text>
        </view>
      </view>
      <view class="choice-card" catchtap="onMyPuzzles">
        <text class="choice-icon">📖</text>
        <view class="choice-info">
          <text class="choice-name">我的习题</text>
          <text class="choice-desc">自建习题管理</text>
        </view>
      </view>
      <!-- 教室：仅教师/管理员可见（与网页版 classroom 菜单项一致） -->
      <view class="choice-card" catchtap="onClassroom" wx:if="{{showClassroom}}">
        <text class="choice-icon">🎓</text>
        <view class="choice-info">
          <text class="choice-name">教室</text>
          <text class="choice-desc">教学板、课件与复习</text>
        </view>
      </view>
      <!-- 管理后台：仅管理员可见（与网页版 admin 菜单项一致） -->
      <view class="choice-card" catchtap="onAdmin" wx:if="{{showAdmin}}">
        <text class="choice-icon">🛠️</text>
        <view class="choice-info">
          <text class="choice-name">管理后台</text>
          <text class="choice-desc">数据监控与系统配置</text>
        </view>
      </view>
    </view>

    <!-- 底部 -->
    <view class="choice-footer">
      <view class="choice-footer-actions">
        <text class="choice-footer-btn" catchtap="onSettings">⚙️ 设置</text>
        <text class="choice-footer-btn choice-footer-logout" catchtap="onLogout">退出登录</text>
      </view>
    </view>
  </scroll-view>
</view>