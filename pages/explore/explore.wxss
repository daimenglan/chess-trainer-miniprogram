/* 自主探究页
   布局：顶栏（+ 推演条）固定，中部整页滚动（棋盘优先占满宽度）。
   颜色一律走 app.wxss 的主题变量，深浅色自动切换。 */
.explore-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--bg-primary);
}

/* ===== 顶栏 ===== */
.ex-topbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border-color);
}
.ex-topbar-left,
.ex-topbar-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.ex-topbar-right {
  gap: 10rpx;
}
.ex-back,
.ex-tb-btn {
  padding: 10rpx 16rpx;
  font-size: 22rpx;
  border-radius: 12rpx;
  background: var(--bg-card);
  color: var(--text-secondary);
}
.ex-tb-btn {
  background: var(--bg-card-hover);
}
.ex-tb-disabled {
  opacity: 0.4;
}
.ex-badge {
  padding: 8rpx 14rpx;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 10rpx;
  background: var(--accent-bg);
  color: var(--accent);
}
.ex-step-count {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ===== 推演条 ===== */
.ex-explore-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 20rpx;
  background: var(--purple-bg);
  border-bottom: 1px solid var(--purple-border);
}
.ex-explore-nav {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.ex-explore-nav-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  border-radius: 12rpx;
  background: var(--bg-card-strong);
  color: var(--text-primary);
}
.ex-disabled {
  opacity: 0.3;
}
.ex-explore-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--purple);
}
.ex-explore-exit {
  padding: 10rpx 18rpx;
  font-size: 22rpx;
  border-radius: 12rpx;
  background: var(--purple);
  color: #fff;
}

/* ===== 滚动主体 ===== */
.ex-scroll {
  flex: 1;
  min-height: 0;
}

.ex-board-wrap {
  padding: 16rpx 16rpx 0;
}

.ex-status {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 24rpx 8rpx;
}
.ex-status-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.ex-status-tag {
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  border-radius: 8rpx;
}
.ex-tag-check {
  background: var(--warning-bg);
  color: var(--warning);
}
.ex-tag-over {
  background: var(--danger-bg);
  color: var(--danger);
}
.ex-status-hint {
  font-size: 20rpx;
  color: var(--text-dim);
}

/* ===== 控制按钮 ===== */
.ex-controls {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 8rpx 24rpx 16rpx;
}
.ex-ctrl-btn {
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  border-radius: 14rpx;
  background: var(--bg-card);
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
}
.ex-ctrl-on {
  background: var(--accent-bg);
  color: var(--accent);
  border-color: var(--accent-border);
}

/* ===== 推演着法序列 ===== */
.ex-steps {
  margin: 0 24rpx 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
}
.ex-steps-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.ex-steps-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.ex-steps-eval {
  font-size: 22rpx;
  color: var(--purple);
}
.ex-steps-scroll {
  width: 100%;
}
.ex-steps-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding-bottom: 4rpx;
}
.ex-step {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  font-size: 22rpx;
  border-radius: 12rpx;
  background: var(--bg-card-hover);
  color: var(--text-secondary);
}
.ex-step-cur {
  background: var(--purple);
  color: #fff;
}

/* ===== 分析面板 ===== */
.ex-panel {
  margin: 0 24rpx 24rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
}

/* ===== 棋谱选择弹窗 ===== */
.ex-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: var(--bg-overlay);
}
.ex-modal {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 70vh;
  border-radius: 24rpx;
  background: var(--bg-glass);
  border: 1px solid var(--border-color-strong);
  overflow: hidden;
}
.ex-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1px solid var(--border-color);
}
.ex-modal-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.ex-modal-close {
  font-size: 28rpx;
  color: var(--text-muted);
  padding: 0 8rpx;
}
.ex-modal-list {
  max-height: 55vh;
  padding: 12rpx 24rpx 24rpx;
}
.ex-modal-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1px solid var(--border-color-light);
}
.ex-modal-item-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.ex-modal-item-title {
  font-size: 26rpx;
  color: var(--text-primary);
}
.ex-modal-item-meta {
  font-size: 20rpx;
  color: var(--text-dim);
}
.ex-modal-item-go {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--accent);
}
.ex-modal-empty {
  padding: 60rpx 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-muted);
}
