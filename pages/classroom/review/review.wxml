<view class="page {{__theme__ ? 'theme-' + __theme__ : ''}}">
  <view class="nav-bar">
    <view class="nav-back" bindtap="onBack">
      <text class="nav-back-icon">←</text>
      <text class="nav-back-text">返回</text>
    </view>
    <text class="nav-title">教学反馈</text>
  </view>

  <scroll-view class="scroll-content" scroll-y="true">
    <view class="review-list">
      <view class="review-card" wx:for="{{reviews}}" wx:key="id">
        <text class="review-title">{{item.name || '反馈 #' + item.id}}</text>
        <text class="review-desc">{{item.message || item.content || '暂无内容'}}</text>
        <text class="review-date">{{item.createdAt}}</text>
      </view>
      <view class="empty-tip" wx:if="{{reviews.length === 0 && !loading}}">
        <text>暂无反馈</text>
      </view>
      <view class="loading-tip" wx:if="{{loading}}"><text>加载中...</text></view>
    </view>
  <!-- AI生成内容免责声明 -->
  <view class="ai-disclaimer"><text>本服务为AI生成内容，结果仅供参考</text></view>
  </scroll-view>
</view>