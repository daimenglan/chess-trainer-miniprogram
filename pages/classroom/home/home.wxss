.page {
  background: var(--bg-page, #0f0f23);
  color: var(--text-primary, #e8e8f0);
  min-height: 100vh;
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--bg-card, #1a1a2e);
  border-bottom: 1rpx solid var(--border-color, #2a2a4a);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: var(--bg-hover, #252545);
  margin-right: 24rpx;
}

.nav-back-icon { font-size: 32rpx; color: var(--text-primary, #e8e8f0); }
.nav-back-text { font-size: 26rpx; color: var(--text-primary, #e8e8f0); }
.nav-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); flex: 1; }

.scroll-content { padding: 24rpx 32rpx; height: calc(100vh - 100rpx); }

.status-card {
  background: var(--bg-card, #1a1a2e);
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
  border: 1rpx solid var(--border-color, #2a2a4a);
  margin-bottom: 24rpx;
}

.status-card.pending { border-color: #f59e0b; }
.status-card.none { border-color: #ef4444; }

.status-text { font-size: 28rpx; font-weight: 700; display: block; margin-bottom: 8rpx; }
.status-desc { font-size: 24rpx; color: var(--text-secondary, #a0a0c0); display: block; margin-bottom: 20rpx; }

.apply-btn {
  padding: 20rpx;
  background: linear-gradient(135deg, #6c63ff, #8b8bff);
  border-radius: 12rpx;
  text-align: center;
}

.apply-btn-text { font-size: 26rpx; font-weight: 700; color: #fff; }

.feature-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feature-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: var(--bg-card, #1a1a2e);
  border-radius: 20rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
}

.feature-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.feature-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #e8e8f0);
}

.loading-tip { text-align: center; padding: 60rpx 32rpx; }
.loading-tip text { font-size: 24rpx; color: var(--text-muted, #666); }