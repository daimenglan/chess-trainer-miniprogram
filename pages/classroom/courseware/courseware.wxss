.page { background: var(--bg-page, #0f0f23); color: var(--text-primary, #e8e8f0); min-height: 100vh; }
.nav-bar { display: flex; align-items: center; padding: 24rpx 32rpx; background: var(--bg-card, #1a1a2e); border-bottom: 1rpx solid var(--border-color, #2a2a4a); position: sticky; top: 0; z-index: 100; }
.nav-back { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 20rpx; border-radius: 12rpx; background: var(--bg-hover, #252545); margin-right: 24rpx; }
.nav-back-icon { font-size: 32rpx; color: var(--text-primary, #e8e8f0); }
.nav-back-text { font-size: 26rpx; color: var(--text-primary, #e8e8f0); }
.nav-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); flex: 1; }
.nav-add { width: 48rpx; height: 48rpx; border-radius: 50%; background: linear-gradient(135deg, #6c63ff, #8b8bff); display: flex; align-items: center; justify-content: center; }
.nav-add text { font-size: 28rpx; color: #fff; font-weight: 700; }
.scroll-content { padding: 24rpx 32rpx; height: calc(100vh - 100rpx); }
.courseware-list { display: flex; flex-direction: column; gap: 16rpx; }
.courseware-card { background: var(--bg-card, #1a1a2e); border-radius: 16rpx; padding: 24rpx; border: 1rpx solid var(--border-color, #2a2a4a); }
.cw-title { font-size: 26rpx; font-weight: 600; color: var(--text-primary, #e8e8f0); display: block; margin-bottom: 8rpx; }
.cw-desc { font-size: 22rpx; color: var(--text-secondary, #a0a0c0); display: block; margin-bottom: 8rpx; }
.cw-meta { font-size: 20rpx; color: var(--text-muted, #888); display: block; }
.empty-tip { text-align: center; padding: 60rpx 32rpx; }
.empty-tip text { font-size: 24rpx; color: var(--text-muted, #666); }
.loading-tip { text-align: center; padding: 40rpx; }
.loading-tip text { font-size: 24rpx; color: var(--text-muted, #666); }