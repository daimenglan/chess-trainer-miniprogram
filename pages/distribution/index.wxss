.page {
  background: var(--bg-page, #0f0f23);
  color: var(--text-primary, #e8e8f0);
  min-height: 100vh;
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--bg-card, #1a1a2e);
  border-bottom: 1rpx solid var(--border-color, #2a2a4a);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: var(--bg-hover, #252545);
  margin-right: 24rpx;
}

.nav-back-icon { font-size: 32rpx; color: var(--text-primary, #e8e8f0); }
.nav-back-text { font-size: 26rpx; color: var(--text-primary, #e8e8f0); }
.nav-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); flex: 1; }

.scroll-content { padding: 24rpx 32rpx; height: calc(100vh - 100rpx); }

.overview-section { margin-bottom: 24rpx; }

.overview-card {
  background: var(--bg-card, #1a1a2e);
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
  text-align: center;
  margin-bottom: 20rpx;
}

.overview-title { font-size: 24rpx; color: var(--text-secondary, #a0a0c0); display: block; margin-bottom: 12rpx; }

.overview-code {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--accent, #6c63ff);
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 16rpx;
}

.code-actions { display: flex; justify-content: center; }

.action-mini {
  padding: 10rpx 24rpx;
  background: var(--bg-input, #15152a);
  border-radius: 10rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
}

.action-mini text { font-size: 22rpx; color: var(--accent, #6c63ff); }

.stats-grid {
  display: flex;
  gap: 12rpx;
}

.stat-box {
  flex: 1;
  background: var(--bg-card, #1a1a2e);
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  border: 1rpx solid var(--border-color, #2a2a4a);
}

.stat-num { font-size: 32rpx; font-weight: 700; color: var(--accent, #6c63ff); display: block; }
.stat-label { font-size: 20rpx; color: var(--text-secondary, #a0a0c0); display: block; margin-top: 4rpx; }

.activate-section { margin-top: 20rpx; }

.activate-card {
  background: var(--bg-card, #1a1a2e);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
  text-align: center;
}

.activate-title { font-size: 28rpx; font-weight: 700; color: var(--text-primary, #e8e8f0); display: block; margin-bottom: 12rpx; }
.activate-desc { font-size: 24rpx; color: var(--text-secondary, #a0a0c0); display: block; margin-bottom: 24rpx; line-height: 1.5; }

.activate-btn {
  padding: 22rpx;
  background: linear-gradient(135deg, #6c63ff, #8b8bff);
  border-radius: 12rpx;
  text-align: center;
}

.activate-btn-text { font-size: 28rpx; font-weight: 700; color: #fff; }

.section { margin-top: 24rpx; }

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary, #e8e8f0);
  display: block;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--border-color, #2a2a4a);
}

.commission-list { display: flex; flex-direction: column; gap: 12rpx; }

.commission-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 22rpx;
  background: var(--bg-card, #1a1a2e);
  border-radius: 14rpx;
  border: 1rpx solid var(--border-color, #2a2a4a);
}

.commission-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }

.commission-amount { font-size: 24rpx; font-weight: 600; color: #22c55e; }
.commission-desc { font-size: 22rpx; color: var(--text-secondary, #a0a0c0); }
.commission-date { font-size: 20rpx; color: var(--text-muted, #888); }

.commission-status { font-size: 20rpx; padding: 4rpx 10rpx; border-radius: 6rpx; }

.commission-status[status="settled"] { color: #22c55e; background: rgba(34, 197, 94, 0.1); }
.commission-status[status="pending"] { color: #f59e0b; background: rgba(245, 158, 11, 0.1); }

.empty-tip { text-align: center; padding: 40rpx; }
.empty-tip text { font-size: 24rpx; color: var(--text-muted, #666); }