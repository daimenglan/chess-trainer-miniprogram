.replay-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-primary);
  overflow-y: auto;
}

.game-info {
  padding: 16rpx 20rpx;
  margin: 12rpx;
  text-align: center;
  background: var(--bg-card);
}

.game-players {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.game-player {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.game-vs {
  font-size: 18rpx;
  color: var(--text-dim);
}

.game-meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8rpx;
}

.meta-item {
  font-size: 18rpx;
  color: var(--text-muted);
  padding: 2rpx 8rpx;
  background: var(--bg-card);
  border-radius: 4rpx;
}

.meta-item.eco {
  color: var(--accent);
  background: var(--accent-bg-light);
}

.board-area {
  display: flex;
  justify-content: center;
  padding: 8rpx;
  min-height: 400rpx;
}

.board-area chess-board {
  width: 100%;
}

.progress-bar {
  text-align: center;
  padding: 8rpx;
}

.progress-text {
  font-size: 22rpx;
  color: var(--text-muted);
  font-weight: 600;
}

.controls {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding: 12rpx;
}

.ctrl-btn {
  padding: 12rpx 24rpx;
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  border-radius: 10rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.ctrl-btn:active {
  background: rgba(255, 255, 255, 0.12);
}

.ctrl-disabled {
  opacity: 0.3;
}

.moves-section {
  padding: 8rpx 16rpx;
  flex: 1;
}

.back-btn {
  text-align: center;
  padding: 16rpx;
  font-size: 22rpx;
  color: var(--accent);
  font-weight: 600;
}

.analysis-entry {
  text-align: center;
  padding: 12rpx 16rpx 24rpx;
  font-size: 22rpx;
  color: var(--purple);
  font-weight: 600;
  background: rgba(139, 92, 246, 0.06);
  margin: 0 16rpx 16rpx;
  border-radius: 10rpx;
  border: 1px solid var(--purple-border);
}

/* 操作按钮行 */
.action-row {
  display: flex;
  gap: 12rpx;
  padding: 0 16rpx 16rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 12rpx;
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
}

.action-btn:active {
  background: rgba(255, 255, 255, 0.12);
}

/* 视频生成弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.glass-strong {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin: 40rpx;
  max-width: 80vw;
  text-align: center;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.video-generating {
  padding: 20rpx 0;
}

.video-generating text {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.video-actions {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.btn-primary {
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #6c63ff, #8b5cf6);
  border-radius: 12rpx;
  text-align: center;
}

.btn-secondary {
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
  background: var(--bg-card-hover);
  border: 1px solid var(--border-color);
  border-radius: 12rpx;
  text-align: center;
}

.home-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  text-align: center;
  padding: 12rpx;
  font-size: 22rpx;
  color: var(--accent);
  background: var(--bg-primary);
  border-top: 1px solid var(--border-color);
}
