<view class="page" __theme__="{{__theme__}}">
  <view class="nav-bar">
    <view class="nav-back" bindtap="onBack">
      <text class="nav-back-icon">←</text>
      <text class="nav-back-text">返回</text>
    </view>
    <text class="nav-title">{{username || '聊天'}}</text>
  </view>

  <scroll-view class="messages-container" scroll-y="true" scroll-top="0">
    <view class="message-list">
      <view class="message-item {{item.fromUserId === (app && app.globalData && app.globalData.user && app.globalData.user.userId) ? 'mine' : 'other'}}" wx:for="{{messages}}" wx:key="id">
        <view class="message-bubble">
          <text class="message-text">{{item.content}}</text>
          <text class="message-time">{{item.createdAt}}</text>
        </view>
      </view>
      <view class="loading-tip" wx:if="{{loading && messages.length === 0}}">
        <text>加载中...</text>
      </view>
    </view>
  </scroll-view>

  <view class="input-bar">
    <input class="input-field" value="{{inputText}}" bindinput="onInput" placeholder="输入消息" placeholder-class="placeholder" />
    <view class="send-btn" bindtap="onSend">
      <text class="send-btn-text">发送</text>
    </view>
  </view>
</view>